      "pythoness": {
        "name": "Pitonesa",
        "skill": "<#6aff55ff>Restaura<> la salud de un aliado en <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<>.",
        "skill2": "<#6aff55ff>Restaura<> la salud de un aliado en <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> e inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% del poder de habilidad<> como <#a974ffff>daño mágico<> a enemigos en {Range} alrededor de ellos.",
