    "description": {
      "archer": {
        "name": "Okçu",
        "skill": "Belirtilen yöne sıçra ve en son saldırılan düşmana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "skill2": "Yakın bir düşmana ok atarak <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver, kısa süre <#ef5350ff>sersemlet<> ve geriye sıçra.",
        "ult": "Olduğu yerde durur ve toplam {Count} ok atar. Ok yakındaki {Range} menzilindeki rastgele bir düşmana doğru uçarak <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir."
      },
      "bard": {
        "name": "Ozan",
        "skill": "Bir müttefikin <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AttackSpeed}%<> <#ffb900ff>{Duration}s<> boyunca artırır.",
        "skill2": "Hedeflenen alandaki müttefiklerin yetenek bekleme sürelerini {Duration}s boyunca <#ffb900ff>{CoolReduce}%<> azaltır.",
        "ult": "<#ffb900ff>{Duration}s<> boyunca kanal yapar, {Range} menzilindeki müttefik şampiyonların <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırısını {Attack}<> ve <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AttackSpeed}%<> artırır, ancak <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>zırhları<> ve <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>büyü direnci<> 0 olur."
      },
      "barrier_magician": {
        "name": "Bariyer büyücüsü",
        "skill": "<#ffb900ff>{Duration}s<> süren bir bariyer yaratır, müttefiklere <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% YG<> <#e8d44dff>kalkan<> verir ve düşmanların <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AttackSpeedReduce}%<> azaltır. Seviye 3'ten itibaren müttefiklere ek <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızı<> verir ve düşmanları <#ef5350ff>yavaşlatır<>.",
        "skill2": "Hedeflenen alanda <#ffb900ff>{Duration}s<> süren bir bariyer çağırır, içindeki tüm mermileri yok eder.",
        "ult": "Düşman şampiyonun etrafında küçülen bir bariyer yaratır. Kenara dokunan düşmanlar <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> alır ve <#ef5350ff>{Time}s sersemler<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "{Duration}s boyunca öfkeye kapılarak saldırı hızını <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> artır ve <#6aff55ff>{Vamp}% can çalma<> kazan.",
        "skill2": "İki elle yere vurarak dar alandaki düşmanları <#ef5350ff>{Time}s havaya fırlat<> ve <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "ult": "{Range} menzil içindeki hedef düşmana doğru koşar ve düşmana saldırarak, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir. Bekleme süresi, kaybedilen <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>can<>la orantılı olarak azalır."
      },
      "boomerang_hunter": {
        "name": "Bumerang avcısı",
        "skill": "Bir bumerang doğrultu boyunca atar, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. Maksimum menzilde döner, dokunan düşmanlara sürekli <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir.",
        "skill2": "Geri dönen üç bumerang atar, yollarındaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir.",
        "ult": "Doğrultu boyunca güçlü bir bumerang ateşler, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir. Düşman şampiyona vurduğunda en yakın diğer düşman şampiyona sıçrar, her sıçramada hasar <#ff9028ff>{Increase}%<> artar. En fazla {MaxBounce} kez sıçrar."
      },
      "chef": {
        "name": "Şef",
        "skill": "Bıçağı doğrultu boyunca fırlatır, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{SlowTime}s boyunca {Slow}% yavaşlatır<>.",
        "skill2": "Yakındaki müttefiklere yemek dağıtır, <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% YG<> sürekli olarak <#6aff55ff>can yeniler<>. Sadece kendine iyileşme <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% YG<> olur.",
        "ult": "Müttefik şampiyona özel yemek atar. <#ffb900ff>{Duration}s<> boyunca <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>maksimum can {HpRatio}% artar<>. Alınan hasarın <#e8d44dff>{SpreadRatio}%<>'ı zaman içinde dağıtılır."
      },
      "clown": {
        "name": "Palyaço",
        "skill": "Hedefin yanına ışınlanır. Düşmansa, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ffb900ff>{Duration}s<> boyunca <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% hareket hızı<> kazanır.",
        "skill2": "Etrafa hançer saçar, alanındaki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. (Kullanırken hareket edebilir)",
        "ult": "<#ffb900ff>{Time}s<> boyunca cinnete girer. Tüm hançerler düşmanlar arasında sıçrayan özel hançerlere dönüşür."
      },
      "dancer": {
        "name": "Dansçı",
        "skill": "Bir düşmana chakram fırlatarak <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}'i<> kadar <#ff9028ff>fiziksel hasar<> verir. Her ek chakram bu yeteneğin hasarını %{StackCoef} artırır.",
        "skill2": "Her öldürme normal saldırılara çakra ekler. (Maks {MaxCount}, her ek çakra vuruşunda hasar {Reduce}% azalır)",
        "ult": "Yelpaze şeklinde {Count}(+yığın) delici çakra fırlatır, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. Çakralar geri döner, <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. (Maks {MaxCount})"
      },
      "dark_mage": {
        "name": "Karanlık büyücü",
        "skill": "Karanlık ok ateşler, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}s köklendirir<>.",
        "skill2": "Gecikme sonrası alanı karanlıkla kaplar, içindeki düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir.",
        "ult": "{Range} içindeki düşman şampiyonu lanetler, <#ffb900ff>{Duration}s<> boyunca en yakın müttefikle bağlar. Biri hasar aldığında <#a974ffff>{ShareRatio}%<>'ı diğerine aktarılır."
      },
      "demon": {
        "name": "Şeytan",
        "skill": "Yerden cehennem pençesi çıkarak bir düşmanı yakala, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve konumları değiştir.",
        "skill2": "{Time}s büyük şeytana dönüş. Dönüşüm sırasında saldırı <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>, zırh <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{Defense}<>, saldırı hızı <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<>, hareket hızı <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<> artar.",
        "ult": "{Range} menzil içindeki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{Time} saniye boyunca korku<> uygular."
      },
      "dual_blader": {
        "name": "Çift kılıçlı",
        "skill": "Düz bir çizgide kılıç enerjisi ateşleyerek vurulan düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve <#ef5350ff>hedefi {Time}s kökle<>.",
        "skill2": "{Range} alandaki <#ef5350ff>hareketsiz<> bir düşmana hücum ederek vurulan düşmanı <#ef5350ff>{Time}s havaya fırlat<> ve <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "ult": "Belirlenen {Range} menzilindeki bir düşmanı kılıçla keser, {Count} kez <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>%{Coef} saldırı gücü<> kadar <#f5f5f5ff>sabit hasar<> verir."
      },
      "executioner": {
        "name": "Cellat",
        "skill": "Kanca atarak vurulan düşmana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve kendine çek.",
        "skill2": "Bir düşmanı kancayla keserek <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve <#ef5350ff>{Duration}s süreyle kanama uygula<>. Kanayan düşmanlar her {Tick}s <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {TickCoef}%<>'si <#ff9028ff>fiziksel hasar<> alır ve <#ef5350ff>{Debuff}% daha fazla hasar alır<>.",
        "ult": "{Range} önündeki yarım daire şeklindeki alandaki düşmanları bir kancayla süpürür, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}<>'si kadar <#ff9028ff>fiziksel hasar<> verir ve onları <#ef5350ff>{Time} saniye boyunca iyileşemez<> hale getirir."
      },
      "exorcist": {
        "name": "Şeytan kovucu",
        "skill": "Bir müttefiğin <#ef5350ff>durum etkilerini<> geçersiz kılar ve <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{Coef}'i<> kadar <#6aff55ff>Can yeniler<>.",
        "skill2": "Bir müttefike <#ffb900ff>{Duration}s<> kutsal koruma verir, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırıyı {Attack}<> ve <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AttackSpeed}%<> artırır. Aktifken kontrol etkilerini geri yansıtır.",
        "ult": "Hedef alanda patlama yaratır, düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> <#a974ffff>büyü hasarı<> verir. Hedefteki her buff başına <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% YG<> bonus hasar verir."
      },
      "fighter": {
        "name": "Dövüşçü",
        "skill": "{Range} içindeki hedefe {Speed} hızla saldırır, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{Stun}s sersemleştirir<>.",
        "skill2": "Yere vurur, {Range} içindeki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{SlowTime}s boyunca {Slow}% yavaşlatır<>.",
        "ult": "Yere vurur, {Range} menzilindeki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir ve onları <#ef5350ff>{Time}s havaya fırlatır<>."
