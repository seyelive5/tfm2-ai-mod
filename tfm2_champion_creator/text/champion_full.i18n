    "description": {
      "archer": {
        "name": "Bogenschütze",
        "skill": "Springe in die angegebene Richtung und füge dem zuletzt angegriffenen Feind <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu.",
        "skill2": "Feuere einen Pfeil auf einen nahen Feind ab, um <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen, sie kurz zu <#ef5350ff>betäuben<> und rückwärts zu springen.",
        "ult": "Es bleibt stehen und feuert insgesamt {Count} Pfeile ab. Der Pfeil fliegt auf einen zufälligen Feind in der Nähe von {Range} zu und verursacht <#ff9028ff>physischen Schaden<> in Höhe von <#ff9028ff>{Damage}<> + {Coef} % der <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff<>."
      },
      "bard": {
        "name": "Barde",
        "skill": "Erhöht die <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo eines Verbündeten um {AttackSpeed}%<> für <#ffb900ff>{Duration}s<>.",
        "skill2": "Reduziert die Fähigkeiten-Abklingzeit von Verbündeten im Zielbereich für {Duration}s um <#ffb900ff>{CoolReduce}%<>.",
        "ult": "Kanalisiert für <#ffb900ff>{Duration}s<> und erhöht den <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff um {Attack}<> und die <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo um {AttackSpeed}%<> verbündeter Champions in {Range} Reichweite, aber <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>Verteidigung<> und <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>Magieresistenz<> werden auf 0 gesetzt."
      },
      "barrier_magician": {
        "name": "Barrieren-Magier",
        "skill": "Erschafft für <#ffb900ff>{Duration}s<> eine Barriere, die Verbündeten <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% Zauberkraft<> als <#e8d44dff>Schild<> gewährt und die <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo von Feinden um {AttackSpeedReduce}%<> reduziert. Ab Stufe 3 erhalten Verbündete zusätzliche <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo<> und Feinde werden <#ef5350ff>verlangsamt<>.",
        "skill2": "Beschwört im Zielbereich für <#ffb900ff>{Duration}s<> eine Barriere, die alle Projektile darin zerstört.",
        "ult": "Erschafft eine schrumpfende Barriere um einen feindlichen Champion. Feinde, die den Rand berühren, erleiden <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> und werden <#ef5350ff>für {Time}s betäubt<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Werde für {Duration}s wütend, erhöhe die <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo um {AttackSpeed}%<> und gewinne <#6aff55ff>{Vamp}% Lebensraub<>.",
        "skill2": "Schlage mit beiden Händen auf den Boden, um Feinde in einem engen Bereich <#ef5350ff>für {Time}s in die Luft zu werfen<> und <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen.",
        "ult": "Stürme auf einen Feind in {Range} Reichweite zu und schlage ihn, dabei <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zufügend. Die Abklingzeit wird proportional zur verlorenen <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>HP<> verkürzt."
      },
      "boomerang_hunter": {
        "name": "Bumerang-Jäger",
        "skill": "Wirft einen Bumerang in gerader Linie und verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<>. Am Ende der Reichweite rotiert er und verursacht kontinuierlich <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% Angriff<> als <#ff9028ff>physischen Schaden<>.",
        "skill2": "Wirft drei Bumerangs, die zurückkehren und allen Feinden in ihrer Bahn <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zufügen.",
        "ult": "Feuert einen kraftvollen Bumerang in gerader Linie und verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<>. Trifft er einen feindlichen Champion, springt er zum nächsten feindlichen Champion und erhöht den Schaden pro Sprung um <#ff9028ff>{Increase}%<>. Springt bis zu {MaxBounce} Mal."
      },
      "chef": {
        "name": "Koch",
        "skill": "Wirft ein Messer in gerader Linie und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>verlangsamt um {Slow}% für {SlowTime}s<>.",
        "skill2": "Verteilt Essen an nahe Verbündete und <#6aff55ff>heilt HP<> um <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Zauberkraft<>. Bei Selbstheilung steigt die Heilung auf <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% Zauberkraft<>.",
        "ult": "Wirft einem verbündeten Champion ein Spezialgericht zu. Für <#ffb900ff>{Duration}s<> steigen <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>maximale HP um {HpRatio}%<>. <#e8d44dff>{SpreadRatio}%<> des erlittenen Schadens wird als Schaden über Zeit verteilt."
      },
      "clown": {
        "name": "Clown",
        "skill": "Teleportiert sich neben ein Ziel. Bei einem Feind verursacht es <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> und gibt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Lauftempo<> für <#ffb900ff>{Duration}s<>.",
        "skill2": "Streut Dolche umher und fügt Feinden im Bereich <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu. (Bewegung während des Wirkens möglich)",
        "ult": "Verfällt für <#ffb900ff>{Time}s<> in Raserei. Alle Dolche werden zu speziellen springenden Dolchen, die zwischen Feinden abprallen."
      },
      "dancer": {
        "name": "Tänzerin",
        "skill": "Wirft ein Chakram auf einen Gegner und verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<>. Jedes zusätzliche Chakram erhöht den Schaden dieser Fähigkeit um {StackCoef}%.",
        "skill2": "Jeder Kill fügt ein Chakram zu Standardangriffen hinzu. (Max {MaxCount}, Schaden sinkt um {Reduce}% pro zusätzlichem Chakram-Treffer)",
        "ult": "Feuert {Count}(+Stapel) durchdringende Chakrams in einem Fächer und fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu. Chakrams kehren zurück und fügen <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu. (Max {MaxCount})"
      },
      "dark_mage": {
        "name": "Dunkler Magier",
        "skill": "Feuert einen Schattenpfeil ab und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>fesselt für {Time}s<>.",
        "skill2": "Bedeckt nach kurzer Verzögerung ein Gebiet mit Dunkelheit und fügt Feinden darin <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu.",
        "ult": "Verflucht einen feindlichen Champion in {Range} Reichweite und verbindet ihn für <#ffb900ff>{Duration}s<> mit dem nächsten Verbündeten. Erleidet einer Schaden, werden <#a974ffff>{ShareRatio}%<> auf den anderen übertragen."
      },
      "demon": {
        "name": "Dämon",
        "skill": "Eine höllische Klaue steigt aus dem Boden auf, um einen Feind zu greifen, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen und Positionen zu tauschen.",
        "skill2": "Verwandle dich für {Time}s in einen größeren Dämon. Erhöht Angriff um <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>Verteidigung um {Defense}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo um {AttackSpeed}%<> und <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Lauftempo um {MoveSpeed}%<>.",
        "ult": "Fügt allen Gegnern in {Range} Reichweite <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und löst <#ef5350ff>{Time}s lang Angst<> aus."
      },
      "dual_blader": {
        "name": "Doppelklingen-Kämpfer",
        "skill": "Feuere Schwertenergie in einer geraden Linie, um getroffenen Feinden <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen und das Ziel <#ef5350ff>für {Time}s zu fesseln<>.",
        "skill2": "Stürme auf einen <#ef5350ff>immobilen<> Feind in {Range} Reichweite zu, wirf den getroffenen Feind <#ef5350ff>für {Time}s in die Luft<> und füge <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu.",
        "ult": "Zerschneidet einen Feind in {Range} Reichweite mit einem Schwert und verursacht {Count} mal <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#f5f5f5ff>festen Schaden<>."
      },
      "executioner": {
        "name": "Henker",
        "skill": "Feuere einen Haken ab, um <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen und den getroffenen Feind zu dir zu ziehen.",
        "skill2": "Schlitzt einen Feind mit einem Haken auf, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und lässt das Ziel <#ef5350ff>{Duration}s lang bluten<>. Blutende Feinde erleiden alle {Tick}s <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> und <#ef5350ff>erleiden {Debuff}% mehr Schaden<>.",
        "ult": "Fegt Feinde mit einem Haken in einem halbkreisförmigen Bereich vor {Range}, verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% der Angriff<> als <#ff9028ff>physischen Schaden<> und macht sie <#ef5350ff>für {Time}s unfähig zu heilen<>."
      },
      "exorcist": {
        "name": "Exorzist",
        "skill": "Neutralisiert <#ef5350ff>Statuseffekte<> eines Verbündeten und <#6aff55ff>heilt {Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> <#6aff55ff>Leben<>.",
        "skill2": "Gewährt einem Verbündeten für <#ffb900ff>{Duration}s<> göttlichen Schutz, erhöht den <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff um {Attack}<> und die <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo um {AttackSpeed}%<>. Während aktiv reflektiert es Kontrolleffekte zurück.",
        "ult": "Erzeugt eine Explosion im Zielgebiet und fügt Feinden <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zu. Verursacht <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% Zauberkraft<> Bonusschaden pro Buff auf dem Ziel."
      },
      "fighter": {
        "name": "Kämpfer",
        "skill": "Stürmt mit {Speed} Geschwindigkeit auf ein Ziel in {Range} zu und verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> und <#ef5350ff>betäubt für {Stun}s<>.",
        "skill2": "Schlägt auf den Boden und fügt Feinden in {Range} <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>verlangsamt um {Slow}% für {SlowTime}s<>.",
        "ult": "Schlägt auf den Boden und fügt allen Feinden in {Range} Reichweite <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und schleudert sie <#ef5350ff>für {Time}s in die Luft<>."
      },
      "gambler": {
        "name": "Spieler",
        "skill": "Würfle und greife Feinde in {Range} Reichweite so oft an, wie die Würfelzahl ergibt. Jeder Angriff fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu.",
        "skill2": "Wirf einen Chip, um in {Range} Reichweite ein {AttackRange}-großes Gebiet zu erzeugen, das Feinde {Time}s lang <#ef5350ff>um {Slow}% verlangsamt<>. Das Gebiet explodiert beim Ablaufen und fügt Feinden darin <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu.",
        "ult": "Feuert einen Geldhaufen ab, der Feinde in gerader Linie bezaubert. Der getroffene Feind erleidet <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> und ist <#ef5350ff>{Time}s lang bezaubert<>."
      },
      "ghost": {
        "name": "Geist",
        "skill": "Wird unzielbar und stürmt in einer Linie. Bei Kill/Assist erhält er <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Angriff<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tempo<> und <#6aff55ff>stellt {Heal} Leben wieder her<>.",
        "skill2": "Stürmt eine kurze Distanz und fügt dem ersten getroffenen Feind <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu. Kann bis zu {Time} Mal hintereinander verwendet werden.",
        "ult": "Wird für <#ffb900ff>{Time}s<> immun gegen Kontrolleffekte. Töten oder Assists setzen die Grundfähigkeits-Abklingzeit zurück."
      },
      "gunner": {
        "name": "Schütze",
        "skill": "Kann Feinde während der Bewegung angreifen. Ab Stufe 3 erhöht jeder Angriff die <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Lauftempo<> für {Time}s um {Value}%.",
        "skill2": "Verstärke Angriffe für {Time}s, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff steigt um {Attack}<>. Jeder 3. Angriff <#ef5350ff>verlangsamt den Feind um {Slow}% für {SlowTime}s<>.",
        "ult": "Der Angriff wird {Time} Sekunden lang verstärkt, die <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff<> erhöht sich um <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<> und es werden zusätzliche Kugeln auf 2 Feinde um das Angriffsziel abgefeuert. Zusätzliche Kugeln verursachen <#ff9028ff>physischen Schaden<> in Höhe von <#ff9028ff>{Damage}<> + {Coef} % der Angriff."
      },
      "ice_mage": {
        "name": "Eismagier",
        "skill": "Friere einen Feind ein, um <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zuzufügen und ihn <#ef5350ff>für {Time}s zu betäuben<>.",
        "skill2": "Beschwöre ein Eisfeld für {Duration}s, das Feinde in {Range} um <#ef5350ff>{MoveSpeed}% Lauftempo verlangsamt<> und alle {Tick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zufügt. Friert ein und <#ef5350ff>betäubt Feinde für {Stun}s<>, wenn es endet.",
        "ult": "Fügt Feinden in einem frontalen Kegel <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und stößt sie zurück. <#ef5350ff>Verlangsamt um {Slow}% für {SlowDuration}s<> und <#ef5350ff>blockiert Bewegungsfähigkeiten für {BlockDuration}s<>."
      },
      "illusionist": {
        "name": "Illusionist",
        "skill": "Feuert ein Projektil ab und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und beschwört eine Illusion, die <#ef5350ff>für {Time}s provoziert<>.",
        "skill2": "Fügt Feinden in {Range} <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>ängstigt für {Time}s<>.",
        "ult": "Erschafft eine Illusion eines nahen verbündeten Champions, die <#ffb900ff>{Duration}s<> lang anhält. Die Illusion kann nur Standardangriffe ausführen und hat dieselben Werte wie der kopierte Champion."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Beschwört einen kleinen Jiangshi, der auf einen Feind zustürmt und 3 Mal angreift, bevor er verschwindet, und pro Treffer <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> verursacht.",
        "skill2": "Schlägt einen Feind zu Boden und <#ef5350ff>betäubt für {Time}s<>, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#6aff55ff>stellt {Heal} Leben wieder her<>.",
        "ult": "Saugt für <#ffb900ff>{Duration}s<> Feinden in {Range} <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Zauberkraft<> als <#6aff55ff>Leben<> ab und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu."
      },
      "knight": {
        "name": "Ritter",
        "skill": "Wendet auf ein Ziel <#ef5350ff>{Time}s lang Provozieren<> an.",
        "skill2": "Gewährt dir selbst einen <#e8d44dff>Schild<> für {Time}s (<#e8d44dff>Schild<>wert: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% des maximalen Lebens<> + <#e8d44dff>{Amount}<>). Reflektiert <#ff9028ff>{Reflect}%<> des erlittenen Schadens, solange der Schild aktiv ist.",
        "ult": "Beschwört am gewählten Ort eine Verteidigungszone mit {Range} Reichweite für <#ffb900ff>{Time}s<>. Verbündete darin erleiden <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% des maximalen Lebens<> weniger Schaden."
      },
      "lancer": {
        "name": "Lanzer",
        "skill": "Stoße Feinde in {Range} zurück und füge <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu.",
        "skill2": "Stürme eine kurze Distanz, um <#ff9028ff>{Damage}<> + {Value}% des <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff<>s als <#ff9028ff>physischen Schaden<> zuzufügen und hinter den Feind zu bewegen.",
        "ult": "Lädt eine Distanz von {Range} auf, fügt allen während des Angriffs angetroffenen Feinden <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% der Angriff<> als <#ff9028ff>physischen Schaden<> zu und schleudert sie <#ef5350ff>für {Time}s in die Luft<>."
      },
      "lightning_mage": {
        "name": "Blitzmagier",
        "skill": "Schießt einen Blitz auf ein Ziel und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu. Springt zu nahen Feinden über, ohne Ziele zu wiederholen.",
        "skill2": "Schlägt einen Blitz in einem Gebiet ein und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>betäubt für {Time}s<>.",
        "ult": "Kanalisiert einen Blitzstrahl auf einen feindlichen Champion für <#ffb900ff>{Duration}s<> und <#ef5350ff>betäubt<> ihn. Verursacht kontinuierlich <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> am Ziel und nahen Feinden."
      },
      "magic_knight": {
