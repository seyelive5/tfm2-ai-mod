        "skill": "Ném quả cầu sắt theo đường thẳng, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên toàn bộ kẻ địch trong phạm vi.",
        "skill2": "Gầm lên, nhận một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% Máu Tối đa<> trong {Time} giây, đồng thời <#ef5350ff>Khiêu Khích<> lên toàn bộ kẻ địch trong phạm vi xung quanh.",
        "ult": "Lướt tới một kẻ địch được chỉ định, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên toàn bộ kẻ địch xung quanh điểm đáp và <#ef5350ff>Làm Choáng trong {Time} giây<>."
      },
      "android": {
        "name": "Android",
        "skill": "Bắn sóng xung kích theo đường thẳng. Sóng xung kích sẽ phát nổ theo hình tròn khi trúng kẻ địch hoặc bay đến hết tầm, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên các kẻ địch trong phạm vi và <#ef5350ff>Làm Chậm {Slow}% trong {Time} giây<>.",
        "skill2": "Nhận một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% Máu Tối đa<> duy trì trong {Time} giây. Khi lá chắn biến mất, <#ef5350ff>Làm Choáng toàn bộ kẻ địch xung quanh trong phạm vi {Range} trong {StunTime} giây<>.",
        "ult": "Tạo một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% Máu Tối đa<> cho một đồng minh được chỉ định trong phạm vi {Range}, đồng thời dịch chuyển đến vị trí của đồng minh đó sau {Time} giây."
      },
      "white_mage": {
        "name": "White Mage",
        "skill": "Chiếu tia sáng theo đường thẳng sẽ phát nổ sau chốc lát, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên toàn bộ kẻ địch trong phạm vi.",
        "skill2": "Triệu hồi chùm tia sáng trong khu vực hình tròn, tấn công 5 lần và gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch trong phạm vi, đồng thời <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>.",
        "ult": "Bắn tia sáng xuyên thấu theo đường thẳng, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch trúng chiêu và <#ef5350ff>Trói Chân chúng trong {Time} giây<>."
      },
      "wind_mage": {
        "name": "Wind Mage",
        "skill": "Triệu hồi cơn cuồng phong trong <#ffb900ff>{Duration} giây<>, mỗi {Tick} giây gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch trong phạm vi {Range}. Đồng minh ở trong cuồng phong được <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>tăng {MoveSpeed}% Tốc độ Di chuyển<>.",
        "skill2": "Bắn năm lốc xoáy về phía trước, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch trong phạm vi.",
        "ult": "Bắn một cơn lốc xoáy khổng lồ di chuyển chậm về phía tướng địch gần nhất. Kẻ địch trúng lốc xoáy chịu <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> và bị <#ef5350ff>Hất Tung trong {AirborneTime} giây<>. Mỗi lần trúng đích, kích thước, sát thương và thời gian hất tung của cơn lốc xoáy sẽ giảm đi, đồng thời đổi hướng bay về phía một tướng địch khác."
      },
      "bomber": {
        "name": "Bomber",
        "skill": "Ném bom, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên toàn bộ kẻ địch trong phạm vi.",
        "skill2": "Đặt một quả mìn vô hình với kẻ địch, nếu kẻ địch đạp trúng sẽ gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> và <#ef5350ff>Trói Chân trong {Time} giây<>. Mìn không kích hoạt lên lính.",
        "ult": "Ném một quả bom khổng lổ xuống vị trí chỉ định, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên toàn bộ kẻ địch trong phạm vi và <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>."
      },
      "cavalry_knight": {
        "name": "Cavalry",
        "skill": "Lướt theo đường thẳng, đâm xuyên kẻ địch đầu tiên trúng chiêu, <#ef5350ff>Trói Chân trong {Time} giây<> và gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<>. Tốc độ lướt tỉ lệ thuận với Tốc Độ Di Chuyển.",
        "skill2": "Trong {Time} giây, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>tăng {Speed}% Tốc độ Di chuyển<> và cường hóa vũ khí thành giáo lửa, khiến các đòn tấn công gây thêm <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% SMCK<> Sát thương Thiêu đốt trong {BurnTime} giây.",
        "ult": "Trong {Time} giây, tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Speed}% Tốc độ Di chuyển<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% SMCK<>, đồng thời tạo ra một con đường hướng về vị trí của bản thân. Đồng minh đứng trên con đường khi di chuyển về phía Cavalry sẽ được tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Buff}% Tốc độ Di chuyển<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% SMCK<>."
      },
      "druid": {
        "name": "Druid",
        "skill": "Triệu hồi một chú gấu thân thiện. Nếu gấu bị hạ gục, Druid sẽ chịu <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% SMPT<> sát thương. Nếu sử dụng khi gấu đang tồn tại, <#6aff55ff>hồi phục<> <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% SMPT<> Máu cho gấu.",
        "skill2": "Triệu hồi một con đại bàng dũng mãnh. Nếu đại bàng bị hạ gục, Druid sẽ gánh chịu sát thương. Nếu sử dụng kỹ năng này khi đại bàng đang tồn tại, đại bàng sẽ lao tới kẻ địch, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> và <#6aff55ff>hồi Máu bằng {Lifesteal}%<> lượng sát thương gây ra.",
        "ult": "Bắn liên tiếp {Count} linh hồn gấu và đại bàng theo hướng chỉ định. Mỗi linh hồn gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> và đẩy lùi kẻ địch."
      },
      "voodoo_shaman": {
        "name": "Voodoo Shaman",
        "skill": "Bắn một viên đạn nguyền rủa, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<>, <#ef5350ff>Làm Chậm {Slow}% trong {Time} giây<> đồng thời giảm <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AtkSpd}% Tốc độ Đánh<> trong <#ffb900ff>{AtkSpdTime} giây<>.",
        "skill2": "Nguyền rủa mục tiêu chỉ định trong <#ffb900ff>{Time} giây<> và gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<>. Trong thời gian duy trì, gây thêm <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% SMPT<> sát thương tương ứng với số lần mục tiêu bị tấn công (tối đa {Max} lần)",
        "ult": "Tạo một vùng tà thuật tại vị trí chỉ định trong <#ffb900ff>{Duration} giây<>. Kẻ địch trong vùng sẽ liên tục chịu <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% Máu Tối đa<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> và bị <#ef5350ff>Câm Lặng<>. <#ef5350ff>Câm Lặng<> khiến kẻ địch không thể dùng kỹ năng."
      },
      "hitman": {
        "name": "Hitman",
        "skill": "Bắn ba phát đạn liên tiếp. Phát đạn đầu tiên gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên kẻ địch và <#ef5350ff>Làm Choáng trong {StunTime} giây<>.",
        "skill2": "Dịch chuyển ra sau lưng tướng địch vừa bị tấn công trong phạm vi {Range}.",
        "ult": "Đánh dấu một tướng địch, sau <#ffb900ff>{Duration} giây<> gây <#ff9028ff>{Damage} + {Coef}% lượng sát thương mục tiêu gánh chịu trong thời gian bị đánh dấu<> <#ff9028ff>Sát thương Vật lý<>. Nếu hạ gục mục tiêu, Hitman sẽ Tàng Hình trong <#ffb900ff>{InvisibleDuration} giây<>."
      },
      "guardian_spirit": {
        "name": "Guardian Spirit",
        "skill": "<#6aff55ff>Hồi phục<> <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> Máu cho các đồng minh xung quanh.",
        "skill2": "Cho đồng minh một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% SMPT<>, đồng thời <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>tăng {MoveSpeed}% Tốc độ Di chuyển<>.",
        "ult": "Tạo một vùng thánh địa trong <#ffb900ff>{Duration} giây<>, liên tục <#6aff55ff>hồi phục<> <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% SMPT<> Máu cho đồng minh trong phạm vi, đồng thời ban giáp hồi sinh."
      },
      "hunter": {
        "name": "Hunter",
        "skill": "Dịch chuyển đến kẻ địch và chuyển sang Đánh Xa. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Tăng {RangeIncrease} Tầm Đánh<>.",
        "skill2": "Lao đến kẻ địch tích đủ 3 cộng dồn, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> và làm <#ef5350ff>Câm Lặng trong {SilenceTime} giây<>. <#ef5350ff>Câm Lặng<> khiến kẻ địch không thể dùng kỹ năng.",
        "ult": "Lướt về phía trước, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên kẻ địch trên đường lướt. Có thể sử dụng lại khi tham gia hạ gục kẻ địch."
      },
      "circus_blade": {
        "name": "Circus Blade",
        "skill": "Phóng lưỡi đao theo hướng chỉ định, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên kẻ địch và <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>. Tích trữ tối đa <#ffb900ff>{ChargeCount} lần<>, hồi lại <#ffb900ff>1 lần<> tích trữ khi đòn đánh thường trúng tướng địch.",
        "skill2": "Trong <#ffb900ff>{Duration} giây<>, tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc độ Di chuyển<> và <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc độ Đánh<>, đồng thời nhận hiệu ứng Đi xuyên Địa hình.",
        "ult": "Lao đến kẻ địch chỉ định, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<>. Gây <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% SMCK<> sát thương diện rộng và <#ef5350ff>Đẩy Lùi<> các kẻ địch xung quanh, sau đó biến mất."
      },
      "tfm2_cc_emberling": {
        "name": "Emberling",
        "skill": "Fires a piercing ember bolt dealing 80% AP.",
        "skill2": "Focuses flame: gains magic power and faster cooldowns.",
        "ult": "Erupts, dealing 100% AP and stunning nearby enemies."
      }
    }
  },
