      "soldier": {
        "name": "Soldado",
        "skill": "Alcance de ataque aumenta en <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{GrowthRange}<> por nivel.",
        "skill2": "Dispara tres balas a un enemigo para <#ff9028ff>daño físico<> pesado (<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque por bala). Alcance de habilidad escala con alcance de ataque básico.",
        "ult": "Dispara una bala enorme que vuela en línea recta para impactar a los enemigos dentro de {Range}. La bala inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos en la trayectoria, y cada vez que golpea a un enemigo, el daño se reduce un {Decay}%."
      },
      "swordman": {
        "name": "Espadachín",
        "skill": "Dispara energía de espada para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> a enemigos golpeados (alcance {Range}).",
        "skill2": "Corta un objetivo único tres veces en sucesión para <#ff9028ff>daño físico<> pesado. <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque por golpe.",
        "ult": "Carga {Range} distancia en línea recta, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> a los enemigos dentro del rango de carga. El daño se distribuye según la cantidad de enemigos golpeados. Si matas a un enemigo con tu habilidad definitiva, el tiempo de reutilización de tu habilidad definitiva se reinicia."
      },
      "taoist": {
        "name": "Taoísta",
        "skill": "Sella a un enemigo con un talismán, <#ef5350ff>impidiendo ataques básicos durante {Time}(+{TimeCoef}% del poder de habilidad)s<>.",
        "skill2": "Pega un talismán a un enemigo, <#ef5350ff>impidiendo el uso de habilidades durante {Time}(+{TimeCoef}% del poder de habilidad)s<>.",
        "ult": "Dispara un proyectil de talismán en línea recta. Causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> e <#ef5350ff>incapacita al objetivo durante {Time}s<>, haciéndolo no objetivo. Cuando el efecto termina, se extiende a enemigos cercanos."
      },
      "vampire": {
        "name": "Vampiro",
        "skill": "Drena sangre de un enemigo para infligir <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> del poder de habilidad como <#a974ffff>daño mágico<>, <#6aff55ff>restaurar<> <#6aff55ff>{Heal}<> salud y apilar. Curación aumenta en {Stack} por pila.",
        "skill2": "Consume {Value}% salud para escupir sangre en un cono frontal, infligiendo <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> del poder de habilidad como <#a974ffff>daño mágico<>. Daño aumenta en {Stack} por pila.",
        "ult": "Se vuelve inalcanzable y carga {Range} distancia, <#6aff55ff>absorbiendo salud<> igual a <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de poder de habilidad<> de cada enemigo en la trayectoria, e infligiendo <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% de poder de habilidad<> como <#a974ffff>daño mágico<>."
      },
      "werewolf": {
        "name": "Hombre lobo",
        "skill": "Garra hacia adelante, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y <#6aff55ff>curándose el {HealRatio}% del daño causado<>.",
        "skill2": "Se desplaza hacia adelante, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>.",
        "ult": "Canaliza durante <#ffb900ff>{Duration}s<>, causando repetidamente <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y aplicando <#ef5350ff>sangrado durante {BleedTime}s<> (<#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% AD<>)."
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Mejora la maza durante <#ffb900ff>{Duration}s<>. Cada ataque crea una onda de choque en abanico que causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>.",
        "skill2": "Refuerza la piel durante <#ffb900ff>{Duration}s<>, obteniendo un <#e8d44dff>escudo<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> y <#e8d44dff>{DamageReduction}% de reducción de daño<>.",
        "ult": "Dispara un proyectil en línea recta. Los enemigos golpeados son <#ef5350ff>ralentizados gradualmente durante {SlowTime}s<>, luego <#ef5350ff>enraizados durante {BindTime}s<>. Al enraizarse, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a enemigos cercanos. El efecto se propaga a enemigos dañados."
      },
      "hammerer": {
        "name": "Infantería pesada",
        "skill": "Balancea un martillo a un enemigo cercano para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>lanzarlo al aire por {Time}s<>.",
        "skill2": "Concéntrate con el martillo levantado, luego golpea el suelo para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> en {Range} y aplicar <#ef5350ff>{Move}% de ralentización por {Time}s<>.",
        "ult": "Balancea el martillo ampliamente, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos en un área semicircular dentro del rango {Range} al frente. Los enemigos golpeados por el martillo son empujados hacia atrás durante {Time}s, y los campeones enemigos golpeados por el enemigo empujado <#ef5350ff>quedan en el aire durante {Airborne}s<>."
      },
      "inquisitor": {
        "name": "Inquisidor",
        "skill": "Se desplaza una distancia corta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> al primer enemigo golpeado y aplicando <#ef5350ff>sangrado<>.",
        "skill2": "Corta a un enemigo objetivo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<>. Reinicia el cooldown de la Habilidad 1 si está <#ef5350ff>sangrando<>.",
        "ult": "Embiste a un campeón enemigo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos en el área al llegar. Los enemigos por debajo del {Threshold}% del HP máximo tras recibir daño son ejecutados. Al ejecutar, los enemigos cercanos son <#ef5350ff>aterrorizados durante {FearTime}s<>."
      },
      "pole_warrior": {
        "name": "Guerrero de pértiga",
        "skill": "Salta a un enemigo y golpea con la pértiga para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>.",
        "skill2": "Mueve una corta distancia, párate en la pértiga para volverte inalcanzable por {Time}s, luego balancea para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> a todos los enemigos en {Range}.",
        "ult": "Carga contra un enemigo designado dentro del rango {Range}, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> al enemigo y <#ef5350ff>eleva al objetivo en el aire durante {Time}s<>."
      },
      "spirit_caller": {
        "name": "Invocador de espíritus",
        "skill": "Adhiere un espíritu a un aliado durante <#ffb900ff>{Duration}s<>, <#6aff55ff>restaurando vida<> en <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% PH<> y aumentando la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidad de movimiento un {SpeedUp}%<>.",
        "skill2": "Une un espíritu a un enemigo durante <#ffb900ff>{Duration}s<>, reduciendo <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>armadura en {DefDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefCoef}% del poder de habilidad<>, <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>resistencia mágica en {MrDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MrCoef}% del poder de habilidad<> y <#ef5350ff>ralentizando un {Slow}%<>.",
        "ult": "Detona los espíritus adheridos. Los espíritus aliados otorgan <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% PH<> de <#e8d44dff>escudo<> y <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de velocidad de ataque<>. Los espíritus enemigos causan <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% del poder de habilidad<> como <#a974ffff>daño mágico<> y <#ef5350ff>aturden durante {StunTime}s<>."
      },
      "whip_master": {
