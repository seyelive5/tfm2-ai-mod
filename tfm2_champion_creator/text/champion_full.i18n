      "plague_doctor": {
        "name": "Veba doktoru",
        "skill": "Bir müttefiğe ve kendine iğne yaparak <#ffb900ff>{Duration}s<> boyunca <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını %{AttackSpeed}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{AttackSpeedCoef}'i<> ve <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızını %{MoveSpeed}<> artırır.",
        "skill2": "Bir müttefik üzerinde <#ffb900ff>{Duration}s<> ritüel yaparak <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>menzilini {Range}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{RangeCoef}'i<> artırır ve saldırılarına atılma etkisi ekler.",
        "ult": "Bir müttefiğe yasak iksir verir, Canını 1'e indirir; buna karşılık {Duration}s boyunca Canı 1'in altına düşmez ve <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırısı {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızı %{AttackSpeed}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{AttackSpeedCoef}'i<> ve <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızı %{MoveSpeed}<> artar."
      },
      "poison_dart_hunter": {
        "name": "Zehirli ok avcısı",
        "skill": "Zehir alanı yayar, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir, <#ffb900ff>{Duration}s<> zehirler ve <#ef5350ff>{Slow}% yavaşlatır<>.",
        "skill2": "Zehirli düşmanlara saldırı <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>menzili {Range}<> artırır. Zehirli düşmanlardan uzaklaşmak <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızını {Speed}%<> artırır.",
        "ult": "<#ffb900ff>{Duration}s<> boyunca yakın müttefiklerin saldırılarına zehir verir. Zehir <#ffb900ff>{PoisonDuration}s<> boyunca <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir."
      },
      "priest": {
        "name": "Rahip",
        "skill": "{Duration}s süren {Range} alanda yenileme alanı kur, her {Tick}s alandaki müttefik canını <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#6aff55ff>yeniler<>.",
        "skill2": "Bir müttefike {Time}s <#e8d44dff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#e8d44dff>kalkan<> ver. Kalkan sürerken müttefikin <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızı %{AttackSpeed} artar<>.",
        "ult": "{Time}s havada uçar ve sabit kalır, her {Tick}s bir mermi atarak ulti menzilindeki en az canlı müttefike <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> <#6aff55ff>can yeniler<>."
      },
      "pyromancer": {
        "name": "Ateş büyücüsü",
        "skill": "Ateş topu düşürür, {Range} içinde <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir.",
        "skill2": "{Duration}s süren ateş alanı çağırır, {Range} içinde her {Tick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir.",
        "ult": "{Range} içinde devasa patlama yaratır, tüm düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir."
      },
      "pythoness": {
        "name": "Pythoness",
        "skill": "Bir müttefikin canını <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#6aff55ff>yeniler<>.",
        "skill2": "Bir müttefikin canını <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si kadar <#6aff55ff>yeniler<> ve etrafındaki {Range} alandaki düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {DamageCoef}%<>'si kadar <#a974ffff>büyü hasarı<> ver.",
        "ult": "Ruh Kapısı çağırın. Ruh Kapısı, {Range} menzilindeki müttefiklerin canını <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#6aff55ff>yenileyen<>, veya düşmanlara <#a974ffff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#a974ffff>büyü hasarı<> veren mermiler ateşler."
      },
      "shadowmancer": {
        "name": "Gölge büyücüsü",
        "skill": "Karanlık gölgeler yükselir, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}s köklendirir<>.",
        "skill2": "Hareketsiz düşmanın gölgesini patlatır, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir.",
        "ult": "Delici gölge mermisi ateşler, vurulan düşman şampiyonlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{BanishTime}s sürgüne gönderir<>."
      },
      "shield_bearer": {
        "name": "Kalkan taşıyıcısı",
        "skill": "Belirtilen bir müttefik ve kendine <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maks. HP<> <#e8d44dff>kalkan<> ver ({Duration}s).",
        "skill2": "{Duration}s boyunca yakındaki müttefiklere verilen hasarın %{Damage}'ini üstlenir ve müttefiki vuran düşmanı <#ef5350ff>%{Coef}<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>zırhının %{DefCoef}'i<> kadar yavaşlatır.",
        "ult": "{Duration}s boyunca <#e8d44dff>%{DamageReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>büyü direncinin %{MrCoef}'i<> hasar azaltma ve kitle kontrol bağışıklığı kazanır; çevredeki tüm düşmanları <#ef5350ff>{TauntDuration}s boyunca kışkırtır<>. Etki sırasında hareket edemez."
      },
      "soldier": {
        "name": "Asker",
        "skill": "Her seviye saldırı menzili <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{GrowthRange}<> artar.",
        "skill2": "Bir düşmana üç mermi ateşleyerek ağır <#ff9028ff>fiziksel hasar<> ver (mermi başına <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si). Yetenek menzili temel saldırı menziliyle ölçeklenir.",
        "ult": "{Range} mesafe içindeki düşmanları hedef alan, düz bir çizgide uçan devasa bir mermi ateşler. Mermi, geçen yörünge içindeki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir ve bir düşmana her çarptığında, hasar %{Decay} azalır."
      },
      "swordman": {
        "name": "Kılıç ustası",
        "skill": "Kılıç enerjisi atarak vurulan düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver (menzil {Range}).",
        "skill2": "Tek bir hedefi ardışık üç kez keserek ağır <#ff9028ff>fiziksel hasar<> ver. Vuruş başına <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si.",
        "ult": "Düz bir çizgide {Range} mesafe şarj eder ve şarj menzilindeki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir. Hasar, vurulan düşman sayısına göre dağıtılır. Eğer bir düşmanı ultinizle öldürürseniz, ultinizin bekleme süresi sıfırlanır."
      },
      "taoist": {
        "name": "Taoist",
        "skill": "Bir düşmanı tılsımla mühürleyerek <#ef5350ff>{Time}(+yetenek gücünün %{TimeCoef}'i)s<> boyunca normal saldırı yapmasını engeller.",
        "skill2": "Bir düşmana tılsım yapıştırarak <#ef5350ff>{Time}(+yetenek gücünün %{TimeCoef}'i)s<> boyunca yetenek kullanmasını engeller.",
        "ult": "Doğrultu boyunca tılsım mermisi ateşler. <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}s hedefi etkisizleştirir<>, hedeflenemez yapar. Etki bittiğinde yakın düşmanlara yayılır."
      },
      "vampire": {
        "name": "Vampir",
        "skill": "Bir düşmanın kanını emerek <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#a974ffff>büyü hasarı<> ver ve <#6aff55ff>{Heal} can yenile<> ve yığın. <#6aff55ff>Yığın başına yenileme {Stack} artar<>.",
        "skill2": "Canının {Value}%'sini tüketerek öne koni şeklinde kan püskürt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#a974ffff>büyü hasarı<> ver. Yığın başına hasar {Stack} artar.",
        "ult": "Hedef alınamaz hale gelir ve {Range} mesafeye atılır, hücum yörüngesindeki her düşmandan <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% büyü gücü<> kadar <#6aff55ff>can emer<> ve <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% büyü gücü<> <#a974ffff>büyü hasarı<> verir."
      },
      "werewolf": {
        "name": "Kurt adam",
        "skill": "Öne pençe atar, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#6aff55ff>verdiği hasarın {HealRatio}%'ı kadar iyileşir<>.",
        "skill2": "Öne atılır, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{SlowTime}s boyunca {Slow}% yavaşlatır<>.",
        "ult": "<#ffb900ff>{Duration}s<> kanal yapar, defalarca <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{BleedTime}s kanama<> uygular (<#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% Saldırı<>)."
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "<#ffb900ff>{Duration}s<> sopayı güçlendirir. Her saldırı yelpaze şeklinde şok dalgası oluşturur, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir.",
        "skill2": "<#ffb900ff>{Duration}s<> boyunca derisini güçlendirerek <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}'i<> kadar <#e8d44dff>kalkan<> ve <#e8d44dff>%{DamageReduction} hasar azaltma<> kazanır.",
        "ult": "Doğrultu boyunca mermi ateşler. Vurulan düşmanlar <#ef5350ff>{SlowTime}s boyunca giderek yavaşlar<>, sonra <#ef5350ff>{BindTime}s köklenir<>. Köklenmede yakın düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir. Etki hasar gören düşmanlara yayılır."
      },
      "hammerer": {
        "name": "Ağır piyade",
        "skill": "Yakın bir düşmana çekiç salla, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve <#ef5350ff>{Time}s havaya fırlat<>.",
        "skill2": "Çekici kaldırıp odaklan, yere vur {Range} alandaki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve <#ef5350ff>{Time}s %{Move} yavaşlat<>.",
        "ult": "Çekici genişçe sallayarak öndeki {Range} menzilindeki yarım daire şeklindeki bir alandaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}<>'sine eşit <#ff9028ff>fiziksel hasar<> verir. Çekiçle vurulan düşmanlar {Time}s geri savrulur ve itilen düşmanın vurduğu rakip şampiyonlar <#ef5350ff>{Airborne}s havada kalır<>."
      },
      "inquisitor": {
        "name": "Engizisyoncu",
        "skill": "Kısa mesafe atılır, ilk vurduğu düşmana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>kanama<> uygular.",
        "skill2": "Hedeflenen düşmanı keser, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. Hedef <#ef5350ff>kanıyorsa<> Yetenek 1 bekleme süresini sıfırlar.",
        "ult": "Düşman şampiyona doğru saldırır, varışta alandaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir. Hasar sonrası maks CG'ı {Threshold}%'in altına düşen düşmanlar idam edilir. İdamda yakın düşmanlar <#ef5350ff>{FearTime}s korkutulur<>."
      },
      "pole_warrior": {
        "name": "Kutup savaşçısı",
        "skill": "Düşmana sıçrayarak kutupla vur <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "skill2": "Kısa mesafe hareket et, kutupa çıkarak {Time}s hedeflenemez ol, sonra sallayarak {Range} alandaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "ult": "{Range} menzilindeki belirlenmiş bir düşmana hücum eder, düşmana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}<>'sine eşit <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>hedefi {Time}s havaya kaldırır<>."
      },
      "spirit_caller": {
        "name": "Ruh çağıran",
        "skill": "Müttefike <#ffb900ff>{Duration}s<> ruh iliştirir, <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% YG<> kadar <#6aff55ff>can yeniler<> ve <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızını {SpeedUp}% artırır<>.",
        "skill2": "Bir düşmana <#ffb900ff>{Duration}s<> boyunca ruh bağlar; <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>zırhını {DefDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{DefCoef}'i<>, <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>büyü direncini {MrDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{MrCoef}'i<> azaltır ve <#ef5350ff>%{Slow} yavaşlatır<>.",
        "ult": "İliştirilen ruhları patlatır. Müttefik ruhlar <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% YG<> <#e8d44dff>kalkan<> ve <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% saldırı hızı<> verir. Düşman ruhlar <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% yetenek gücü<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{StunTime}s sersemleştirir<>."
