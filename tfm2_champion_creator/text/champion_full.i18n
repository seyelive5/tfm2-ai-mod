      "siege_breaker": {
        "name": "Kuşatma kırıcı",
        "skill": "Topuzla vurur, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. Yapılara {Bonus}% bonus hasar verir.",
        "skill2": "Yere vurur, yapılar dahil tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir.",
        "ult": "{Time}s boyunca <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırıyı {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AttackSpeed}%<> ve <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızını {MoveSpeed}%<> artırır."
      },
      "prisoner": {
        "name": "Mahkum",
        "skill": "Doğrultu boyunca demir top atar, alandaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir.",
        "skill2": "Kükreyerek {Time}s boyunca <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>azami canın %{Coef}'i<> kadar <#e8d44dff>kalkan<> kazanır ve yakındaki tüm düşmanları <#ef5350ff>kışkırtır<>.",
        "ult": "Düşmana saldırır, iniş noktasına yakın tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{Time}s sersemletir<>."
      },
      "android": {
        "name": "Android",
        "skill": "Düz yöne şok dalgası ateşle. Şok dalgası düşmana isabet ettiğinde veya menzil sonuna ulaştığında daire şeklinde patlayarak düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{Time}s boyunca %{Slow} yavaşlatır<>.",
        "skill2": "{Time}s süren <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>azami canın %{Coef}'i<> kadar <#e8d44dff>kalkan<> kazanır. Kalkan kaybolduğunda {Range} menzil içindeki düşmanları <#ef5350ff>{StunTime}s sersemletir<>.",
        "ult": "{Range} menzil içindeki seçilen müttefiğe <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>azami canın %{Coef}'i<> kadar <#e8d44dff>kalkan<> verir ve {Time}s sonra seçilen müttefiğe ışınlanır."
      },
      "white_mage": {
        "name": "Beyaz büyücü",
        "skill": "Bir ışın gecikme sonrası patlar, tüm düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir.",
        "skill2": "5 kez saldıran ışınlar çağırır, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{SlowTime}s boyunca {Slow}% yavaşlatır<>.",
        "ult": "Delici ışın ateşler, vurulan düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}s köklendirir<>."
      },
      "wind_mage": {
        "name": "Rüzgar büyücüsü",
        "skill": "<#ffb900ff>{Duration}s<> hortum çağırır, {Range} içinde her {Tick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir. İçindeki müttefikler <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% hareket hızı<> kazanır.",
        "skill2": "Öne beş hortum ateşler, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir.",
        "ult": "Devasa kasırga fırlatır. Vurulan düşmanlar <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> alır ve <#ef5350ff>{AirborneTime}s havada<> kalır. Boyut, hasar ve havada kalma süresi vuruş başına azalır. Diğer şampiyonlara yönlendirir."
      },
      "bomber": {
        "name": "Bombacı",
        "skill": "Bomba atar, alandaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir.",
        "skill2": "Üzerine basıldığında <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> veren ve <#ef5350ff>{Time}s köklendiren<> görünmez mayın yerleştirir. Asker üzerinde tetiklenmez.",
        "ult": "Hedef alana büyük bomba atar, tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{SlowTime}s boyunca {Slow}% yavaşlatır<>."
      },
      "cavalry_knight": {
        "name": "Süvari şövalye",
        "skill": "Düz bir yöne hücum ederek ilk vurulan düşmanı mızrakla deler, <#ef5350ff>{Time} saniye köklenir<> ve <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir. Hücum hızı hareket hızıyla orantılıdır.",
        "skill2": "{Time}s boyunca <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızını %{Speed} artırır<> ve silahını alevli mızrağa dönüştürerek saldırılarda {BurnTime}s boyunca ek <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{BurnCoef}'i<> kadar yanma hasarı verir.",
        "ult": "{Time}s boyunca <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızını %{Speed}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{SpeedCoef}'i<> artırır ve kendi konumuna yönelen bir alan oluşturur. Alandaki müttefikler Süvariye doğru hareket ederken <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>%{Buff}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{SpeedCoef}'i<> hareket hızı kazanır."
      },
      "druid": {
        "name": "Druid",
        "skill": "Ayı çağırır. Ölürse, druid <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% YG<> hasar alır. Çağrılıyken kullanmak ayının canını <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% YG<> kadar <#6aff55ff>yeniler<>.",
        "skill2": "Bir kartal çağırır. Kartal ölürse Druid hasar alır. Kartal çağrılıyken bu yetenek kullanılırsa kartal düşmana atılarak <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{Coef}'i<> kadar <#a974ffff>büyü hasarı<> verir ve verilen hasarın <#6aff55ff>%{Lifesteal}'i kadar Can yeniler<>.",
        "ult": "Belirlenen yöne art arda {Count} ayı ve kartal ruhu gönderir. Her mermi <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{Coef}'i<> kadar <#a974ffff>büyü hasarı<> verir ve düşmanları geriye iter."
      },
      "voodoo_shaman": {
        "name": "Vudu şamanı",
        "skill": "Lanet mermisi ateşler, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir, <#ef5350ff>{Time}s boyunca {Slow}% yavaşlatır<> ve <#ffb900ff>{AtkSpdTime}s<> <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AtkSpd}%<> azaltır.",
        "skill2": "Düşmanı <#ffb900ff>{Time}s<> lanetler, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir. Aldığı her vuruşta <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% YG<> bonus hasar verir (maks {Max}).",
        "ult": "<#ffb900ff>{Duration}s<> voodoo bölgesi yaratır. İçindeki düşmanlar periyodik olarak <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% maks CG<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> alır ve <#ef5350ff>susturulur<>."
      },
      "hitman": {
        "name": "Tetikçi",
        "skill": "Üç atışlık seri ateşler. İlk atış <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{StunTime}s sersemleştirir<>.",
        "skill2": "{Range} menzilinde son saldırılan düşman şampiyonun arkasına ışınlanır.",
        "ult": "Bir düşman şampiyonu işaretler. <#ffb900ff>{Duration}s<> sonra <#ff9028ff>{Damage} + işaret süresince alınan hasarın %{Coef}'i<> kadar <#ff9028ff>fiziksel hasar<> verir. Hedef öldürülürse <#ffb900ff>{InvisibleDuration}s<> gizlenir."
      },
      "guardian_spirit": {
        "name": "Ruh Koruyucusu",
        "skill": "Yakın müttefiklerin canını <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> kadar <#6aff55ff>yeniler<>.",
        "skill2": "Müttefiğe <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% YG<> <#e8d44dff>kalkan<> ve <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% hareket hızı<> verir.",
        "ult": "<#ffb900ff>{Duration}s<> sığınak yaratır, müttefiklerin canını periyodik olarak <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% YG<> kadar <#6aff55ff>yeniler<> ve diriltme kalkanı verir."
