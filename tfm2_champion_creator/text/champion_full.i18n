        "name": "机器人",
        "skill": "向直线发射冲击波。冲击波命中敌人或到达射程末端时圆形爆炸，对范围内的敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<>的<#ff9028ff>物理伤害<>，并施加<#ef5350ff>{Time}秒{Slow}%减速<>。",
        "skill2": "为自身赋予持续{Time}秒的<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大生命值的{Coef}%<>的<#e8d44dff>护盾<>。护盾消失时，使周围{Range}范围内的敌人<#ef5350ff>眩晕{StunTime}秒<>。",
        "ult": "为{Range}范围内指定友军赋予<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大生命值的{Coef}%<>的<#e8d44dff>护盾<>，并在{Time}秒后瞬移到该友军身边。"
      },
      "white_mage": {
        "name": "白魔法师",
        "skill": "光束延迟后爆炸，对所有敌人造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>。",
        "skill2": "召唤光束攻击5次，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>，并<#ef5350ff>减速{Slow}%持续{SlowTime}秒<>。",
        "ult": "发射穿透光束，对命中敌人造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>，并<#ef5350ff>束缚{Time}秒<>。"
      },
      "wind_mage": {
        "name": "飓风法师",
        "skill": "召唤旋风<#ffb900ff>{Duration}秒<>，每{Tick}秒对{Range}内造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>。内部队友获得<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移动速度<>。",
        "skill2": "向前发射五个旋风，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>。",
        "ult": "释放巨大龙卷风。命中敌人受到<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>，并被<#ef5350ff>击飞{AirborneTime}秒<>。每次命中尺寸、伤害和击飞时间减少。重新指向其他英雄。"
      },
      "bomber": {
        "name": "爆破手",
        "skill": "投掷炸弹，对范围内所有敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击<>的<#ff9028ff>物理伤害<>。",
        "skill2": "放置隐形地雷，被踩到时造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击<>的<#ff9028ff>物理伤害<>，并<#ef5350ff>束缚{Time}秒<>。不会被小兵触发。",
        "ult": "向目标区域投掷大炸弹，对所有敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>的<#ff9028ff>物理伤害<>，并<#ef5350ff>减速{Slow}%持续{SlowTime}秒<>。"
      },
      "cavalry_knight": {
        "name": "骑兵",
        "skill": "向直线突进刺穿第一个命中的敌人，<#ef5350ff>束缚{Time}秒<>并造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<>的<#ff9028ff>物理伤害<>。突进速度与移动速度成正比。",
        "skill2": "{Time}秒内<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度提高{Speed}%<>，并将武器强化为火焰长枪，攻击时额外造成持续{BurnTime}秒的<#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{BurnCoef}%<>灼烧伤害。",
        "ult": "{Time}秒内<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度提高{Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{SpeedCoef}%<>，并生成通向自身位置的地带。地带上的友军朝骑兵方向移动时，<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度提高{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{SpeedCoef}%<>。"
      },
      "druid": {
        "name": "德鲁伊",
        "skill": "召唤熊。死亡时，德鲁伊受到<#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}%法强<>的伤害。召唤期间再次施放，<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%法强<>地<#6aff55ff>回复<>熊的生命值。",
        "skill2": "召唤鹰。鹰死亡时，德鲁伊会受到伤害。鹰已被召唤时再次使用该技能，鹰会冲向敌人，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<>的<#a974ffff>魔法伤害<>，并<#6aff55ff>按造成伤害的{Lifesteal}%回复生命值<>。",
        "ult": "向指定方向连续发射{Count}个熊与鹰的灵魂投射物。每个投射物造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<>的<#a974ffff>魔法伤害<>，并将敌人击退。"
      },
      "voodoo_shaman": {
        "name": "巫毒萨满",
        "skill": "发射诅咒投射物，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>，<#ef5350ff>减速{Slow}%持续{Time}秒<>，并<#ffb900ff>{AtkSpdTime}秒<>内降低<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻速{AtkSpd}%<>。",
        "skill2": "诅咒敌人<#ffb900ff>{Time}秒<>，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>。每次受到命中造成<#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}%法强<>的额外伤害(最多{Max})。",
        "ult": "创造巫毒区域<#ffb900ff>{Duration}秒<>。内部敌人定期受到<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}%最大HP<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>并<#ef5350ff>沉默<>。"
      },
      "hitman": {
        "name": "杀手",
        "skill": "三连射。第一发造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>的<#ff9028ff>物理伤害<>，并<#ef5350ff>晕眩{StunTime}秒<>。",
        "skill2": "瞬间移动到{Range}范围内最近攻击的敌方英雄背后。",
        "ult": "标记敌方英雄，<#ffb900ff>{Duration}秒<>后造成<#ff9028ff>{Damage} + 标记期间所受伤害的{Coef}%<>的<#ff9028ff>物理伤害<>。击杀目标时，获得<#ffb900ff>{InvisibleDuration}秒<>隐身。"
      },
      "guardian_spirit": {
        "name": "戍魂灵",
        "skill": "对附近范围内的队友<#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>地<#6aff55ff>回复<>生命值。",
        "skill2": "为队友提供<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}%法强<>的<#e8d44dff>护盾<>和<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移动速度<>。",
        "ult": "创造圣域<#ffb900ff>{Duration}秒<>，对范围内的队友持续<#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%法强<>地<#6aff55ff>回复<>生命值，并提供复活护盾。"
      },
      "hunter": {
        "name": "追猎者",
        "skill": "瞬间移动到敌人，切换到远程模式。<i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>射程提升{RangeIncrease}<>。",
        "skill2": "向带有3层标记的敌人冲刺，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>的<#ff9028ff>物理伤害<>，并<#ef5350ff>沉默{SilenceTime}秒<>。",
        "ult": "向前冲刺，对路径上的敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>的<#ff9028ff>物理伤害<>。击杀或助攻时可重新施放。"
      },
      "circus_blade": {
        "name": "戏刃师",
        "skill": "向目标方向发射刀刃，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>的<#ff9028ff>物理伤害<>，并<#ef5350ff>减速{Slow}%持续{SlowTime}秒<>。最多储存<#ffb900ff>{ChargeCount}<>层。对敌方英雄进行基本攻击时获得<#ffb900ff>1<>层。",
        "skill2": "<#ffb900ff>{Duration}秒<>内获得<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移速<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%攻速<>和穿墙。",
        "ult": "向目标敌人冲刺，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>的<#ff9028ff>物理伤害<>。造成<#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}%攻击<>的溅射伤害并<#ef5350ff>击退附近敌人<>，然后消失。"
      },
      "tfm2_cc_emberling": {
        "name": "Emberling",
        "skill": "Fires a piercing ember bolt dealing 80% AP.",
        "skill2": "Focuses flame: gains magic power and faster cooldowns.",
        "ult": "Erupts, dealing 100% AP and stunning nearby enemies."
      }
    }
  },
