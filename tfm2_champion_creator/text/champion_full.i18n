    "description": {
      "archer": {
        "name": "Archer",
        "skill": "Sautez dans la direction indiquée et infligez <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> à l'ennemi attaqué le plus récemment.",
        "skill2": "Tirez une flèche sur un ennemi proche pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<>, <#ef5350ff>étourdir<> brièvement et sauter en arrière.",
        "ult": "Il s'arrête sur place et tire un total de {Count} flèches. La flèche vole vers un ennemi aléatoire dans la portée proche de {Range}, infligeant des <#ff9028ff>dégâts physiques<> égaux à <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> de la puissance d'attaque."
      },
      "bard": {
        "name": "Barde",
        "skill": "Augmente la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque d'un allié de {AttackSpeed}%<> pendant <#ffb900ff>{Duration}s<>.",
        "skill2": "Réduit le temps de recharge des compétences des alliés dans la zone ciblée de <#ffb900ff>{CoolReduce}%<> pendant {Duration}s.",
        "ult": "Canalise pendant <#ffb900ff>{Duration}s<>, augmentant l'<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>attaque de {Attack}<> et la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque de {AttackSpeed}%<> des champions alliés à {Range} de portée, mais l'<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>armure<> et la <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>résistance magique<> deviennent 0."
      },
      "barrier_magician": {
        "name": "Mage de barrière",
        "skill": "Crée une barrière durant <#ffb900ff>{Duration}s<>, accordant aux alliés <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% PM<> de <#e8d44dff>bouclier<> et réduisant la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque ennemie de {AttackSpeedReduce}%<>. À partir du niveau 3, accorde aux alliés une <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque<> bonus et <#ef5350ff>ralentit<> les ennemis.",
        "skill2": "Invoque une barrière durant <#ffb900ff>{Duration}s<> dans la zone ciblée qui détruit tous les projectiles à l'intérieur.",
        "ult": "Crée une barrière qui rétrécit autour d'un champion ennemi. Les ennemis touchant le bord subissent <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et sont <#ef5350ff>étourdis pendant {Time}s<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Entrez en rage pendant {Duration}s, augmentant la vitesse d'attaque de <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> et gagnant <#6aff55ff>{Vamp}% vol de vie<>.",
        "skill2": "Frappez le sol avec les deux mains pour lancer les ennemis dans une zone étroite <#ef5350ff>en l'air pendant {Time}s<> et infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<>.",
        "ult": "{Range} Se précipite vers un ennemi désigné à portée et frappe l'ennemi, lui infligeant des <#ff9028ff>dégâts physiques<> égaux à <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> de la puissance d'attaque. Le temps de recharge est réduit proportionnellement à la <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>santé<> perdue."
      },
      "boomerang_hunter": {
        "name": "Chasseur de boomerang",
        "skill": "Lance un boomerang en ligne, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<>. À portée maximale, il tourne et inflige continuellement <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% AD<> de <#ff9028ff>dégâts physiques<>.",
        "skill2": "Lance trois boomerangs qui reviennent, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> à tous les ennemis sur leur trajectoire.",
        "ult": "Tire un puissant boomerang en ligne droite, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<>. En frappant un champion ennemi, il rebondit vers le champion ennemi le plus proche, augmentant les dégâts de <#ff9028ff>{Increase}%<> par rebond. Rebondit jusqu'à {MaxBounce} fois."
      },
      "chef": {
        "name": "Chef",
        "skill": "Lance un couteau en ligne, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et <#ef5350ff>ralentissant de {Slow}% pendant {SlowTime}s<>.",
        "skill2": "Distribue de la nourriture aux alliés proches, <#6aff55ff>soignant<> de <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PM<>. Soin uniquement sur soi augmente à <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% PM<>.",
        "ult": "Lance une nourriture spéciale à un champion allié. Pendant <#ffb900ff>{Duration}s<>, <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>les PV max augmentent de {HpRatio}%<>. <#e8d44dff>{SpreadRatio}%<> des dégâts subis sont répartis en dégâts dans le temps."
      },
      "clown": {
        "name": "Clown",
        "skill": "Téléporte près d'une cible. Si ennemi, inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> et gagne <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de vitesse de déplacement<> pendant <#ffb900ff>{Duration}s<>.",
        "skill2": "Disperse des dagues autour, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> aux ennemis dans la zone. (Peut bouger pendant l'incantation)",
        "ult": "Entre en frénésie pendant <#ffb900ff>{Time}s<>. Toutes les dagues deviennent des dagues spéciales qui ricochent entre les ennemis."
      },
      "dancer": {
        "name": "Danseuse",
        "skill": "Lance un chakram sur un ennemi, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<>. Chaque chakram ajouté augmente les dégâts de cette compétence de {StackCoef}%.",
        "skill2": "Chaque kill ajoute un chakram aux attaques de base. (Max {MaxCount}, dégâts diminuent de {Reduce}% par chakram supplémentaire)",
        "ult": "Tire {Count}(+stacks) chakrams pénétrants en éventail, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<>. Les chakrams reviennent et infligent <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% AD<> de <#ff9028ff>dégâts physiques<>. (Max {MaxCount})"
      },
      "dark_mage": {
        "name": "Mage noir",
        "skill": "Tire une flèche sombre, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et <#ef5350ff>enracinant pendant {Time}s<>.",
        "skill2": "Couvre une zone de ténèbres après un délai, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> aux ennemis à l'intérieur.",
        "ult": "Maudit un champion ennemi à {Range}, le liant à l'allié le plus proche pendant <#ffb900ff>{Duration}s<>. Quand l'un subit des dégâts, <#a974ffff>{ShareRatio}%<> sont transférés à l'autre."
      },
      "demon": {
        "name": "Démon",
        "skill": "Une griffe infernale surgit du sol pour saisir un ennemi, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> et échangeant les positions.",
        "skill2": "Transformez-vous en un démon plus grand pendant {Time}s. Augmente l'attaque de <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>, l'armure de <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{Defense}<>, la vitesse d'attaque de <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> et la vitesse de déplacement de <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<>.",
        "ult": "Inflige des <#ff9028ff>dégâts physiques<> égaux à <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> de la puissance d'attaque à tous les ennemis à portée de {Range} et applique la <#ef5350ff>peur<> pendant {Time} secondes."
      },
      "dual_blader": {
        "name": "Double lame",
        "skill": "Tirez de l'énergie d'épée en ligne droite pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> aux ennemis touchés et <#ef5350ff>enraciner<> la cible pendant {Time}s.",
        "skill2": "Foncez sur un ennemi <#ef5350ff>immobile<> dans la portée de {Range}, lancez l'ennemi touché <#ef5350ff>en l'air pendant {Time}s<> et infligez <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<>.",
        "ult": "Coupe un ennemi dans la portée désignée de {Range} avec une épée, lui infligeant {Count} fois <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de la puissance d'attaque<> comme <#f5f5f5ff>dégâts fixes<>."
      },
      "executioner": {
        "name": "Exécuteur",
        "skill": "Tirez un crochet pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> à un ennemi touché et le tirer vers vous.",
        "skill2": "Tranchez un ennemi avec un crochet pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> et appliquer <#ef5350ff>saignement pendant {Duration}s<>. Les ennemis qui saignent subissent toutes les {Tick}s <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> et <#ef5350ff>reçoivent {Debuff}% de dégâts supplémentaires<>.",
        "ult": "Balaie les ennemis dans une zone semi-circulaire devant {Range} avec un crochet, leur infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de la puissance d'attaque<> comme <#ff9028ff>dégâts physiques<> et les <#ef5350ff>empêchant de récupérer pendant {Time}s<>."
      },
      "exorcist": {
        "name": "Exorciste",
        "skill": "Annule les <#ef5350ff>effets de statut<> d'un allié et lui <#6aff55ff>rend {Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> <#6aff55ff>PV<>.",
        "skill2": "Accorde une protection divine à un allié pendant <#ffb900ff>{Duration}s<>, augmentant l'<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>attaque de {Attack}<> et la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque de {AttackSpeed}%<>. Pendant l'effet, reflète les effets de contrôle.",
        "ult": "Crée une explosion sur la zone ciblée, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> en <#a974ffff>dégâts magiques<> aux ennemis. Inflige <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% PM<> de dégâts bonus par buff sur la cible."
      },
      "fighter": {
        "name": "Combattant",
        "skill": "Charge sur une cible à {Range} à la vitesse {Speed}, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> et <#ef5350ff>étourdissant pendant {Stun}s<>.",
        "skill2": "Frappe le sol, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> aux ennemis dans {Range} et <#ef5350ff>ralentissant de {Slow}% pendant {SlowTime}s<>.",
        "ult": "Frappe le sol, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> à tous les ennemis dans {Range} et les <#ef5350ff>projetant en l'air pendant {Time}s<>."
