    "description": {
      "archer": {
        "name": "弓箭手",
        "skill": "弓箭手向指定方向跳跃，对最近的敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "skill2": "向附近敌人发射重箭造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，使其短暂<#ef5350ff>眩晕<>并向后跳跃拉开距离。",
        "ult": "停在原地发射共{Count}支箭。箭矢随机飞向附近{Range}范围内的敌人，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。"
      },
      "bard": {
        "name": "吟游诗人",
        "skill": "为一名友方英雄提升<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% <>+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>的<#ceff99ff>攻击速度<>，持续<#ffb900ff>{Duration}秒<>。",
        "skill2": "指定范围内的友方英雄技能冷却时间在{Duration}秒内减少<#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<>。",
        "ult": "在<#ffb900ff>{Duration}秒<>内持续引导，使周围{Range}范围内友方英雄的<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力增加{Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}%法术强度<>)，且友方英雄<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度提升{MagicPower}<>，<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度提升{AttackSpeed}%<>，技能冷却时间减少{CoolReduce}%。但同时，友方英雄<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>护甲降低{DefenceReduce}%<>，<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>魔法抗性降低{MagicResistanceReduce}%<>。"
      },
      "barrier_magician": {
        "name": "结界术师",
        "skill": "在指定区域内创造一个维持<#ffb900ff>{Duration}秒<>的结界，为结界内的友方英雄提供<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}%法术强度<>的<#e8d44dff>护盾<>，并降低敌人<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeedReduce}%攻击速度<>。结界从3级起范围扩大，结界内的队友将获得额外<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度<>，结界内的敌人还会被<#ef5350ff>减速<>。",
        "skill2": "在指定区域创造一个维持<#ffb900ff>{Duration}秒<>的结界，消除进入结界内部的所有投射物。",
        "ult": "在敌方英雄周围设置一个逐渐缩小的圆形结界。触碰结界边缘的敌人将受到<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>并被<#ef5350ff>晕眩{Time}秒<>。"
      },
      "berserker": {
        "name": "狂战士",
        "skill": "进入狂怒状态，持续{Duration}秒，期间<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度上升{AttackSpeed}%<>并获得<#6aff55ff>{Vamp}%吸血<>。",
        "skill2": "持双斧重击地面，将小范围内的敌人<#ef5350ff>击飞{Time}秒<>并造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "ult": "向{Range}距离内指定的敌人冲锋并对其猛击，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。该技能的冷却时间会根据失去的<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>生命值<>成比例减少。"
      },
      "boomerang_hunter": {
        "name": "回旋镖手",
        "skill": "向直线方向投掷回旋镖，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。回旋镖在射程终点旋转一段时间，对触碰到的敌人持续造成<#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "skill2": "向三个方向投掷回旋镖，回旋镖飞到尽头后返回，对路径上所有敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "ult": "向直线方向甩出弹力回旋镖，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。命中敌方英雄时，向最近的另一名敌方英雄方向反弹，每次反弹伤害增加<#ff9028ff>{Increase}%<>。最多反弹{MaxBounce}次。"
      },
      "chef": {
        "name": "厨师",
        "skill": "向直线投掷菜刀，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>，并<#ef5350ff>减速{Slow}%持续{SlowTime}秒<>。",
        "skill2": "向周围队友分发料理，持续回复<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%法强<>的<#6aff55ff>生命值<>。仅自己受治疗时，治疗量增加为<#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}%法强<>。",
        "ult": "向队友英雄投掷特制料理。<#ffb900ff>{Duration}秒<>内<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大生命值增加{HpRatio}%<>。受到伤害的<#e8d44dff>{SpreadRatio}%<>分散为持续伤害。"
      },
      "clown": {
        "name": "小丑",
        "skill": "瞬间移动到目标旁。若为敌人，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击<>的<#ff9028ff>物理伤害<>，并获得<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移动速度<>持续<#ffb900ff>{Duration}秒<>。",
        "skill2": "向周围撒出大量短剑，对范围内敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击<>的<#ff9028ff>物理伤害<>。(施放期间可移动)",
        "ult": "<#ffb900ff>{Time}秒<>内进入狂气状态，所有短剑变为可在敌人间反弹的特殊短剑。"
      },
      "dancer": {
        "name": "舞姬",
        "skill": "向敌人投掷轮刃，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<>的<#ff9028ff>物理伤害<>。每个额外轮刃使此技能伤害提高{StackCoef}%。",
        "skill2": "每次击杀向基本攻击追加飞轮。(最多{MaxCount}个，每追加飞轮命中伤害降低{Reduce}%)",
        "ult": "向扇形发射{Count}(+层数)个穿透飞轮，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击<>的<#ff9028ff>物理伤害<>。飞轮回归时造成<#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}%攻击<>的<#ff9028ff>物理伤害<>。(最多{MaxCount}个)"
      },
      "dark_mage": {
        "name": "黑魔法师",
        "skill": "发射黑暗箭，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>，并<#ef5350ff>束缚{Time}秒<>。",
        "skill2": "延迟后用黑暗覆盖区域，对内部敌人造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法强<>的<#a974ffff>魔法伤害<>。",
        "ult": "诅咒{Range}内的敌方英雄，<#ffb900ff>{Duration}秒<>内将其与最近队友连接。一方受到伤害时，<#a974ffff>{ShareRatio}%<>转移到另一方。"
      },
      "demon": {
        "name": "恶魔",
        "skill": "从地面升起地狱之爪抓住敌人，命中时造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<><#ff9028ff>物理伤害<>并交换敌人和自己的位置。",
        "skill2": "{Time}秒内变身为大恶魔。变身期间<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力增加{Attack}<>、<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>护甲增加{Defense}<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度增加{AttackSpeed}%<>、<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度增加{MoveSpeed}%<>。",
        "ult": "对周围{Range}范围内所有敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<>的<#ff9028ff>物理伤害<>，并施加<#ef5350ff>恐惧{Time}秒<>。"
      },
      "dual_blader": {
        "name": "双刀客",
        "skill": "沿直线发射剑气，对命中的敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<><#ff9028ff>物理伤害<>，并<#ef5350ff>束缚<>目标{Time}秒。",
        "skill2": "向{Range}范围内处于<#ef5350ff>不可移动<>状态的敌人突进，将命中的敌人<#ef5350ff>浮空<>{Time}秒并造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<><#ff9028ff>物理伤害<>。",
        "ult": "用剑切割指定{Range}范围内的敌人，造成{Count}次 <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<>的<#f5f5f5ff>固定伤害<>。"
      },
      "executioner": {
        "name": "处刑人",
