    "description": {
      "archer": {
        "name": "Boogschutter",
        "skill": "Spring in de aangegeven richting en breng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalskracht<> toe als <#ff9028ff>fysieke schade<> aan de meest recent aangevallen vijand.",
        "skill2": "Schiet een pijl op een nabije vijand om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen, kort te <#ef5350ff>verdoven<> en achteruit te springen.",
        "ult": "Hij stopt op zijn plaats en vuurt in totaal {Count} pijlen af. De pijl vliegt naar een willekeurige vijand binnen het nabijgelegen bereik van {Range} en veroorzaakt <#ff9028ff>fysieke schade<> gelijk aan <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van de aanvalskracht."
      },
      "bard": {
        "name": "Bard",
        "skill": "Verhoogt de <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid van een bondgenoot met {AttackSpeed}%<> gedurende <#ffb900ff>{Duration}s<>.",
        "skill2": "Verlaagt de cooldowns van bondgenoten in het doelgebied met <#ffb900ff>{CoolReduce}%<> gedurende {Duration}s.",
        "ult": "Kanaliseert <#ffb900ff>{Duration}s<>, verhoogt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aanval met {Attack}<> en <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeed}%<> van bondgenoten in {Range} bereik, maar <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>pantser<> en <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>magieweerstand<> worden 0."
      },
      "barrier_magician": {
        "name": "Barrière magiër",
        "skill": "Creëert een barrière die <#ffb900ff>{Duration}s<> duurt, geeft bondgenoten <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% MK<> <#e8d44dff>schild<> en verlaagt vijandelijke <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeedReduce}%<>. Vanaf level 3 geeft bondgenoten extra <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid<> en <#ef5350ff>vertraagt<> vijanden.",
        "skill2": "Roept een barrière op in het doelgebied die <#ffb900ff>{Duration}s<> duurt en alle projectielen erbinnen vernietigt.",
        "ult": "Creëert een krimpende barrière rond een vijandelijke kampioen. Vijanden die de rand raken krijgen <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> en worden <#ef5350ff>{Time}s verdoofd<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Word woedend voor {Duration}s, verhoog aanvalssnelheid met <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> en win <#6aff55ff>{Vamp}% levensstel<>.",
        "skill2": "Sla met beide handen op de grond om vijanden in een smal gebied <#ef5350ff>voor {Time}s in de lucht te werpen<> en <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalskracht<> als <#ff9028ff>fysieke schade<> toe te brengen.",
        "ult": "{Range} Snelt naar een gerichte vijand binnen een bereik en treft de vijand, waarbij hij <#ff9028ff>fysieke schade<> toebrengt gelijk aan <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van de aanvalskracht. De afkoeltijd wordt verkort in verhouding tot de verloren <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>gezondheid<>."
      },
      "boomerang_hunter": {
        "name": "Boomerang jager",
        "skill": "Werpt een boemerang in een lijn, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toebrengend. Op maximaal bereik draait hij, brengt continu <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% AD<> <#ff9028ff>fysieke schade<> toe.",
        "skill2": "Werpt drie boemerangs die terugkeren, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan alle vijanden in hun pad.",
        "ult": "Schiet een krachtige boemerang in een rechte lijn, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe. Bij raken van een vijandelijke kampioen kaatst hij naar de dichtstbijzijnde andere vijandelijke kampioen, schade verhoogt met <#ff9028ff>{Increase}%<> per kaats. Kaatst tot {MaxBounce} keer."
      },
      "chef": {
        "name": "Chef",
        "skill": "Werpt een mes in een lijn, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toebrengend en <#ef5350ff>{Slow}% vertraging gedurende {SlowTime}s<> opleggend.",
        "skill2": "Verspreidt eten naar nabije bondgenoten en herstelt continu <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% van de magische kracht<> aan <#6aff55ff>levenspunten<>. Alleen zelfgenezing verhoogt naar <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% MK<>.",
        "ult": "Gooit speciaal eten naar een bondgenoot. Gedurende <#ffb900ff>{Duration}s<> <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>verhoogt max HP met {HpRatio}%<>. <#e8d44dff>{SpreadRatio}%<> van ontvangen schade wordt verspreid als schade over tijd."
      },
      "clown": {
        "name": "Clown",
        "skill": "Teleporteert naast een doel. Bij vijand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en krijgt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% bewegingssnelheid<> gedurende <#ffb900ff>{Duration}s<>.",
        "skill2": "Verspreidt dolken rondom, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan vijanden in het gebied. (Kan bewegen tijdens kanalisatie)",
        "ult": "Gaat in razernij gedurende <#ffb900ff>{Time}s<>. Alle dolken worden speciale dolken die tussen vijanden kaatsen."
      },
      "dancer": {
        "name": "Danseres",
        "skill": "Gooi een chakram naar een vijand en breng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> toe als <#ff9028ff>fysieke schade<>. Elk toegevoegd chakram verhoogt de schade van deze vaardigheid met {StackCoef}%.",
        "skill2": "Elke kill voegt een chakram toe aan basisaanvallen. (Max {MaxCount}, schade verlaagt met {Reduce}% per extra chakram)",
        "ult": "Schiet {Count}(+stacks) doorborende chakrams in een waaier, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe. Chakrams keren terug, brengt <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% AD<> <#ff9028ff>fysieke schade<> toe. (Max {MaxCount})"
      },
      "dark_mage": {
        "name": "Donkere magiër",
        "skill": "Schiet een donkere pijl, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe en <#ef5350ff>vastpint gedurende {Time}s<>.",
        "skill2": "Bedekt een gebied met duisternis na vertraging, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe aan vijanden binnen.",
        "ult": "Vervloekt een vijandelijke kampioen binnen {Range}, verbindt deze met de dichtstbijzijnde bondgenoot gedurende <#ffb900ff>{Duration}s<>. Wanneer een schade krijgt, wordt <#a974ffff>{ShareRatio}%<> overgedragen naar de ander."
      },
      "demon": {
        "name": "Demon",
        "skill": "Een helse klauw rijst uit de grond om een vijand te grijpen, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen en posities te wisselen.",
        "skill2": "Verander in een grotere demon voor {Time}s. Verhoogt aanval met <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>, pantser met <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{Defense}<>, aanvalssnelheid met <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> en bewegingssnelheid met <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<>.",
        "ult": "Brengt <#ff9028ff>fysieke schade<> toe gelijk aan <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van de aanvalskracht aan alle vijanden binnen {Range} bereik en past <#ef5350ff>angst<> toe gedurende {Time} seconden."
      },
      "dual_blader": {
        "name": "Dubbele zwaardenvechter",
        "skill": "Schiet zwaardenergie in een rechte lijn om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen aan geraakte vijanden en het doelwit voor {Time}s te <#ef5350ff>wortelen<>.",
        "skill2": "Storm op een <#ef5350ff>immobiele<> vijand in {Range} bereik af, werp de geraakte vijand <#ef5350ff>voor {Time}s in de lucht<> en breng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe.",
        "ult": "Snijdt een vijand binnen het aangewezen bereik van {Range} af met een zwaard, waarbij {Count} maal <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#f5f5f5ff>vaste schade<> wordt toegebracht."
      },
      "executioner": {
        "name": "Beul",
        "skill": "Schiet een haak om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen aan een geraakte vijand en hem naar je toe te trekken.",
        "skill2": "Snij een vijand met een haak om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen en <#ef5350ff>{Duration}s te laten bloeden<>. Bloedende vijanden lijden elke {Tick}s <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> en <#ef5350ff>ontvangen {Debuff}% meer schade<>.",
        "ult": "Veegt vijanden in een halfrond gebied vóór {Range} met een haak, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#ff9028ff>fysieke schade<> toe en <#ef5350ff>blokkeert hun herstel voor {Time}s<>."
      },
      "exorcist": {
        "name": "Exorcist",
        "skill": "Neutraliseert <#ef5350ff>statuseffecten<> van één bondgenoot en <#6aff55ff>herstelt {Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidskracht<> aan <#6aff55ff>gezondheid<>.",
        "skill2": "Geeft een bondgenoot goddelijke bescherming gedurende <#ffb900ff>{Duration}s<>, verhoogt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aanval met {Attack}<> en <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeed}%<>. Reflecteert controle-effecten terug terwijl actief.",
        "ult": "Creëert een explosie in het doelgebied, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#a974ffff>magische schade<> toe aan vijanden. Brengt <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% MK<> bonusschade per buff op het doel toe."
      },
      "fighter": {
        "name": "Vechter",
        "skill": "Stormt naar een doel binnen {Range} met {Speed} snelheid, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en <#ef5350ff>verdooft gedurende {Stun}s<>.",
        "skill2": "Slaat de grond, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan vijanden binnen {Range} en <#ef5350ff>vertraagt {Slow}% gedurende {SlowTime}s<>.",
        "ult": "Slaat de grond, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden binnen {Range} en <#ef5350ff>lanceert ze {Time}s in de lucht<>."
      },
      "gambler": {
        "name": "Gokker",
        "skill": "Rol een dobbelsteen en val vijanden in {Range} bereik een aantal keren aan gelijk aan het resultaat. Elke aanval brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe.",
        "skill2": "Gooi een chip om een gebied te creëren binnen {Range} bereik dat vijanden <#ef5350ff>{Slow}% vertraagt<> voor {Time}s in een {AttackRange} gebied. Het gebied explodeert bij afloop en brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe aan vijanden erin.",
        "ult": "Vuurt een stapel geld af die vijanden in een rechte lijn charmeert. De getroffen vijand loopt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#ff9028ff>fysieke schade<> op en wordt <#ef5350ff>{Time} seconden gecharmeerd<>."
      },
      "ghost": {
        "name": "Geest",
        "skill": "Wordt onricht­baar en stormt in een lijn. Bij kill/assist krijgt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} aanval<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% aanvalssnelheid<> en <#6aff55ff>herstelt {Heal} HP<>.",
        "skill2": "Stormt korte afstand en brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan eerste vijand geraakt. Kan tot {Time} keer achtereen worden gebruikt.",
        "ult": "Wordt immuun voor controle-effecten gedurende <#ffb900ff>{Time}s<>. Doden of assisten reset cooldown van basisvaardigheid."
      },
      "gunner": {
        "name": "Schutter",
        "skill": "Kan vijanden aanvallen tijdens bewegen. Vanaf level 3 verhoogt elke aanval bewegingssnelheid met <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Value}%<> voor {Time}s.",
        "skill2": "Versterk aanvallen voor {Time}s, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aanvalskracht stijgt met {Attack}<>. Elke 3e aanval <#ef5350ff>vertraagt de vijand met {Slow}% voor {SlowTime}s<>.",
        "ult": "De aanval wordt gedurende {Time} seconden versterkt, de aanvalskracht neemt toe met <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<> en er worden extra kogels afgevuurd op 2 vijanden rond het aanvalsdoel. Extra kogels veroorzaken <#ff9028ff>fysieke schade<> gelijk aan <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van de aanvalskracht."
      },
      "ice_mage": {
        "name": "Ijsmagiër",
        "skill": "Bevries een vijand om <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> als <#a974ffff>magische schade<> toe te brengen en te <#ef5350ff>verdoven voor {Time}s<>.",
        "skill2": "Roep een ijsveld op voor {Duration}s dat vijanden in {Range} met <#ef5350ff>{MoveSpeed}% loopsnelheid vertraagt<> en elke {Tick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> als <#a974ffff>magische schade<> toebrengt. Bevriest en <#ef5350ff>verdooft voor {Stun}s<> aan het eind.",
        "ult": "Brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#a974ffff>magische schade<> toe aan vijanden in een frontaal kegel en duwt ze terug. <#ef5350ff>Vertraagt {Slow}% gedurende {SlowDuration}s<> en <#ef5350ff>blokkeert bewegingsvaardigheden gedurende {BlockDuration}s<>."
      },
      "illusionist": {
        "name": "Illusionist",
        "skill": "Schiet een projectiel, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe en roept een illusie op die <#ef5350ff>{Time}s tergt<>.",
        "skill2": "Brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe aan vijanden binnen {Range} en <#ef5350ff>angst voor {Time}s<>.",
        "ult": "Creëert een illusie van een nabije bondgenoot die <#ffb900ff>{Duration}s<> duurt. De illusie kan alleen basisaanvallen uitvoeren en heeft dezelfde stats als de gekopieerde kampioen."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Roept een kleine jiangshi op die naar een vijand stormt en 3 keer aanvalt voordat hij verdwijnt, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe per slag.",
        "skill2": "Slaat een vijand om <#ef5350ff>{Time}s te verdoven<>, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en <#6aff55ff>herstelt {Heal} HP<>.",
        "ult": "Gedurende <#ffb900ff>{Duration}s<>, dranen <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% MK<> <#6aff55ff>HP<> van vijanden binnen {Range} en brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% MK<> <#a974ffff>magische schade<> toe."
      },
      "knight": {
        "name": "Ridder",
        "skill": "Daagt een doel <#ef5350ff>gedurende {Time}s uit<>.",
        "skill2": "Geeft jezelf {Time}s lang een <#e8d44dff>schild<> (<#e8d44dff>schild<>waarde: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% van maximale gezondheid<> + <#e8d44dff>{Amount}<>). Weerkaatst <#ff9028ff>{Reflect}%<> van de ontvangen schade zolang het schild actief is.",
        "ult": "Roept op de gekozen locatie een verdedigingszone met {Range} bereik op voor <#ffb900ff>{Time}s<>. Bondgenoten binnen de zone krijgen <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% van maximale gezondheid<> minder schade."
