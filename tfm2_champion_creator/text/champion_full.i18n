        "skill": "Stormt korte afstand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan eerste vijand geraakt en past <#ef5350ff>bloeden<> toe.",
        "skill2": "Snijdt doelvijand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe. Reset cooldown van Vaardigheid 1 indien <#ef5350ff>bloedend<>.",
        "ult": "Stormt naar vijandelijke kampioen, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden in gebied bij aankomst. Vijanden onder {Threshold}% max HP na schade worden geëxecuteerd. Bij executie worden nabije vijanden <#ef5350ff>{FearTime}s bang<>."
      },
      "pole_warrior": {
        "name": "Pool strijder",
        "skill": "Spring op een vijand en sla met de pool om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen.",
        "skill2": "Beweeg een korte afstand, sta op de pool om ondoelbaar te worden voor {Time}s, zwaai dan om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalskracht<> als <#ff9028ff>fysieke schade<> toe te brengen aan alle vijanden in {Range}.",
        "ult": "Valt aan op een aangewezen vijand binnen {Range} bereik, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#ff9028ff>fysieke schade<> toe aan de vijand en <#ef5350ff>tilt het doelwit gedurende {Time}s de lucht in<>."
      },
      "spirit_caller": {
        "name": "Geest oproeper",
        "skill": "Plakt een geest aan een bondgenoot <#ffb900ff>{Duration}s<>, <#6aff55ff>herstelt levenspunten<> met <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% MK<> en verhoogt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {SpeedUp}%<>.",
        "skill2": "Hecht {Duration}s lang een geest aan een vijand, verlaagt <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>pantser met {DefDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefCoef}% van vaardigheidskracht<>, <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>magieweerstand met {MrDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MrCoef}% van vaardigheidskracht<> en <#ef5350ff>vertraagt met {Slow}%<>.",
        "ult": "Detoneert geplakte geesten. Bondgenote geesten geven <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% MK<> <#e8d44dff>schild<> en <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% aanvalssnelheid<>. Vijandelijke geesten brengen <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% van magische kracht<> als <#a974ffff>magische schade<> toe en <#ef5350ff>verdoven {StunTime}s<>."
      },
      "whip_master": {
        "name": "Zweep meester",
        "skill": "Zwaait zweep, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% doel HP<> toe.",
        "skill2": "Zwaait zweep in kegel, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en duwt vijanden terug.",
        "ult": "Kanaliseert <#ffb900ff>{Duration}s<>, schiet doorborende projectielen die <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toebrengen."
      },
      "enchanter": {
        "name": "Betoveraar",
        "skill": "Verstrekt bondgenoot <#ffb900ff>{Duration}s<>, verhoogt <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>bereik met {Increase}<>.",
        "skill2": "Verstrekt bondgenote uitrusting <#ffb900ff>{Duration}s<>, verhoogt voorwerpsstats met <#ffb900ff>{Percent}%<>.",
        "ult": "Versterkt bondgenoot {Duration}s, geeft <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aanval {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% MK<>), <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid {AttackSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid {MoveSpeed}%<> en immuniteit voor controle-effecten."
      },
      "siege_breaker": {
        "name": "Belegering breker",
        "skill": "Slaat ploerendorser, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe. Brengt {Bonus}% bonus schade toe aan structuren.",
        "skill2": "Slaat de grond, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan alle vijanden inclusief structuren.",
        "ult": "Gedurende {Time}s, verhoogt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aanval met {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeed}%<> en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {MoveSpeed}%<>."
      },
      "prisoner": {
        "name": "Gevangene",
        "skill": "Werpt ijzeren bal in lijn, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan alle vijanden in gebied.",
        "skill2": "Brult om {Time}s lang een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% van maximale gezondheid<> te krijgen en alle nabije vijanden te <#ef5350ff>provoceren<>.",
        "ult": "Stormt naar vijand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden nabij landingspunt en <#ef5350ff>verdooft {Time}s<>."
      },
      "android": {
        "name": "Android",
        "skill": "Schiet een schokgolf in rechte lijn. De schokgolf explodeert in een cirkel bij vijandtreffer of bereikseinde en brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en <#ef5350ff>vertraagt vijanden met {Slow}% voor {Time}s<>.",
        "skill2": "Geeft zichzelf {Time}s lang een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% van maximale gezondheid<>. Wanneer het schild verdwijnt, worden vijanden binnen {Range} bereik <#ef5350ff>{StunTime}s verdoofd<>.",
        "ult": "Geeft een gekozen bondgenoot binnen {Range} bereik een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% van maximale gezondheid<> en teleporteert na {Time}s naar die bondgenoot."
      },
      "white_mage": {
        "name": "Witte magiër",
        "skill": "Een straal explodeert na vertraging, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe aan alle vijanden.",
        "skill2": "Roept stralen op om 5 keer aan te vallen, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe en <#ef5350ff>vertraagt {Slow}% gedurende {SlowTime}s<>.",
        "ult": "Schiet doorborende straal, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#a974ffff>magische schade<> toe aan geraakte vijanden en <#ef5350ff>vastpint {Time}s<>."
      },
      "wind_mage": {
        "name": "Windmagiër",
        "skill": "Roept wervelwind op <#ffb900ff>{Duration}s<>, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe elke {Tick}s binnen {Range}. Bondgenoten erin krijgen <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% bewegingssnelheid<>.",
        "skill2": "Schiet vijf wervelwinden naar voren, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe.",
        "ult": "Lanceert massieve tornado. Geraakte vijanden krijgen <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> en zijn <#ef5350ff>{AirborneTime}s in de lucht<>. Grootte, schade en luchttijd verlagen per slag. Stuurt door naar andere kampioenen."
      },
      "bomber": {
        "name": "Bomber",
        "skill": "Werpt een bom, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan alle vijanden in gebied.",
        "skill2": "Plaatst onzichtbare mijn die <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toebrengt en <#ef5350ff>{Time}s vastpint<> wanneer erop gestapt. Wordt niet getriggerd door minions.",
        "ult": "Werpt grote bom op doelgebied, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden en <#ef5350ff>vertraagt {Slow}% gedurende {SlowTime}s<>."
      },
      "cavalry_knight": {
        "name": "Cavalerie ridder",
        "skill": "Storm in een rechte lijn om de eerste geraakte vijand te <#ef5350ff>wortelen voor {Time}s<> en <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe te brengen. Storm snelheid schaalt met bewegingssnelheid.",
        "skill2": "Verhoogt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {Speed}%<> voor {Time}s en versterkt het wapen tot een vuurlans, waardoor aanvallen {BurnTime}s lang extra <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% van aanvalsschade<> brandschade toebrengen.",
        "ult": "Verhoogt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% van aanvalsschade<> voor {Time}s en creëert een zone die naar je positie leidt. Bondgenoten op de zone krijgen <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% van aanvalsschade<> bewegingssnelheid wanneer ze richting de cavalerie bewegen."
      },
      "druid": {
        "name": "Druïde",
        "skill": "Roept een beer op. Als deze sterft, krijgt de druïde <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% MK<> schade. Tijdens opgeroepen casten <#6aff55ff>geneest<> beer met <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% MK<>.",
        "skill2": "Roept een adelaar op. Als de adelaar sterft, krijgt de druïde schade. Als deze vaardigheid wordt gebruikt terwijl de adelaar is opgeroepen, stormt de adelaar op een vijand af, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidskracht<> toe als <#a974ffff>magische schade<> en <#6aff55ff>geneest voor {Lifesteal}% van de toegebrachte schade<>.",
        "ult": "Vuurt {Count} beren- en adelaarszielen achter elkaar in de gekozen richting. Elk projectiel brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidskracht<> toe als <#a974ffff>magische schade<> en duwt vijanden terug."
      },
      "voodoo_shaman": {
        "name": "Voodoo sjamaan",
        "skill": "Schiet vloek-projectiel, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe, <#ef5350ff>vertraagt {Slow}% gedurende {Time}s<> en verlaagt <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AtkSpd}%<> gedurende <#ffb900ff>{AtkSpdTime}s<>.",
        "skill2": "Vervloekt vijand <#ffb900ff>{Time}s<>, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe. Brengt <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% MK<> bonus schade toe per ontvangen slag (max {Max}).",
        "ult": "Creëert voodoo-zone <#ffb900ff>{Duration}s<>. Vijanden binnen krijgen periodiek <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% max HP<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> en zijn <#ef5350ff>gestil<>."
      },
      "hitman": {
        "name": "Hitman",
        "skill": "Schiet drieschots-burst. De eerste schot brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en <#ef5350ff>verdoofd {StunTime}s<>.",
        "skill2": "Teleporteert achter de meest recent aangevallen vijandelijke kampioen binnen {Range} bereik.",
        "ult": "Markeert een vijandelijke kampioen. Na <#ffb900ff>{Duration}s<> wordt <#ff9028ff>{Damage} + {Coef}% van de tijdens de markering ontvangen schade<> toegebracht als <#ff9028ff>fysieke schade<>. Bij een kill krijg je <#ffb900ff>{InvisibleDuration}s<> stealth."
      },
      "guardian_spirit": {
        "name": "Geestbeschermer",
        "skill": "<#6aff55ff>Herstelt levenspunten<> van nabije bondgenoten met <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<>.",
        "skill2": "Geeft bondgenoot <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% MK<> <#e8d44dff>schild<> en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% bewegingssnelheid<>.",
        "ult": "Creëert heiligdom <#ffb900ff>{Duration}s<>, <#6aff55ff>herstelt periodiek levenspunten<> van bondgenoten met <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% MK<> en geeft revive schild."
      },
      "hunter": {
        "name": "Jager",
        "skill": "Teleporteert naar een vijand en schakelt naar afstandsmodus. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Bereik verhoogt met {RangeIncrease}<>.",
        "skill2": "Stormt naar 3-stack gemarkeerde vijand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en <#ef5350ff>stilt {SilenceTime}s<>.",
        "ult": "Stormt naar voren, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan vijanden in pad. Kan opnieuw worden gecast bij kill of assist."
      },
      "circus_blade": {
        "name": "Circusmes",
        "skill": "Schiet mes in doelrichting, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en <#ef5350ff>vertraagt {Slow}% gedurende {SlowTime}s<>. Slaat tot <#ffb900ff>{ChargeCount}<> ladingen op. Krijgt <#ffb900ff>1<> lading bij basisaanval op vijandelijke kampioenen.",
        "skill2": "Krijgt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% bewegingssnelheid<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% aanvalssnelheid<> en muurfasing gedurende <#ffb900ff>{Duration}s<>.",
        "ult": "Stormt naar doelvijand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe. Brengt <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% AD<> splash schade toe en <#ef5350ff>duwt nabije vijanden terug<>, dan verdwijnt."
      },
      "tfm2_cc_emberling": {
        "name": "Emberling",
        "skill": "Fires a piercing ember bolt dealing 80% AP.",
        "skill2": "Focuses flame: gains magic power and faster cooldowns.",
        "ult": "Erupts, dealing 100% AP and stunning nearby enemies."
      }
