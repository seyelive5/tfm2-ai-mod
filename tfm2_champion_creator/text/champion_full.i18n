    "description": {
      "archer": {
        "name": "Arquero",
        "skill": "Salta en la dirección indicada e inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> al enemigo atacado más recientemente.",
        "skill2": "Dispara una flecha a un enemigo cercano para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>, <#ef5350ff>aturdir<> brevemente y saltar hacia atrás.",
        "ult": "Se detiene en su lugar y dispara un total de {Count} flechas. La flecha vuela hacia un enemigo aleatorio dentro del rango cercano de {Range}, infligiendo <#ff9028ff>daño físico<> equivalente a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del poder de ataque."
      },
      "bard": {
        "name": "Bardo",
        "skill": "Aumenta la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque de un aliado un {AttackSpeed}%<> durante <#ffb900ff>{Duration}s<>.",
        "skill2": "Reduce el tiempo de reutilización de habilidades de aliados en el área designada en <#ffb900ff>{CoolReduce}%<> durante {Duration}s.",
        "ult": "Canaliza durante <#ffb900ff>{Duration}s<>, aumentando el <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>ataque en {Attack}<> y la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque en {AttackSpeed}%<> de los campeones aliados en {Range} de alcance, pero la <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>armadura<> y la <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>resistencia mágica<> se vuelven 0."
      },
      "barrier_magician": {
        "name": "Mago de barrera",
        "skill": "Crea una barrera que dura <#ffb900ff>{Duration}s<>, otorgando a los aliados <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% PH<> de <#e8d44dff>escudo<> y reduciendo la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque enemiga en {AttackSpeedReduce}%<>. Desde el nivel 3, otorga a los aliados <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque<> adicional y <#ef5350ff>ralentiza<> a los enemigos.",
        "skill2": "Invoca una barrera que dura <#ffb900ff>{Duration}s<> en el área designada que destruye todos los proyectiles dentro.",
        "ult": "Crea una barrera que se reduce alrededor de un campeón enemigo. Los enemigos que toquen el borde reciben <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y son <#ef5350ff>aturdidos durante {Time}s<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Entra en furia por {Duration}s, aumentando la velocidad de ataque en <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> y ganando <#6aff55ff>{Vamp}% robo de vida<>.",
        "skill2": "Golpea el suelo con ambas manos para lanzar enemigos en un área estrecha <#ef5350ff>al aire por {Time}s<> e infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>.",
        "ult": "{Range} Corre hacia un enemigo designado dentro de un rango y lo golpea, infligiéndole <#ff9028ff>daño físico<> equivalente a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del poder de ataque. El tiempo de recuperación se reduce en proporción a la <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>salud<> perdida."
      },
      "boomerang_hunter": {
        "name": "Cazador de bumerán",
        "skill": "Lanza un bumerán en línea, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<>. Al alcance máximo gira, causando continuamente <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% AD<> de <#ff9028ff>daño físico<>.",
        "skill2": "Lanza tres bumeranes que regresan, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> a todos los enemigos en su trayectoria.",
        "ult": "Dispara un poderoso bumerán en línea recta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>. Al impactar a un campeón enemigo, rebota hacia el campeón enemigo más cercano, aumentando el daño en <#ff9028ff>{Increase}%<> por rebote. Rebota hasta {MaxBounce} veces."
      },
      "chef": {
        "name": "Chef",
        "skill": "Lanza un cuchillo en línea, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>.",
        "skill2": "Distribuye comida a aliados cercanos para <#6aff55ff>restaurar vida<> continuamente por <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PH<>. La curación solo a sí mismo aumenta a <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% PH<>.",
        "ult": "Lanza comida especial a un campeón aliado. Durante <#ffb900ff>{Duration}s<>, <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>la vida máxima aumenta un {HpRatio}%<>. <#e8d44dff>{SpreadRatio}%<> del daño recibido se distribuye como daño con el tiempo."
      },
      "clown": {
        "name": "Payaso",
        "skill": "Teletransporta junto a un objetivo. Si es enemigo, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y obtiene <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidad de movimiento<> durante <#ffb900ff>{Duration}s<>.",
        "skill2": "Esparce dagas alrededor, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> a enemigos en el área. (Puede moverse mientras lanza)",
        "ult": "Entra en frenesí durante <#ffb900ff>{Time}s<>. Todas las dagas se convierten en dagas especiales que rebotan entre enemigos."
      },
      "dancer": {
        "name": "Bailarina",
        "skill": "Lanza un chakram a un enemigo, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>. Cada chakram añadido aumenta el daño de esta habilidad un {StackCoef}%.",
        "skill2": "Cada eliminación añade un chakram a los ataques básicos. (Máx {MaxCount}, el daño se reduce un {Reduce}% por chakram extra)",
        "ult": "Dispara {Count}(+acumulación) chakrams penetrantes en abanico, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<>. Los chakrams regresan, causando <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% AD<> de <#ff9028ff>daño físico<>. (Máx {MaxCount})"
      },
      "dark_mage": {
        "name": "Mago oscuro",
        "skill": "Dispara una flecha oscura, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y <#ef5350ff>enraizando durante {Time}s<>.",
        "skill2": "Cubre un área con oscuridad tras un retraso, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> a los enemigos dentro.",
        "ult": "Maldice a un campeón enemigo en {Range}, vinculándolo con el aliado más cercano durante <#ffb900ff>{Duration}s<>. Cuando uno recibe daño, <#a974ffff>{ShareRatio}%<> se transfiere al otro."
      },
      "demon": {
        "name": "Demonio",
        "skill": "Una garra infernal surge del suelo para agarrar a un enemigo, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> y cambiando posiciones.",
        "skill2": "Transfórmate en un demonio mayor por {Time}s. Aumenta ataque en <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>, armadura en <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{Defense}<>, velocidad de ataque en <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> y velocidad de movimiento en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<>.",
        "ult": "Inflige <#ff9028ff>daño físico<> equivalente a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del poder de ataque a todos los enemigos dentro del rango {Range} y aplica <#ef5350ff>miedo<> durante {Time} segundos."
      },
      "dual_blader": {
        "name": "Doble espada",
        "skill": "Dispara energía de espada en línea recta para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> a enemigos golpeados y <#ef5350ff>enraizar<> al objetivo por {Time}s.",
        "skill2": "Carga contra un enemigo <#ef5350ff>inmóvil<> dentro de {Range}, lanza al enemigo golpeado <#ef5350ff>al aire por {Time}s<> e inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>.",
        "ult": "Corta a un enemigo dentro del rango designado {Range} con una espada, infligiendo {Count} veces <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#f5f5f5ff>daño fijo<>."
      },
      "executioner": {
        "name": "Ejecutor",
        "skill": "Dispara un gancho para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> a un enemigo golpeado y tirarlo hacia ti.",
        "skill2": "Corta un enemigo con un gancho para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> y aplicar <#ef5350ff>sangrado por {Duration}s<>. Enemigos sangrando sufren cada {Tick}s <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}%<> del daño de ataque como <#ff9028ff>daño físico<> y <#ef5350ff>reciben {Debuff}% más daño<>.",
        "ult": "Barre a los enemigos en un área semicircular frente a {Range} con un gancho, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>dejándolos incapaces de curarse durante {Time}s<>."
      },
      "exorcist": {
        "name": "Exorcista",
        "skill": "Anula los <#ef5350ff>efectos de estado<> de un aliado y <#6aff55ff>restaura {Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> de <#6aff55ff>salud<>.",
        "skill2": "Otorga protección divina a un aliado durante <#ffb900ff>{Duration}s<>, aumentando el <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>ataque en {Attack}<> y la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque en {AttackSpeed}%<>. Mientras esté activo, refleja efectos de control de masas.",
        "ult": "Crea una explosión en el área objetivo, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> a enemigos. Causa <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% PH<> de daño bonus por cada buff en el objetivo."
      },
      "fighter": {
        "name": "Luchador",
        "skill": "Embiste a un objetivo en {Range} a {Speed} de velocidad, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y <#ef5350ff>aturdiendo durante {Stun}s<>.",
        "skill2": "Golpea el suelo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> a enemigos en {Range} y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>.",
        "ult": "Golpea el suelo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos en {Range} y <#ef5350ff>lanzándolos al aire durante {Time}s<>."
      },
      "gambler": {
        "name": "Jugador",
        "skill": "Tira un dado y ataca enemigos dentro de {Range} un número de veces igual al resultado. Cada ataque inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>.",
        "skill2": "Lanza una ficha para crear un área dentro de {Range} que <#ef5350ff>ralentiza enemigos en {Slow}%<> por {Time}s en un área de {AttackRange}. El área explota al expirar, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> a enemigos dentro.",
        "ult": "Dispara una pila de dinero que encanta a los enemigos en línea recta. El enemigo golpeado recibe <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> y queda <#ef5350ff>encantado durante {Time}s<>."
      },
      "ghost": {
        "name": "Fantasma",
        "skill": "Se vuelve no objetivo y se desplaza en línea. Al matar/asistir, gana <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} de ataque<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de velocidad de ataque<> y <#6aff55ff>restaura {Heal} de vida<>.",
        "skill2": "Se desplaza una distancia corta y causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> al primer enemigo golpeado. Puede usarse hasta {Time} veces seguidas.",
        "ult": "Se vuelve inmune al control de masas durante <#ffb900ff>{Time}s<>. Matar o asistir reinicia el cooldown de la habilidad básica."
      },
      "gunner": {
        "name": "Tirador",
        "skill": "Puede atacar enemigos mientras se mueve. Desde nivel 3, cada ataque aumenta velocidad de movimiento en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Value}%<> por {Time}s.",
        "skill2": "Mejora los ataques por {Time}s, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aumentando el poder de ataque en {Attack}<>. Cada 3er ataque aplica <#ef5350ff>{Slow}% de ralentización por {SlowTime}s<>.",
        "ult": "El ataque se fortalece durante {Time} segundos, el poder de ataque aumenta en <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<> y se disparan balas adicionales a 2 enemigos alrededor del objetivo del ataque. Las balas adicionales infligen <#ff9028ff>daño físico<> equivalente a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del poder de ataque."
      },
      "ice_mage": {
        "name": "Mago de hielo",
        "skill": "Congela un enemigo para infligir <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> y <#ef5350ff>aturdir por {Time}s<>.",
        "skill2": "Invoca un campo de hielo por {Duration}s que <#ef5350ff>ralentiza la velocidad de movimiento de enemigos en {Range} en {MoveSpeed}%<> e inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> cada {Tick}s. Congela y <#ef5350ff>aturde por {Stun}s<> al final.",
        "ult": "Causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> a enemigos en cono frontal y los empuja. <#ef5350ff>Ralentiza un {Slow}% durante {SlowDuration}s<> y <#ef5350ff>bloquea habilidades de movimiento durante {BlockDuration}s<>."
      },
      "illusionist": {
        "name": "Ilusionista",
        "skill": "Dispara un proyectil, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> e invocando una ilusión que <#ef5350ff>provoca durante {Time}s<>.",
        "skill2": "Causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> a enemigos en {Range} y los <#ef5350ff>aterroriza durante {Time}s<>.",
        "ult": "Crea una ilusión de un campeón aliado cercano que dura <#ffb900ff>{Duration}s<>. La ilusión solo realiza ataques básicos y tiene los mismos atributos que el campeón copiado."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Invoca un pequeño jiangshi que embiste a un enemigo y ataca 3 veces antes de desaparecer, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> por golpe.",
        "skill2": "Golpea a un enemigo para <#ef5350ff>aturdir durante {Time}s<>, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>, y <#6aff55ff>restaura {Heal} de vida<>.",
        "ult": "Durante <#ffb900ff>{Duration}s<>, drena <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PH<> de <#6aff55ff>vida<> a enemigos en {Range} y causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% PH<> de <#a974ffff>daño mágico<>."
      },
      "knight": {
        "name": "Caballero",
        "skill": "Designa un objetivo y le aplica <#ef5350ff>provocación durante {Time}s<>.",
        "skill2": "Otorga a sí mismo un <#e8d44dff>escudo<> durante {Time}s (valor del <#e8d44dff>escudo<>: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% de la salud máxima<> + <#e8d44dff>{Amount}<>). Refleja <#ff9028ff>{Reflect}%<> del daño recibido mientras el escudo está activo.",
        "ult": "Invoca en la ubicación seleccionada una zona defensiva de alcance {Range} durante <#ffb900ff>{Time}s<>. Los aliados dentro reciben <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% de la salud máxima<> menos daño."
      },
      "lancer": {
        "name": "Lancero",
        "skill": "Empuja enemigos en {Range} hacia atrás e inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>.",
        "skill2": "Carga una corta distancia para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Value}% del daño de ataque<> como <#ff9028ff>daño físico<> y moverte detrás del enemigo.",
        "ult": "Carga {Range} de distancia, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos encontrados mientras carga y <#ef5350ff>los lanza al aire por {Time}s<>."
      },
      "lightning_mage": {
        "name": "Mago de rayo",
        "skill": "Dispara un rayo a un objetivo, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<>. Salta a enemigos cercanos sin duplicar objetivos.",
        "skill2": "Cae un rayo en un área, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y <#ef5350ff>aturdiendo durante {Time}s<>.",
        "ult": "Canaliza un rayo a un campeón enemigo durante <#ffb900ff>{Duration}s<>, <#ef5350ff>aturdiéndolo<>. Causa continuamente <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> al objetivo y enemigos cercanos."
      },
      "magic_knight": {
