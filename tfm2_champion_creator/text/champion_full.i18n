    "description": {
      "archer": {
        "name": "Archer",
        "skill": "Leap in the targeted direction and deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> to the most recently attacked enemy.",
        "skill2": "Fire an arrow at a nearby enemy to deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<>, briefly <#ef5350ff>stun<> them, and jump back.",
        "ult": "Stop in place and fire a total of {Count} arrows. Each arrow flies toward a random enemy within {Range} range, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<>."
      },
      "bard": {
        "name": "Bard",
        "skill": "Increase one ally's <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>attack speed by {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% AP<> for <#ffb900ff>{Duration}s<>.",
        "skill2": "Reduce the skill cooldowns of allies within the targeted area by <#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% AP<> for {Duration}s.",
        "ult": "Channel for <#ffb900ff>{Duration}s<>, increasing nearby allied champions' <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>attack by {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% AP<>), <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>AP by {MagicPower}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>attack speed by {AttackSpeed}%<>, and reducing skill cooldowns by {CoolReduce}% in {Range} range, but reducing <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>armor by {DefenceReduce}%<> and <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>magic resist by {MagicResistanceReduce}%<>."
      },
      "barrier_magician": {
        "name": "Barrier Mage",
        "skill": "Create a barrier lasting <#ffb900ff>{Duration}s<>, granting allies <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% AP<> <#e8d44dff>shield<> and reducing enemies' <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>attack speed by {AttackSpeedReduce}%<>. From level 3, grants allies bonus <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>attack speed<> and <#ef5350ff>slows<> enemies.",
        "skill2": "Summon a barrier lasting <#ffb900ff>{Duration}s<> in the targeted area that destroys all projectiles inside.",
        "ult": "Create a shrinking barrier around an enemy champion. Enemies touching the edge take <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% AP<> <#a974ffff>magic damage<> and are <#ef5350ff>stunned for {Time}s<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Enter rage for {Duration}s, increasing <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>attack speed by {AttackSpeed}%<> and gaining <#6aff55ff>{Vamp}% life steal<>.",
        "skill2": "Slam the ground with both hands to launch enemies in a narrow area <#ef5350ff>airborne for {Time}s<> and deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<>.",
        "ult": "Rush toward an enemy within {Range} range and strike them, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<>. Cooldown is reduced in proportion to lost <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>health<>."
      },
      "boomerang_hunter": {
        "name": "Boomerang Hunter",
        "skill": "Throw a boomerang in a line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<>. At max range it spins, continuously dealing <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% AD<> <#ff9028ff>physical damage<>.",
        "skill2": "Throw three boomerangs that return, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> to all enemies in their path.",
        "ult": "Fire a powerful boomerang in a straight line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<>. On hitting an enemy champion, it bounces toward the nearest other enemy champion, increasing damage by <#ff9028ff>{Increase}%<> per bounce. Bounces up to {MaxBounce} times."
      },
      "chef": {
        "name": "Chef",
        "skill": "Throw a knife in a line, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% AP<> <#a974ffff>magic damage<> and <#ef5350ff>slowing by {Slow}% for {SlowTime}s<>.",
        "skill2": "Distribute food to nearby allies, <#6aff55ff>restoring health<> for <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% AP<>. Self-only heal increases to <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% AP<>.",
        "ult": "Throw special food to an ally champion. For <#ffb900ff>{Duration}s<>, <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>max HP increases by {HpRatio}%<>. <#e8d44dff>{SpreadRatio}%<> of damage taken is spread as damage over time."
      },
      "clown": {
        "name": "Clown",
        "skill": "Teleport next to a target. If enemy, deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> and gain <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% movement speed<> for <#ffb900ff>{Duration}s<>.",
        "skill2": "Scatter daggers around, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> to enemies in the area. (Can move while casting)",
        "ult": "Enter a frenzy for <#ffb900ff>{Time}s<>. All daggers become special bouncing daggers that ricochet between enemies."
      },
      "dancer": {
        "name": "Dancer",
        "skill": "Throw a chakram at an enemy to deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<>. Each added chakram increases this skill damage by {StackCoef}%.",
        "skill2": "Each kill adds a chakram to basic attacks. (Max {MaxCount}, damage reduces by {Reduce}% per extra chakram hit)",
        "ult": "Fire {Count}(+stacks) penetrating chakrams in a fan, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<>. Chakrams return, dealing <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% AD<> <#ff9028ff>physical damage<>. (Max {MaxCount})"
      },
      "dark_mage": {
        "name": "Dark Mage",
        "skill": "Fire a dark arrow, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% AP<> <#a974ffff>magic damage<> and <#ef5350ff>rooting for {Time}s<>.",
        "skill2": "Cover an area in darkness after a delay, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% AP<> <#a974ffff>magic damage<> to enemies inside.",
        "ult": "Curse an enemy champion within {Range}, linking them to the nearest ally for <#ffb900ff>{Duration}s<>. When one takes damage, <#a974ffff>{ShareRatio}%<> is transferred to the other."
      },
      "demon": {
        "name": "Demon",
        "skill": "A hellish claw rises from the ground to grab an enemy, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> and swapping positions.",
        "skill2": "Transform into a greater demon for {Time}s. Increases <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>attack by {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>armor by {Defense}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>attack speed by {AttackSpeed}%<>, and <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>move speed by {MoveSpeed}%<>.",
        "ult": "Deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> to all enemies within {Range} range and apply <#ef5350ff>fear for {Time}s<>."
      },
      "dual_blader": {
        "name": "Dual Blader",
        "skill": "Fire sword energy in a straight line to deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> to enemies hit and <#ef5350ff>root for {Time}s<>.",
        "skill2": "Dash to an <#ef5350ff>immobilized<> enemy within {Range} range, launch the hit enemy <#ef5350ff>airborne for {Time}s<>, and deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<>.",
        "ult": "Cut an enemy within {Range} range with a sword, dealing {Count} times <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#f5f5f5ff>true damage<>."
      },
      "executioner": {
        "name": "Executioner",
        "skill": "Fire a hook to deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> to a hit enemy and pull them toward you.",
        "skill2": "Slash an enemy with a hook to deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> and apply <#ef5350ff>bleed for {Duration}s<>. Bleed deals <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}% of attack damage<> as <#ff9028ff>physical damage<> every {Tick}s and increases damage taken by <#ef5350ff>{Debuff}%<>.",
        "ult": "Sweep enemies in a semi-circular area in front within {Range} with a hook, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<>, and rendering them <#ef5350ff>unable to recover for {Time}s<>."
      },
      "exorcist": {
        "name": "Exorcist",
        "skill": "Nullify one ally's <#ef5350ff>status effects<> and <#6aff55ff>restore {Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% of ability power<> as <#6aff55ff>health<>.",
        "skill2": "Grant divine protection to one ally for <#ffb900ff>{Duration}s<>, increasing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>attack by {Attack}<> and <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>attack speed by {AttackSpeed}%<>. While active, reflects crowd control effects back.",
        "ult": "Create an explosion at the target area, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% of ability power<> as <#a974ffff>magic damage<> to enemies. Deals <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% AP<> bonus damage per buff on the target."
      },
      "fighter": {
        "name": "Fighter",
        "skill": "Charge at a target within {Range} at {Speed} speed, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> and <#ef5350ff>stunning for {Stun}s<>.",
        "skill2": "Slam the ground, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> to enemies within {Range} and <#ef5350ff>slowing by {Slow}% for {SlowTime}s<>.",
        "ult": "Slam the floor, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> to all enemies within {Range} range and launching them <#ef5350ff>airborne for {Time}s<>."
      },
      "gambler": {
        "name": "Gambler",
        "skill": "Roll a die and attack enemies within {Range} range a number of times equal to the result. Each attack deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<>.",
        "skill2": "Throw a chip to create an area within {Range} range that <#ef5350ff>slows enemies by {Slow}%<> for {Time}s in an {AttackRange} area. The area explodes on expiry, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> to enemies within.",
        "ult": "Fire a pile of money that charms enemies in a straight line. Hit enemies take <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> and are <#ef5350ff>charmed for {Time}s<>."
      },
      "ghost": {
        "name": "Ghost",
        "skill": "Become untargetable and dash in a line. On kill/assist, gain <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} attack<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% attack speed<> and <#6aff55ff>restore {Heal} health<>.",
        "skill2": "Dash a short distance and deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> to the first enemy hit. Can be used up to {Time} times in succession.",
        "ult": "Become immune to crowd control for <#ffb900ff>{Time}s<>. Killing or assisting kills resets the basic skill cooldown."
      },
      "gunner": {
        "name": "Gunner",
        "skill": "Can attack enemies while moving. From level 3, each attack increases <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>move speed by {Value}%<> for {Time}s.",
        "skill2": "Enhance attacks for {Time}s, increasing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>attack power by {Attack}<>. Every 3rd attack applies <#ef5350ff>{Slow}% slow for {SlowTime}s<>.",
        "ult": "Enhance attacks for {Time}s, increasing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>attack power by {Attack}<>, and fire additional bullets at 2 enemies around the attack target. Additional bullets deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<>."
      },
