        "skill": "Explodeer mana in een lange smalle lijn om <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> van vaardigheidssterkte als <#a974ffff>magische schade<> toe te brengen.",
        "skill2": "Creëer een mana kern voor {Duration}s die vijanden in {Range} elke {Tick}s naar het centrum trekt en <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> van vaardigheidssterkte als <#a974ffff>magische schade<> toebrengt.",
        "ult": "Gedurende <#ffb900ff>{Time}s<> neemt <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>bereik toe met {Range}<> en <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% van vaardigheidskracht<>. Basisaanvallen activeren de eerste vaardigheid."
      },
      "monk": {
        "name": "Monnik",
        "skill": "<#6aff55ff>Herstelt<> bondgenoten binnen {Range} met <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<>. Bij alleen zelf gericht stijgt de genezing naar <#6aff55ff>{SingleValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<>.",
        "skill2": "Palm slag om <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> als <#a974ffff>magische schade<> toe te brengen in {Range} en te <#ef5350ff>verdoven voor {Time}s<>.",
        "ult": "Geeft bondgenoten binnen {Range} een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidskracht<>. Bondgenoten met een schild krijgen <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% bewegingssnelheid<>."
      },
      "necromancer": {
        "name": "Necromancer",
        "skill": "Roept een ghoul als dienaar op voor <#ffb900ff>{Duration}(+{DurationCoef}% van vaardigheidskracht)s<>. Levels verlagen de afkoeltijd en verhogen de duur van de ghoul met <#ffb900ff>{DurationPerLevel}s<> per level.",
        "skill2": "Markeert een vijand {Time}s lang als aanval doelwit om ghouls razend te maken. Ghouls krijgen <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% van vaardigheidskracht<> aanvalssnelheid en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MoveSpeedCoef}% van vaardigheidskracht<> bewegingssnelheid.",
        "ult": "Brengt een dode bondgenootkampioen terug als revenant. Zolang de oproep actief is, wordt per seconde <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpDrain} gezondheid<> verbruikt."
      },
      "ninja": {
        "name": "Ninja",
        "skill": "Schiet een schaduwbol om op een geraakte vijand af te stormen en <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen.",
        "skill2": "Storm op een doelwit terwijl ondoelbaar en val drie keer achter elkaar aan, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> per treffer toebrengend.",
        "ult": "Valt aan op een vijand binnen {Range} afstand, waarbij <#ff9028ff>fysieke schade<> wordt toegebracht gelijk aan <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van de aanvalskracht."
      },
      "ogre": {
        "name": "Oger",
        "skill": "Elke schade aan een vijandkampioen verhoogt maximale gezondheid met <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Value}<>.",
        "skill2": "Sla een enkel doelwit met een knuppel om te <#ef5350ff>verdoven voor {Time}s<> en <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% van maximale gezondheid<> als <#ff9028ff>fysieke schade<> toe te brengen.",
        "ult": "Wordt {Time}s lang gigantisch en verhoogt <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>maximale gezondheid met {Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% van maximale gezondheid<>."
      },
      "plague_doctor": {
        "name": "Plaagdokter",
        "skill": "Injecteert een bondgenoot en zichzelf, waardoor <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% van vaardigheidskracht<> en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {MoveSpeed}%<> toenemen voor <#ffb900ff>{Duration}s<>.",
        "skill2": "Voert {Duration}s lang een ritueel uit op een bondgenoot, verhoogt <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>bereik met {Range}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{RangeCoef}% van vaardigheidskracht<> en voegt een dash toe aan aanvallen.",
        "ult": "Dient een verboden elixer toe aan een bondgenoot en zet gezondheid op 1, maar {Duration}s lang kan gezondheid niet onder 1 komen; <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aanval neemt toe met {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% van vaardigheidskracht<> en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {MoveSpeed}%<>."
      },
      "poison_dart_hunter": {
        "name": "Gifpijl jager",
        "skill": "Verspreidt een vergifveld, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe, vergiftigt gedurende <#ffb900ff>{Duration}s<> en <#ef5350ff>vertraagt {Slow}%<>.",
        "skill2": "Aanvallen op vergiftigde vijanden verhoogt <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>bereik met {Range}<>. Wegbewegen van vergiftigde vijanden verhoogt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {Speed}%<>.",
        "ult": "Geeft nabije bondgenoten gif op aanvallen gedurende <#ffb900ff>{Duration}s<>. Gif brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe gedurende <#ffb900ff>{PoisonDuration}s<>."
      },
      "priest": {
        "name": "Priester",
        "skill": "Plaats een genezingsveld voor {Duration}s in {Range} dat elke {Tick}s <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> aan <#6aff55ff>levenspunten herstelt<> bij bondgenoten.",
        "skill2": "Geef een bondgenoot een <#e8d44dff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> <#e8d44dff>schild<> voor {Time}s. <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Verhoogt hun aanvalssnelheid met {AttackSpeed}%<> terwijl het schild duurt.",
        "ult": "Vliegt {Time}s in de lucht en wordt stationair, schiet elke {Tick}s een kogel die <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#6aff55ff>HP<> herstelt aan de bondgenoot met laagste HP binnen ulti-bereik."
      },
      "pyromancer": {
        "name": "Pyromancer",
        "skill": "Laat een vuurbal vallen, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe binnen {Range}.",
        "skill2": "Roept vuurveld op dat {Duration}s duurt, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe elke {Tick}s binnen {Range}.",
        "ult": "Creëert massieve explosie binnen {Range}, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe aan alle vijanden."
      },
      "pythoness": {
        "name": "Pythoness",
        "skill": "Herstelt de <#6aff55ff>levenspunten<> van een bondgenoot met <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<>.",
        "skill2": "<#6aff55ff>Herstelt<> de levenspunten van een bondgenoot met <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> en brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% van vaardigheidssterkte<> als <#a974ffff>magische schade<> toe aan vijanden in {Range} om hen heen.",
        "ult": "Roep een Geestenpoort op. De Geestenpoort vuurt kogels af die bondgenoten in {Range} <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> gezondheid <#6aff55ff>herstellen<>, of vijanden <#a974ffff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> als <#a974ffff>magische schade<> toebrengen."
      },
      "shadowmancer": {
        "name": "Schaduwmagiër",
        "skill": "Donkere schaduwen rijzen op, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe en <#ef5350ff>vastpint {Time}s<>.",
        "skill2": "Laat schaduw van geïmmobiliseerde vijand exploderen, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe.",
        "ult": "Schiet doorborend schaduwprojectiel, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#a974ffff>magische schade<> toe aan geraakte kampioenen en <#ef5350ff>verbant {BanishTime}s<>."
      },
      "shield_bearer": {
        "name": "Schilddrager",
        "skill": "Geef een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% max. HP<> aan een bondgenoot en jezelf voor {Duration}s.",
        "skill2": "Neemt {Duration}s lang {Damage}% van de schade aan nabije bondgenoten over en <#ef5350ff>vertraagt aanvallers met {Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefCoef}% van pantser<>.",
        "ult": "Krijgt {Duration}s lang <#e8d44dff>{DamageReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MrCoef}% van magieweerstand<> schadevermindering en immuniteit tegen controle-effecten, terwijl alle nabije vijanden <#ef5350ff>{TauntDuration}s worden uitgedaagd<>. Kan tijdens de werking niet bewegen."
