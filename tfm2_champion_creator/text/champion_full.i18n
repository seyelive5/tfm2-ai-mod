    "description": {
      "archer": {
        "name": "弓使い",
        "skill": "指定方向に跳躍し、直近に攻撃した敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill2": "近くの敵1体に矢を放ち<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、短く<#ef5350ff>硬直<>させ、後ろにジャンプして離脱する。",
        "ult": "その場に止まり、計{Count}本の矢を発射する。矢は近くの{Range}範囲内のランダムな敵を対象に飛び、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。"
      },
      "bard": {
        "name": "吟遊詩人",
        "skill": "味方1人の<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度を{AttackSpeed}%<><#ffb900ff>{Duration}秒<>間上昇させる。",
        "skill2": "指定した範囲内の味方のスキル再使用待機時間が{Duration}秒間<#ffb900ff>{CoolReduce}%<>減少する。",
        "ult": "<#ffb900ff>{Duration}秒<>間チャネリングし、周囲{Range}範囲内の味方チャンピオンの<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力を{Attack}<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度を{AttackSpeed}%<>上昇させるが、<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>防御力<>と<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>魔法抵抗力<>が0になる。"
      },
      "barrier_magician": {
        "name": "結界師",
        "skill": "指定エリアに<#ffb900ff>{Duration}秒<>間維持される結界を設置し、結界内の味方に<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{ShieldCoef}%<>の<#e8d44dff>シールド<>を付与し、敵の<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度を{AttackSpeedReduce}%<>減少させる。3レベルから範囲が拡大し、結界内の味方に追加で<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度<>を付与し、敵を<#ef5350ff>鈍化<>させる。",
        "skill2": "指定エリアに<#ffb900ff>{Duration}秒<>間維持される結界を召喚し、結界内の投射物をすべて消滅させる。",
        "ult": "敵チャンピオンの周囲に徐々に縮小する円形結界を設置する。結界の縁に触れた敵は<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を受け、<#ef5350ff>{Time}秒間気絶<>する。"
      },
      "berserker": {
        "name": "狂戦士",
        "skill": "{Duration}秒間怒り、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度が{AttackSpeed}%上昇<>し、<#6aff55ff>{Vamp}%の吸血<>を得る。",
        "skill2": "両手で地面を叩きつけ、狭い範囲の敵を<#ef5350ff>{Time}秒間打ち上げ<>、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "ult": "{Range}距離内の指定した敵に突進して叩きつけ、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。失われた<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>体力<>に比例して再使用待機時間が減少する。"
      },
      "boomerang_hunter": {
        "name": "ブーメランハンター",
        "skill": "直線方向にブーメランを投げ、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。射程の終点でブーメランが一定時間回転し、触れた敵に<#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{DotCoef}%<>の<#ff9028ff>物理ダメージ<>を継続的に与える。",
        "skill2": "三方向にブーメランを投げる。ブーメランは最後まで飛んで戻り、軌道上の敵全員に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "ult": "直線方向に強力なブーメランを発射し、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。敵チャンピオンに命中時、最も近い別の敵チャンピオン方向に跳ね返り、跳ね返るたびにダメージが<#ff9028ff>{Increase}%<>ずつ増加する。最大{MaxBounce}回跳ね返る。"
      },
      "chef": {
        "name": "料理人",
        "skill": "直線に包丁を投げ、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{SlowTime}秒間{Slow}%鈍化<>させる。",
        "skill2": "周辺の味方に料理を分け与え、<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{HealCoef}%<>分の<#6aff55ff>体力を継続回復<>させる。自分のみを回復する場合、回復量が<#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{SelfHealCoef}%<>に増加する。",
        "ult": "味方チャンピオンに特製料理を投げ、<#ffb900ff>{Duration}秒<>間<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大体力が{HpRatio}%増加<>する。受けるダメージの<#e8d44dff>{SpreadRatio}%<>が継続ダメージとして分散される。"
      },
      "clown": {
        "name": "道化師",
        "skill": "指定対象の横に瞬間移動し、対象が敵の場合<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ffb900ff>{Duration}秒<>間<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度が{MoveSpeed}%上昇<>する。",
        "skill2": "周囲に多数の短剣を撒き散らし、範囲内の敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。(スキル使用中移動可能)",
        "ult": "<#ffb900ff>{Time}秒<>間狂気状態になり、すべての短剣が敵に跳ね返る特殊な短剣に変わる。"
      },
      "dancer": {
        "name": "舞姫",
        "skill": "敵にチャクラムを投げ、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>分の<#ff9028ff>物理ダメージ<>を与える。追加されたチャクラム1個につき、このスキルのダメージが{StackCoef}%増加する。",
        "skill2": "キルごとにチャクラムが基本攻撃に追加される。(最大{MaxCount}個、追加チャクラムのヒットごとにダメージが{Reduce}%減少)",
        "ult": "{Count}(+スタック)個の貫通チャクラムを扇状に発射し、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。チャクラムが戻り、<#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{ReturnCoef}%<>の<#ff9028ff>物理ダメージ<>を与える。(最大{MaxCount}個)"
      },
      "dark_mage": {
        "name": "黒魔術師",
        "skill": "闇の矢を発射し、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{Time}秒間束縛<>する。",
        "skill2": "遅延後にエリアを闇で覆い、内部の敵に<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与える。",
        "ult": "{Range}内の敵チャンピオンを呪い、最も近い味方と<#ffb900ff>{Duration}秒<>間リンクさせる。一方がダメージを受けると<#a974ffff>{ShareRatio}%<>がもう一方に転送される。"
      },
      "demon": {
        "name": "悪魔",
        "skill": "地面から地獄の爪が湧き上がり敵を掴む。命中時<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、敵と自分の位置を入れ替える。",
        "skill2": "{Time}秒間大悪魔に変身する。変身中、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力が{Attack}<>、<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>防御力が{Defense}<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度が{AttackSpeed}%<>、<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度が{MoveSpeed}%<>増加する。",
        "ult": "周囲{Range}範囲内のすべての敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{Time}秒間恐怖<>を与える。"
      },
      "dual_blader": {
        "name": "デュアルブレーダー",
        "skill": "一直線に剣気を発射し命中した敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、対象を{Time}秒間<#ef5350ff>束縛<>する。",
        "skill2": "<#ef5350ff>移動不可<>状態にある{Range}範囲内の敵に突進し、命中した敵を<#ef5350ff>{Time}秒間打ち上げ<>、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "ult": "指定された{Range}の範囲内の敵1体を剣で切り刻み、{Count}回 <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#f5f5f5ff>固定ダメージ<>を与える。"
      },
      "executioner": {
        "name": "処刑人",
        "skill": "フックを発射し命中した敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、自分の前に引き寄せる。",
        "skill2": "敵1体をフックで引き裂き<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え<#ef5350ff>{Duration}秒間出血<>させる。出血ダメージを受けた敵は{Tick}秒ごとに<#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{TickCoef}%<>の<#ff9028ff>物理ダメージ<>を受け、<#ef5350ff>受けるダメージ量が{Debuff}%増加<>する。",
        "ult": "前方の{Range}範囲の半円領域の敵をフックで薙ぎ払い、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{Time}秒間回復不可<>状態にする。"
      },
      "exorcist": {
        "name": "エクソシスト",
        "skill": "味方1体の<#ef5350ff>状態異常<>を無効化し、体力を<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{Coef}%<>分<#6aff55ff>回復<>する。",
        "skill2": "味方1人に<#ffb900ff>{Duration}秒<>間神聖な保護を付与し、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力を{Attack}<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度を{AttackSpeed}%<>上昇させる。発動中、群衆制御効果を反射する。",
        "ult": "対象エリアに爆発を起こし、敵に<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与える。対象のバフごとに<#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{BonusCoef}%<>の追加ダメージを与える。"
      },
      "fighter": {
        "name": "格闘家",
        "skill": "{Range}内の対象に{Speed}速度で突進し、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{Stun}秒間気絶<>させる。",
        "skill2": "地面を叩き、{Range}内の敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{SlowTime}秒間{Slow}%鈍化<>させる。",
        "ult": "床を叩き、{Range}範囲内のすべての敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{Time}秒間エアボーン<>させる。"
      },
      "gambler": {
        "name": "賭博師",
        "skill": "サイコロを転がしサイコロの目と同数の回数{Range}範囲内の敵を攻撃する。各攻撃は<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill2": "チップを投げて{Range}射程内に{Time}秒間{AttackRange}の大きさの<#ef5350ff>{Slow}%鈍化<>領域を生成する。領域は消える時に爆発し、範囲内の敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "ult": "一直線で敵を魅了するお金の山を発射する。被撃敵は<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>ほどの<#ff9028ff>物理ダメージ<>を受け、<#ef5350ff>{Time}秒間魅了<>される。"
      },
      "ghost": {
        "name": "幽霊",
        "skill": "ターゲット不能になり直線にダッシュする。キル/アシスト時、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}攻撃力<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%攻撃速度<>を獲得し、<#6aff55ff>{Heal}体力を回復<>する。",
        "skill2": "短距離をダッシュし、最初に当たった敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。最大{Time}回連続使用可能。",
        "ult": "<#ffb900ff>{Time}秒<>間群衆制御免疫になる。キルまたはアシスト時に基本スキルのクールタイムがリセットされる。"
      },
      "gunner": {
        "name": "ガンナー",
        "skill": "移動中に敵を攻撃できる。レベル3から敵を攻撃するたびに{Time}秒間<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度<>が{Value}%上昇する。",
        "skill2": "{Time}秒間攻撃を強化し<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力が{Attack}上昇<>する。3回攻撃ごとに弾丸が敵に<#ef5350ff>{SlowTime}秒間{Slow}%鈍化<>を付与する。",
        "ult": "{Time}秒間攻撃が強化され、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力が{Attack}上昇<>し、攻撃対象周辺2人の敵に追加で弾丸を発射する。追加弾丸は<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。"
      },
      "ice_mage": {
        "name": "氷術師",
        "skill": "相手を凍らせ<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{Time}秒間気絶<>させる。",
        "skill2": "{Duration}秒間持続する氷床を召喚し、{Range}範囲内の敵の<#ef5350ff>移動速度を{MoveSpeed}%減速<>させ、{Tick}秒ごとに<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与える。床が消える時範囲内の敵を凍らせ<#ef5350ff>{Stun}秒間気絶<>させる。",
        "ult": "前方扇状の敵に<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与えてノックバックさせる。<#ef5350ff>{SlowDuration}秒間{Slow}%鈍化<>させ、<#ef5350ff>{BlockDuration}秒間移動スキルを封じる<>。"
      },
      "illusionist": {
        "name": "幻影術師",
        "skill": "投射物を発射し、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{Time}秒間挑発<>する幻影を召喚する。",
        "skill2": "{Range}内の敵に<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{Time}秒間恐怖<>させる。",
        "ult": "近くの味方チャンピオンの幻影を<#ffb900ff>{Duration}秒<>間作る。幻影は基本攻撃のみ実行でき、コピー元のチャンピオンと同じステータスを持つ。"
      },
      "jiangshi": {
        "name": "キョンシー",
        "skill": "小さなキョンシーを召喚し敵に突進、3回攻撃して消滅する。1ヒットごとに<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill2": "敵を叩きつけて<#ef5350ff>{Time}秒間気絶<>させ、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#6aff55ff>{Heal}体力を回復<>する。",
        "ult": "<#ffb900ff>{Duration}秒<>間、{Range}内の敵から<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{HealCoef}%<>分の<#6aff55ff>体力を吸収<>し、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{DamageCoef}%<>の<#a974ffff>魔法ダメージ<>を与える。"
      },
      "knight": {
        "name": "騎士",
        "skill": "対象を<#ef5350ff>{Time}秒間挑発<>する。",
        "skill2": "{Time}秒間持続する<#e8d44dff>シールド<>を自身に付与する（<#e8d44dff>シールド<>量: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大体力の{Coef}%<> + <#e8d44dff>{Amount}<>）。シールド中に受けたダメージの<#ff9028ff>{Reflect}%を反射<>する。",
        "ult": "指定位置に<#ffb900ff>{Time}秒<>持続する範囲{Range}の防御エリアを召喚する。範囲内の味方は受けるダメージが<#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大体力の{HpCoef}%<>減少する。"
