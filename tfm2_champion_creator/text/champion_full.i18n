    "description": {
      "archer": {
        "name": "Arqueiro",
        "skill": "Salte na direção indicada e cause <#ff9028ff>dano físico<> igual a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> do poder de ataque ao inimigo atacado mais recentemente.",
        "skill2": "Atire uma flecha em um inimigo próximo para causar <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> do dano de ataque como <#ff9028ff>dano físico<>, <#ef5350ff>atordoe<> brevemente e salte para trás.",
        "ult": "Ele para no lugar e dispara um total de flechas {Count}. A flecha voa em direção a um inimigo aleatório dentro do alcance próximo de {Range}, causando <#ff9028ff>dano físico<> igual a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> do poder de ataque."
      },
      "bard": {
        "name": "Bardo",
        "skill": "Aumenta a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque de um aliado em {AttackSpeed}%<> por <#ffb900ff>{Duration}s<>.",
        "skill2": "Reduz o tempo de recarga das habilidades dos aliados na área alvo em <#ffb900ff>{CoolReduce}%<> por {Duration}s.",
        "ult": "Canaliza por <#ffb900ff>{Duration}s<>, aumentando o <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>ataque em {Attack}<> e a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque em {AttackSpeed}%<> dos campeões aliados em {Range} de alcance, mas a <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>armadura<> e a <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>resistência mágica<> tornam-se 0."
      },
      "barrier_magician": {
        "name": "Mago de barreira",
        "skill": "Cria uma barreira por <#ffb900ff>{Duration}s<>, concedendo aos aliados <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% PH<> de <#e8d44dff>escudo<> e reduzindo a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque inimiga em {AttackSpeedReduce}%<>. A partir do nível 3, concede aos aliados <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque<> bônus e <#ef5350ff>desacelera<> inimigos.",
        "skill2": "Invoca uma barreira por <#ffb900ff>{Duration}s<> na área alvo que destrói todos os projéteis dentro.",
        "ult": "Cria uma barreira que encolhe ao redor de um campeão inimigo. Inimigos tocando a borda recebem <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>dano mágico<> e são <#ef5350ff>atordoados por {Time}s<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Entre em fúria por {Duration}s, aumentando a velocidade de ataque em <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> e ganhando <#6aff55ff>{Vamp}% roubo de vida<>.",
        "skill2": "Bata no chão com as duas mãos para lançar inimigos em uma área estreita <#ef5350ff>no ar por {Time}s<> e causar <#ff9028ff>dano físico<> igual a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> do poder de ataque.",
        "ult": "{Range} Corre em direção a um inimigo apontado dentro do alcance e atinge o inimigo, infligindo <#ff9028ff>dano físico<> igual a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> do poder de ataque. O tempo de espera é reduzido proporcionalmente à <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>vida<> perdida."
      },
      "boomerang_hunter": {
        "name": "Caçador de bumerangue",
        "skill": "Lança um bumerangue em linha, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dano físico<>. No alcance máximo gira, causando continuamente <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% AD<> de <#ff9028ff>dano físico<>.",
        "skill2": "Lança três bumerangues que retornam, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dano físico<> a todos os inimigos no caminho.",
        "ult": "Atira um bumerangue poderoso em linha reta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do dano de ataque<> como <#ff9028ff>dano físico<>. Ao atingir um campeão inimigo, ricocheteia para o campeão inimigo mais próximo, aumentando o dano em <#ff9028ff>{Increase}%<> por ricochete. Ricocheteia até {MaxBounce} vezes."
      },
      "chef": {
        "name": "Chef",
        "skill": "Lança uma faca em linha, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>dano mágico<> e <#ef5350ff>desacelerando em {Slow}% por {SlowTime}s<>.",
        "skill2": "Distribui comida aos aliados próximos, <#6aff55ff>restaurando vida<> em <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PH<> ao longo do tempo. Cura apenas em si aumenta para <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% PH<>.",
        "ult": "Lança comida especial a um campeão aliado. Por <#ffb900ff>{Duration}s<>, <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>HP máximo aumenta em {HpRatio}%<>. <#e8d44dff>{SpreadRatio}%<> do dano recebido é distribuído como dano ao longo do tempo."
      },
      "clown": {
        "name": "Palhaço",
        "skill": "Teleporta para perto de um alvo. Se inimigo, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dano físico<> e ganha <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidade de movimento<> por <#ffb900ff>{Duration}s<>.",
        "skill2": "Espalha adagas ao redor, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dano físico<> a inimigos na área. (Pode mover-se durante a conjuração)",
        "ult": "Entra em frenesi por <#ffb900ff>{Time}s<>. Todas as adagas tornam-se especiais que ricocheteiam entre inimigos."
      },
      "dancer": {
        "name": "Dançarina",
        "skill": "Arremessa um chakram em um inimigo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Dano de Ataque<> como <#ff9028ff>dano físico<>. Cada chakram adicional aumenta o dano desta habilidade em {StackCoef}%.",
        "skill2": "Cada abate adiciona um chakram aos ataques básicos. (Máx {MaxCount}, dano reduz {Reduce}% por chakram extra)",
        "ult": "Atira {Count}(+pilhas) chakrams penetrantes em leque, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dano físico<>. Os chakrams retornam, causando <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% AD<> de <#ff9028ff>dano físico<>. (Máx {MaxCount})"
      },
      "dark_mage": {
        "name": "Mago das trevas",
        "skill": "Atira uma flecha sombria, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>dano mágico<> e <#ef5350ff>enraizando por {Time}s<>.",
        "skill2": "Cobre uma área com escuridão após um atraso, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>dano mágico<> aos inimigos dentro.",
        "ult": "Amaldiçoa um campeão inimigo em {Range}, ligando-o ao aliado mais próximo por <#ffb900ff>{Duration}s<>. Quando um recebe dano, <#a974ffff>{ShareRatio}%<> é transferido ao outro."
