        "skill": "一直線に突進し最初に命中した敵を槍に刺し、<#ef5350ff>{Time}秒間束縛<>し<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。突進速度は移動速度に比例する。",
        "skill2": "{Time}秒間<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度が{Speed}%上昇<>し、武器を炎の槍に強化して、攻撃時に{BurnTime}秒間<#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{BurnCoef}%<>分の火傷ダメージを追加で与える。",
        "ult": "{Time}秒間<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度が{Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{SpeedCoef}%<>上昇し、自身の位置へ向かう床を生成する。その床の上の味方は騎兵のいる方向へ移動すると<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度が{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{SpeedCoef}%<>増加する。"
      },
      "druid": {
        "name": "ドルイド",
        "skill": "熊を召喚する。死亡時、ドルイドが<#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{DeathCoef}%<>のダメージを受ける。召喚中に再使用すると熊の体力を<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{HealCoef}%<>分<#6aff55ff>回復<>する。",
        "skill2": "鷲を召喚する。鷲が死亡するとドルイドはダメージを受ける。鷲が召喚されている間にこのスキルを使用すると、鷲が敵へ突進して<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{Coef}%<>分の<#a974ffff>魔法ダメージ<>を与え、与えたダメージの<#6aff55ff>{Lifesteal}%分体力を回復<>する。",
        "ult": "指定方向へ熊と鷲の魂を連続で{Count}個発射する。各投射体は<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{Coef}%<>分の<#a974ffff>魔法ダメージ<>を与え、敵を後方へ押し出す。"
      },
      "voodoo_shaman": {
        "name": "ブードゥーシャーマン",
        "skill": "呪いの投射物を発射し、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{Time}秒間{Slow}%鈍化<>させ、<#ffb900ff>{AtkSpdTime}秒<>間<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度を{AtkSpd}%<>減少させる。",
        "skill2": "敵を<#ffb900ff>{Time}秒<>間呪い、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与える。受けたヒットごとに<#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{HitCoef}%<>の追加ダメージを与える(最大{Max})。",
        "ult": "<#ffb900ff>{Duration}秒<>間ヴードゥーゾーンを作る。内部の敵は定期的に<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大HPの{HpRatio}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を受け、<#ef5350ff>沈黙<>する。"
      },
      "hitman": {
        "name": "ヒットマン",
        "skill": "3連射する。最初の弾は<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{StunTime}秒間気絶<>させる。",
        "skill2": "{Range}範囲内で最後に攻撃した敵チャンピオンの背後に瞬間移動する。",
        "ult": "敵チャンピオンに標的を付け、<#ffb900ff>{Duration}秒<>後に<#ff9028ff>{Damage} + 標的中に受けたダメージの{Coef}%<>分の<#ff9028ff>物理ダメージ<>を与える。対象を倒すと<#ffb900ff>{InvisibleDuration}秒<>間ステルス状態になる。"
      },
      "guardian_spirit": {
        "name": "守護霊",
        "skill": "近くの味方の体力を<#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>分<#6aff55ff>回復<>する。",
        "skill2": "味方に<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{ShieldCoef}%<>の<#e8d44dff>シールド<>と<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移動速度<>を付与する。",
        "ult": "<#ffb900ff>{Duration}秒<>間聖域を作り、範囲内の味方の体力を<#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{HealCoef}%<>分継続的に<#6aff55ff>回復<>し、復活シールドを付与する。"
      },
      "hunter": {
        "name": "ハンター",
        "skill": "敵に瞬間移動し、遠距離モードに切り替える。<i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>射程が{RangeIncrease}増加<>する。",
        "skill2": "3スタックマークされた敵にダッシュし、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{SilenceTime}秒間沈黙<>させる。",
        "ult": "前方にダッシュし、進路上の敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。キルまたはアシスト時に再使用可能。"
      },
      "circus_blade": {
        "name": "サーカスブレード",
        "skill": "対象方向にブレードを発射し、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{SlowTime}秒間{Slow}%鈍化<>させる。最大<#ffb900ff>{ChargeCount}<>チャージを保持する。敵チャンピオンへの基本攻撃で<#ffb900ff>1<>チャージを獲得する。",
        "skill2": "<#ffb900ff>{Duration}秒<>間<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移動速度<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%攻撃速度<>、壁通過を獲得する。",
        "ult": "対象の敵にダッシュし、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。<#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{SplashCoef}%<>のスプラッシュダメージを与え、近くの敵を<#ef5350ff>ノックバック<>させた後、消える。"
      },
      "tfm2_cc_emberling": {
        "name": "Emberling",
        "skill": "Fires a piercing ember bolt dealing 80% AP.",
        "skill2": "Focuses flame: gains magic power and faster cooldowns.",
        "ult": "Erupts, dealing 100% AP and stunning nearby enemies."
      }
    }
  },
