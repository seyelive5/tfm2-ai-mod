      "android": {
        "name": "안드로이드",
        "skill": "일직선으로 충격파를 발사한다. 충격파는 적에게 적중하거나 사거리 끝에 도달시 원형으로 폭발하며, 범위 내의 적에게 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {Coef}%<> 만큼의 <#ff9028ff>물리 피해<>를 입히며 <#ef5350ff>{Time}초 동안 {Slow}% 둔화<>를 부여한다.",
        "skill2": "{Time}초 동안 유지되는 <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>최대 체력의 {Coef}%<> 만큼의 <#e8d44dff>보호막<>을 자신에게 부여한다. 보호막은 없어질 때 주변 {Range} 범위 내에 있는 적을 <#ef5350ff>{StunTime}초 동안 기절<>시킨다.",
        "ult": "{Range} 범위 내에 있는 지정된 아군에게 <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>최대 체력의 {Coef}%<> 만큼의 <#e8d44dff>보호막<>을 부여하며, {Time}초 후 지정된 아군에게로 순간이동한다."
      },
      "white_mage": {
        "name": "백마술사",
        "skill": "일직선의 광선이 잠시 후 폭발하며 범위 내의 모든 적들에게 <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼의 <#a974ffff>마법 피해<>를 입힌다.",
        "skill2": "원형의 범위에 광선을 소환하여 5번 공격하고 범위 내의 적에게 <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼의 <#a974ffff>마법 피해<>를 입히며 <#ef5350ff>{SlowTime}초 동안 {Slow}% 둔화<>시킨다.",
        "ult": "일직선으로 관통하는 광선을 발사하여 적중한 적에게 <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼의 <#a974ffff>마법 피해<>를 입히고 <#ef5350ff>{Time}초 동안 속박<>시킨다."
      },
      "wind_mage": {
        "name": "바람술사",
        "skill": "<#ffb900ff>{Duration}초<> 동안 소용돌이를 소환하여 {Range} 범위 내의 적에게 {Tick}초마다 <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼의 <#a974ffff>마법 피해<>를 입힌다. 소용돌이 내에 있는 아군은 <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>이동속도가 {MoveSpeed}% 상승<>한다.",
        "skill2": "전방으로 다섯갈래의 소용돌이를 쏘아내어 범위 내의 적에게 <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼의 <#a974ffff>마법 피해<>를 입힌다.",
        "ult": "가장 가까운 적 챔피언을 향해 느리게 이동하는 거대한 회오리를 발사한다. 회오리에 적중한 적은 <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼의 <#a974ffff>마법 피해<>를 입고 <#ef5350ff>{AirborneTime}초 동안 에어본<>된다. 적중할 때마다 회오리의 크기와 피해량, 공중에 뜨는 시간이 감소하며, 다른 적 챔피언을 향해 방향을 바꾼다."
      },
      "bomber": {
        "name": "폭탄병",
        "skill": "폭탄을 던져 범위 내의 모든 적에게 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {Coef}%<> 만큼의 <#ff9028ff>물리 피해<>를 입힌다.",
        "skill2": "적에게 보이지 않는 지뢰를 설치하여 적이 밟았을 경우 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {Coef}%<> 만큼의 <#ff9028ff>물리 피해<>를 입히고 <#ef5350ff>{Time}초 동안 속박<>시킨다. 지뢰는 미니언에게 발동되지 않는다.",
        "ult": "지정한 위치에 대형 폭탄을 투척하여 범위 내 모든 적에게 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {Coef}%<> 만큼의 <#ff9028ff>물리 피해<>를 입히고 <#ef5350ff>{SlowTime}초 동안 {Slow}% 둔화<>시킨다."
      },
      "cavalry_knight": {
        "name": "기병",
        "skill": "일직선으로 돌진하여 처음으로 적중한 적을 창에 꿰어 <#ef5350ff>{Time}초간 속박<>시키고 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {Coef}%<> 만큼의 <#ff9028ff>물리 피해<>를 입힌다. 돌진 속도는 이동속도에 비례한다.",
        "skill2": "{Time}초 동안 <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>이동속도가 {Speed}% 상승<>하며 무기를 화염 창으로 강화하여 공격 시 {BurnTime}초 동안 <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {BurnCoef}%<> 만큼의 화상 피해를 추가로 입힌다.",
        "ult": "{Time}초 동안 <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>이동속도가 {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {SpeedCoef}%<> 상승하며, 자신의 위치로 향하는 장판을 생성한다. 장판 위에 있는 아군은 기병이 있는 방향으로 이동할 때 <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>이동속도가 {Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {SpeedCoef}%<> 증가한다."
      },
      "druid": {
        "name": "드루이드",
        "skill": "곰을 소환한다. 곰이 사망할 경우 <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {DeathCoef}%<> 만큼의 피해를 받는다. 곰이 소환된 도중에 사용하면 곰의 체력을 <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {HealCoef}%<> 만큼 <#6aff55ff>회복<>시킨다.",
        "skill2": "독수리를 소환한다. 독수리가 사망할 경우 드루이드는 피해를 입는다. 독수리가 소환되어 있는 도중에 해당 스킬을 사용할 경우 독수리가 적에게 돌진하여 <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼의 <#a974ffff>마법 피해<>를 입히고 피해량의 <#6aff55ff>{Lifesteal}%만큼 체력을 회복<>한다.",
        "ult": "지정한 방향으로 곰과 독수리의 영혼을 연달아 {Count}개 발사한다. 각 투사체는 <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼의 <#a974ffff>마법 피해<>를 입히고 적을 뒤로 밀어낸다."
      },
      "voodoo_shaman": {
        "name": "부두술사",
        "skill": "저주의 투사체를 발사하여 <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼의 <#a974ffff>마법 피해<>를 입히고, <#ef5350ff>{Time}초 동안 {Slow}% 둔화<>시키며 <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>공격속도를 {AtkSpd}%<> <#ffb900ff>{AtkSpdTime}초<> 동안 감소시킨다.",
        "skill2": "적 대상을 지정하여 <#ffb900ff>{Time}초<> 동안 저주를 걸고, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼의 <#a974ffff>마법 피해<>를 입힌다. 지속되는 동안 공격받은 횟수에 비례하여 <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {HitCoef}%<> 만큼의 추가 피해를 입힌다. (최대 {Max}회)",
        "ult": "지정한 위치에 <#ffb900ff>{Duration}초<> 동안 부두 영역을 생성한다. 영역 내의 적은 <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>최대 체력의 {HpRatio}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼의 <#a974ffff>마법 피해<>를 지속적으로 받으며 <#ef5350ff>스킬 사용 불가<> 상태가 된다."
      },
      "hitman": {
        "name": "히트맨",
        "skill": "세 발의 연속 사격을 발사한다. 첫 발은 적에게 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {Coef}%<> 만큼의 <#ff9028ff>물리 피해<>와 <#ef5350ff>{StunTime}초 기절<>을 부여한다.",
        "skill2": "{Range} 거리 내 최근 공격한 적 챔피언의 뒤로 순간이동한다.",
        "ult": "적 챔피언을 표식하여 <#ffb900ff>{Duration}초<> 후 <#ff9028ff>{Damage} + 표식 동안 받은 피해량의 {Coef}%<> 만큼의 <#ff9028ff>물리 피해<>를 입힌다. 대상 처치 시 <#ffb900ff>{InvisibleDuration}초<> 동안 은신한다."
      },
      "guardian_spirit": {
        "name": "수호령",
        "skill": "주변 범위 내 아군의 체력을 <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {Coef}%<> 만큼 <#6aff55ff>회복<>시킨다.",
        "skill2": "아군에게 <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {ShieldCoef}%<> 만큼의 <#e8d44dff>보호막<>과 <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>이동속도 {MoveSpeed}% 증가<>를 부여한다.",
        "ult": "<#ffb900ff>{Duration}초<> 동안 성역을 생성하여 범위 내 아군의 체력을 <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 {HealCoef}%<> 만큼 지속적으로 <#6aff55ff>회복<>시키며, 부활 보호막을 부여한다."
      },
      "hunter": {
        "name": "사냥꾼",
        "skill": "적에게 순간이동하며 원거리 공격 모드로 전환한다. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>사거리가 {RangeIncrease} 증가<>한다.",
        "skill2": "표식이 3개 쌓인 적에게 돌진하여 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {Coef}%<> 만큼의 <#ff9028ff>물리 피해<>를 입히고 <#ef5350ff>{SilenceTime}초 동안 침묵<>시킨다.",
        "ult": "전방으로 돌진하며 궤적 내의 적에게 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {Coef}%<> 만큼의 <#ff9028ff>물리 피해<>를 입힌다. 적 처치 관여 시 재사용 가능하다."
      },
      "circus_blade": {
        "name": "곡예사",
        "skill": "지정 방향으로 칼날을 발사하여 적에게 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {Coef}%<> 만큼의 <#ff9028ff>물리 피해<>를 입히고 <#ef5350ff>{SlowTime}초 동안 {Slow}% 둔화<>시킨다. 최대 <#ffb900ff>{ChargeCount}회<> 충전되며, 적 챔피언에게 기본 공격 적중 시 <#ffb900ff>1회<> 충전된다.",
        "skill2": "<#ffb900ff>{Duration}초<> 동안 <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>이동속도 {MoveSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>공격속도 {AttackSpeed}%<> 증가 및 벽 통과 효과를 얻는다.",
        "ult": "지정한 적에게 돌진하여 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {Coef}%<> 만큼의 <#ff9028ff>물리 피해<>를 입힌다. 주변 적에게 <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 {SplashCoef}%<> 만큼의 범위 피해와 <#ef5350ff>넉백<>을 부여하고 사라진다."
      },
      "tfm2_cc_emberling": {
        "name": "엠벌링",
        "skill": "관통하는 불씨를 발사해 주문력의 80% 피해를 줍니다.",
        "skill2": "화염 집중: 주문력과 쿨다운 감소를 얻습니다.",
        "ult": "폭발하여 주문력의 100% 피해를 주고 주변 적을 기절시킵니다."
      }
    }
  },
