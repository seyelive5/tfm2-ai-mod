    "description": {
      "archer": {
        "name": "弓箭手",
        "skill": "向指定方向跳躍，對最近攻擊的敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻擊力的{Coef}%<>的<#ff9028ff>物理傷害<>。",
        "skill2": "向附近敵人發射箭矢造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻擊力的{Coef}%<><#ff9028ff>物理傷害<>，短暫<#ef5350ff>僵直<>並向後跳躍撤退。",
        "ult": "停在原地並發射總共 {Count} 支箭。箭矢隨機飛向附近 {Range} 範圍內的一名敵人，造成 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻擊力的{Coef}%<>的<#ff9028ff>物理傷害<>。"
      },
      "bard": {
        "name": "吟遊詩人",
        "skill": "提升一名隊友的<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度{AttackSpeed}%<>，持續<#ffb900ff>{Duration}秒<>。",
        "skill2": "降低指定區域內隊友的技能冷卻時間<#ffb900ff>{CoolReduce}%<>，持續{Duration}秒。",
        "ult": "引導<#ffb900ff>{Duration}秒<>，提升周圍{Range}範圍內隊友英雄的<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻擊力{Attack}<>和<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度{AttackSpeed}%<>，但<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>護甲<>和<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>魔抗<>變為0。"
      },
      "barrier_magician": {
        "name": "結界師",
        "skill": "在指定區域設置維持<#ffb900ff>{Duration}秒<>的結界，為結界內的隊友提供<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}%法強<>的<#e8d44dff>護盾<>，並降低敵人的<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度{AttackSpeedReduce}%<>。3級起範圍擴大，結界內的隊友獲得額外<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度<>，敵人被<#ef5350ff>減速<>。",
        "skill2": "在指定區域召喚維持<#ffb900ff>{Duration}秒<>的結界，消除其內所有投射物。",
        "ult": "在敵方英雄周圍設置逐漸縮小的圓形結界。觸碰結界邊緣的敵人受到<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法強<>的<#a974ffff>魔法傷害<>並被<#ef5350ff>暈眩{Time}秒<>。"
      },
      "berserker": {
        "name": "狂戰士",
        "skill": "{Duration}秒內憤怒，<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度上升{AttackSpeed}%<>並獲得<#6aff55ff>{Vamp}%吸血<>。",
        "skill2": "用雙手拍擊地面，將狹窄範圍的敵人<#ef5350ff>浮空{Time}秒<>並造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻擊力的{Coef}%<>的<#ff9028ff>物理傷害<>。",
        "ult": "衝向 {Range} 範圍內指定的敵人並對其進行攻擊，造成 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻擊力的{Coef}%<>的<#ff9028ff>物理傷害<>。冷卻時間與失去的<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>生命值<>成比例減少。"
      },
      "boomerang_hunter": {
        "name": "迴旋鏢獵人",
        "skill": "向直線方向投擲迴旋鏢，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻擊<>的<#ff9028ff>物理傷害<>。在最大射程處旋轉，對觸碰的敵人持續造成<#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}%攻擊<>的<#ff9028ff>物理傷害<>。",
        "skill2": "向三個方向投擲迴旋鏢，迴旋鏢會返回，對路徑上所有敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻擊<>的<#ff9028ff>物理傷害<>。",
        "ult": "向直線方向發射強力迴旋鏢，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻擊力<>的<#ff9028ff>物理傷害<>。命中敵方英雄時，向最近的另一名敵方英雄方向反彈，每次反彈傷害增加<#ff9028ff>{Increase}%<>。最多反彈{MaxBounce}次。"
      },
      "chef": {
        "name": "廚師",
        "skill": "向直線投擲菜刀，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法強<>的<#a974ffff>魔法傷害<>，並<#ef5350ff>減速{Slow}%持續{SlowTime}秒<>。",
        "skill2": "向周圍隊友分發料理，持續回復<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%法強<>的<#6aff55ff>生命值<>。僅自己受治療時，治療量增加為<#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}%法強<>。",
        "ult": "向隊友英雄投擲特製料理。<#ffb900ff>{Duration}秒<>內<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大生命值增加{HpRatio}%<>。受到傷害的<#e8d44dff>{SpreadRatio}%<>分散為持續傷害。"
      },
      "clown": {
        "name": "小丑",
        "skill": "瞬間移動到目標旁。若為敵人，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻擊<>的<#ff9028ff>物理傷害<>，並獲得<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移動速度<>持續<#ffb900ff>{Duration}秒<>。",
        "skill2": "向周圍撒出大量短劍，對範圍內敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻擊<>的<#ff9028ff>物理傷害<>。(施放期間可移動)",
        "ult": "<#ffb900ff>{Time}秒<>內進入狂氣狀態，所有短劍變為可在敵人間反彈的特殊短劍。"
      },
      "dancer": {
        "name": "舞者",
        "skill": "向敵人投擲輪刃，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻擊力的{Coef}%<>的<#ff9028ff>物理傷害<>。每個額外輪刃使此技能傷害提高{StackCoef}%。",
        "skill2": "每次擊殺向基本攻擊追加飛輪。(最多{MaxCount}個，每追加飛輪命中傷害降低{Reduce}%)",
        "ult": "向扇形發射{Count}(+層數)個穿透飛輪，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻擊<>的<#ff9028ff>物理傷害<>。飛輪回歸時造成<#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}%攻擊<>的<#ff9028ff>物理傷害<>。(最多{MaxCount}個)"
