        "skill": "Un haz explota tras un retraso, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> a todos los enemigos.",
        "skill2": "Invoca haces para atacar 5 veces, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>.",
        "ult": "Dispara un haz penetrante, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> a enemigos golpeados y <#ef5350ff>enraizando durante {Time}s<>."
      },
      "wind_mage": {
        "name": "Mago de viento",
        "skill": "Invoca un torbellino durante <#ffb900ff>{Duration}s<>, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> cada {Tick}s en {Range}. Los aliados dentro ganan <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidad de movimiento<>.",
        "skill2": "Dispara cinco torbellinos hacia adelante, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<>.",
        "ult": "Lanza un tornado masivo. Los enemigos golpeados reciben <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y son <#ef5350ff>lanzados al aire durante {AirborneTime}s<>. Tamaño, daño y tiempo en el aire disminuyen por golpe. Redirige a otros campeones."
      },
      "bomber": {
        "name": "Bombardero",
        "skill": "Lanza una bomba, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> a todos los enemigos en el área.",
        "skill2": "Coloca una mina invisible que causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y <#ef5350ff>enraiza durante {Time}s<> al pisarla. No se activa con minions.",
        "ult": "Lanza una bomba grande al área objetivo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>."
      },
      "cavalry_knight": {
        "name": "Jinete de Caballería",
        "skill": "Carga en línea recta para empalar al primer enemigo golpeado, <#ef5350ff>enraizando por {Time}s<> e infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>. La velocidad de carga escala con la velocidad de movimiento.",
        "skill2": "Aumenta la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidad de movimiento un {Speed}%<> durante {Time}s y fortalece el arma como lanza ígnea, haciendo que los ataques inflijan <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% del daño de ataque<> como daño de quemadura adicional durante {BurnTime}s.",
        "ult": "Aumenta la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidad de movimiento un {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% del daño de ataque<> durante {Time}s y crea una zona que conduce a su ubicación. Los aliados sobre la zona obtienen <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% del daño de ataque<> de velocidad de movimiento al moverse hacia la caballería."
      },
      "druid": {
        "name": "Druida",
        "skill": "Invoca un oso. Si muere, el druida recibe <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% PH<> de daño. Lanzar mientras está invocado <#6aff55ff>restaura<> la salud del oso en <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PH<>.",
        "skill2": "Invoca un águila. Si muere, el druida recibe daño. Si usa esta habilidad mientras el águila está invocada, el águila carga contra un enemigo, inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> y <#6aff55ff>cura un {Lifesteal}% del daño infligido<>.",
        "ult": "Dispara {Count} proyectiles espirituales de oso y águila en la dirección designada. Cada proyectil inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> y empuja a los enemigos hacia atrás."
      },
      "voodoo_shaman": {
        "name": "Chamán vudú",
        "skill": "Dispara un proyectil de maldición, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<>, <#ef5350ff>ralentizando un {Slow}% durante {Time}s<> y reduciendo la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque un {AtkSpd}%<> durante <#ffb900ff>{AtkSpdTime}s<>.",
        "skill2": "Maldice a un enemigo durante <#ffb900ff>{Time}s<>, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<>. Causa <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% PH<> de daño bonus por golpe recibido (máx {Max}).",
        "ult": "Crea una zona vudú durante <#ffb900ff>{Duration}s<>. Los enemigos dentro reciben <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% del HP máximo<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> periódicamente y son <#ef5350ff>silenciados<>."
      },
      "hitman": {
        "name": "Sicario",
        "skill": "Dispara una ráfaga de tres tiros. El primer tiro causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>aturde durante {StunTime}s<>.",
        "skill2": "Se teletransporta detrás del último campeón enemigo atacado en {Range} de alcance.",
        "ult": "Marca a un campeón enemigo. Tras <#ffb900ff>{Duration}s<>, inflige <#ff9028ff>{Damage} + {Coef}% del daño recibido durante la marca<> como <#ff9028ff>daño físico<>. Al matar al objetivo, obtiene sigilo durante <#ffb900ff>{InvisibleDuration}s<>."
      },
      "guardian_spirit": {
        "name": "Guardián Espiritual",
        "skill": "<#6aff55ff>Restaura<> la salud de aliados cercanos en <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<>.",
        "skill2": "Otorga a un aliado <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% PH<> de <#e8d44dff>escudo<> y <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidad de movimiento<>.",
        "ult": "Crea un santuario durante <#ffb900ff>{Duration}s<> que <#6aff55ff>restaura<> periódicamente la salud de los aliados en <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PH<> y otorga un escudo de resurrección."
      },
      "hunter": {
        "name": "Cazador",
        "skill": "Se teletransporta a un enemigo y cambia a modo distancia. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>El alcance aumenta en {RangeIncrease}<>.",
        "skill2": "Se desplaza a un enemigo marcado con 3 cargas, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>silenciando durante {SilenceTime}s<>.",
        "ult": "Se desplaza hacia adelante, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a enemigos en la trayectoria. Puede relanzarse al matar o asistir."
      },
      "circus_blade": {
        "name": "Cuchilla Circense",
        "skill": "Dispara una hoja en la dirección objetivo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>. Almacena hasta <#ffb900ff>{ChargeCount}<> cargas. Gana <#ffb900ff>1<> carga al atacar básicamente a campeones enemigos.",
        "skill2": "Gana <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidad de movimiento<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de velocidad de ataque<> y atraviesa muros durante <#ffb900ff>{Duration}s<>.",
        "ult": "Se desplaza a un enemigo objetivo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>. Causa <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% AD<> de daño de salpicadura y <#ef5350ff>empuja enemigos cercanos<>, luego desaparece."
      },
      "tfm2_cc_emberling": {
        "name": "Emberling",
        "skill": "Fires a piercing ember bolt dealing 80% AP.",
        "skill2": "Focuses flame: gains magic power and faster cooldowns.",
        "ult": "Erupts, dealing 100% AP and stunning nearby enemies."
      }
    }
  },
