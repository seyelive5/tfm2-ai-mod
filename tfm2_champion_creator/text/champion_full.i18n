        "skill": "Fire sword energy to deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> to hit enemies (range {Range}).",
        "skill2": "Slash a single target three times in succession for heavy <#ff9028ff>physical damage<>. <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> per hit.",
        "ult": "Charge {Range} distance in a straight line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> to enemies in the path. Damage is distributed by the number of enemies hit. If the ultimate kills an enemy, the cooldown is reset."
      },
      "taoist": {
        "name": "Taoist",
        "skill": "Seal an enemy with a talisman, <#ef5350ff>preventing basic attacks for {Time}(+{TimeCoef}% of ability power)s<>.",
        "skill2": "Attach a talisman to an enemy, <#ef5350ff>preventing skill use for {Time}(+{TimeCoef}% of ability power)s<>.",
        "ult": "Fire a talisman projectile in a straight line. Deals <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% of ability power<> as <#a974ffff>magic damage<> and <#ef5350ff>incapacitates the target for {Time}s<>, making them untargetable. When the effect ends, it spreads to nearby enemies."
      },
      "vampire": {
        "name": "Vampire",
        "skill": "Drain blood from an enemy to deal <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% of ability power<> as <#a974ffff>magic damage<>, <#6aff55ff>restore {Heal} health<>, and stack. <#6aff55ff>Healing increases by {Stack}<> per stack.",
        "skill2": "Consume {Value}% health to spew blood in a forward cone, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% of ability power<> as <#a974ffff>magic damage<>. Damage increases by {Stack} per stack.",
        "ult": "Become untargetable and charge {Range} distance, absorbing <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% of ability power<> as <#6aff55ff>health<> from each enemy in the path, and dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% of ability power<> as <#a974ffff>magic damage<>."
      },
      "werewolf": {
        "name": "Werewolf",
        "skill": "Claw forward, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> and <#6aff55ff>healing for {HealRatio}% of damage dealt<>.",
        "skill2": "Dash forward, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> and <#ef5350ff>slowing by {Slow}% for {SlowTime}s<>.",
        "ult": "Channel for <#ffb900ff>{Duration}s<>, repeatedly dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> and applying <#ef5350ff>bleed for {BleedTime}s<> (<#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% AD<>)."
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Enhance the club for <#ffb900ff>{Duration}s<>. Each attack creates a fan-shaped shockwave dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<>.",
        "skill2": "Enhance skin for <#ffb900ff>{Duration}s<>, gaining a <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> <#e8d44dff>shield<> and <#e8d44dff>{DamageReduction}% damage reduction<>.",
        "ult": "Fire a projectile in a straight line. Hit enemies are gradually <#ef5350ff>slowed over {SlowTime}s<>, then <#ef5350ff>rooted for {BindTime}s<>. On root, deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of attack damage<> as <#ff9028ff>physical damage<> to nearby enemies. The effect spreads to damaged enemies."
      },
      "hammerer": {
