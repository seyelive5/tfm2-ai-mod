      "swordman": {
        "name": "Zwaardvechter",
        "skill": "Schiet zwaardenergie om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen aan geraakte vijanden (bereik {Range}).",
        "skill2": "Snij een enkel doelwit drie keer achter elkaar voor zware <#ff9028ff>fysieke schade<>. <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade per treffer.",
        "ult": "Laadt een afstand van {Range} in een rechte lijn op, waardoor <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#ff9028ff>fysieke schade<> wordt toegebracht aan vijanden binnen het oplaadbereik. De schade wordt verdeeld op basis van het aantal getroffen vijanden. Als je een vijand doodt met je ultieme, wordt de cooldown van je ultieme gereset."
      },
      "taoist": {
        "name": "Taoïst",
        "skill": "Verzegelt een vijand met een talisman, waardoor <#ef5350ff>basisaanvallen {Time}(+{TimeCoef}% van vaardigheidskracht)s<> lang niet mogelijk zijn.",
        "skill2": "Bevestigt een talisman aan een vijand, waardoor <#ef5350ff>vaardigheden {Time}(+{TimeCoef}% van vaardigheidskracht)s<> lang niet gebruikt kunnen worden.",
        "ult": "Schiet talisman-projectiel in rechte lijn. Brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#a974ffff>magische schade<> toe en <#ef5350ff>maakt doel {Time}s onbruikbaar<>, onricht­baar. Wanneer effect eindigt, verspreidt het naar nabije vijanden."
      },
      "vampire": {
        "name": "Vampier",
        "skill": "Zuig bloed van een vijand om <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> van vaardigheidssterkte als <#a974ffff>magische schade<> toe te brengen, <#6aff55ff>{Heal}<> gezondheid te <#6aff55ff>herstellen<> en te stapelen. Genezing neemt toe met {Stack} per stapel.",
        "skill2": "Consumeer {Value}% gezondheid om bloed in een voorwaartse kegel te spuwen, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> van vaardigheidssterkte als <#a974ffff>magische schade<> toebrengend. Schade neemt toe met {Stack} per stapel.",
        "ult": "Wordt onrichtbaar en stormt een afstand van {Range}, <#6aff55ff>absorbeert gezondheid<> gelijk aan <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% vaardigheidssterkte<> van elke vijand in het stormtraject, en veroorzaakt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% vaardigheidssterkte<> als <#a974ffff>magische schade<>."
      },
      "werewolf": {
        "name": "Weerwolf",
        "skill": "Klauwt naar voren, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en <#6aff55ff>geneest {HealRatio}% van toegebrachte schade<>.",
        "skill2": "Stormt naar voren, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en <#ef5350ff>vertraagt {Slow}% gedurende {SlowTime}s<>.",
        "ult": "Kanaliseert <#ffb900ff>{Duration}s<>, brengt herhaaldelijk <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en past <#ef5350ff>bloeden voor {BleedTime}s<> toe (<#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% AD<>)."
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Verstrekt knuppel <#ffb900ff>{Duration}s<>. Elke aanval creëert een schokgolf in waaier die <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toebrengt.",
        "skill2": "Versterkt de huid voor <#ffb900ff>{Duration}s<>, krijgt een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> en <#e8d44dff>{DamageReduction}% schadevermindering<>.",
        "ult": "Schiet projectiel in rechte lijn. Geraakte vijanden worden <#ef5350ff>geleidelijk vertraagd over {SlowTime}s<>, dan <#ef5350ff>vastgepind {BindTime}s<>. Bij vastpinnen brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan nabije vijanden. Effect verspreidt naar beschadigde vijanden."
      },
      "hammerer": {
        "name": "Zware infanterie",
        "skill": "Zwaai een hamer naar een nabije vijand om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe te brengen en <#ef5350ff>voor {Time}s in de lucht te werpen<>.",
        "skill2": "Concentreer met de hamer geheven, sla dan op de grond om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe te brengen in {Range} en <#ef5350ff>{Move}% vertraging te geven voor {Time}s<>.",
        "ult": "Zwaai de hamer breed en breng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden in een halfcirkelvormig gebied binnen een bereik van {Range} vooraan. Vijanden geraakt door de hamer worden {Time}s teruggeslagen, en vijandelijke kampioenen geraakt door de geduwde vijand <#ef5350ff>blijven {Airborne}s in de lucht<>."
      },
      "inquisitor": {
