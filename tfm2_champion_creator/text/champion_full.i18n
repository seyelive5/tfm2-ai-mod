    "description": {
      "archer": {
        "name": "Archer",
        "skill": "Archer nhảy về hướng chỉ định, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch vừa bị tấn công.",
        "skill2": "Archer bắn một mũi tên vào kẻ địch ở gần, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>, <#ef5350ff>Làm Choáng<> mục tiêu trong chốc lát và nhảy lùi lại phía sau.",
        "ult": "Archer đứng yên tại chỗ và bắn ra tổng cộng {Count} mũi tên. Mũi tên bay về phía các kẻ địch ngẫu nhiên trong phạm vi {Range} xung quanh cô ấy, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>."
      },
      "bard": {
        "name": "Bard",
        "skill": "Bard tăng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<> và <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Sức Mạnh Phép Thuật<> cho một đồng minh trong <#ffb900ff>{Duration} giây<>.",
        "skill2": "Bard giảm Thời gian Hồi chiêu cho các đồng minh đi <#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> trong {Duration} giây trong phạm vi chỉ định.",
        "ult": "Bard vận sức trong <#ffb900ff>{Duration} giây<>, tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Sức Mạnh Công Kích<> (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% SMPT<>), <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicPower} Sức Mạnh Phép Thuật<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<>, và giảm {CoolReduce}% Thời gian Hồi chiêu cho các tướng đồng minh xung quanh trong phạm vi {Range}, nhưng làm giảm <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}% Giáp<> và <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}% Kháng Phép<> của họ."
      },
      "barrier_magician": {
        "name": "Barrier Magician",
        "skill": "Barrier Magician tạo một kết giới tại khu vực chỉ định, duy trì trong <#ffb900ff>{Duration} giây<>, tạo một <#e8d44dff>Lá chắn<> bằng <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% SMPT<> cho các đồng minh bên trong kết giới và giảm <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeedReduce}% Tốc Độ Đánh<> của kẻ địch. Từ cấp 3, phạm vi được mở rộng, đồng thời cung cấp thêm <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tốc Độ Đánh<> cho đồng minh bên trong kết giới và <#ef5350ff>Làm Chậm<> kẻ địch.",
        "skill2": "Barrier Magician triệu hồi một kết giới tại khu vực chỉ định, duy trì trong <#ffb900ff>{Duration} giây<>, vô hiệu hoá tất cả đạn bay bên trong kết giới đó.",
        "ult": "Barrier Magician tạo ra một kết giới thu hẹp dần xung quanh tướng địch. Kẻ địch chạm vào rìa kết giới sẽ phải chịu <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và bị <#ef5350ff>Làm Choáng trong {Time} giây<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Berserker tiến vào trạng thái Cuồng nộ trong {Duration} giây, tăng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<> và nhận <#6aff55ff>{Vamp}% Hút Máu<>.",
        "skill2": "Berserker nện hai tay xuống đất, <#ef5350ff>Hất Tung kẻ địch trong {Time} giây<> trong phạm vi hẹp và gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> .",
        "ult": "Berserker lao tới một kẻ địch chỉ định trong phạm vi {Range}, chém mạnh xuống mục tiêu và gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Thời gian Hồi chiêu giảm đi tỉ lệ thuận với lượng <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>Máu<> đã mất."
      },
      "boomerang_hunter": {
        "name": "Boomerang Hunter",
        "skill": "Boomerang Hunter ném Boomerang theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Khi bay đến tầm tối đa, Boomerang sẽ xoay tại chỗ trong một khoảng thời gian, liên tục gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% SMCK<> lên những kẻ địch chạm phải.",
        "skill2": "Boomerang Hunter ném ra 3 Boomerang. Chúng sẽ bay đến điểm cuối rồi quay lại, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên tất cả kẻ địch trên đường bay.",
        "ult": "Boomerang Hunter ném ra một chiếc Boomerang quyền năng theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Khi trúng một tướng địch, Boomerang sẽ nảy về hướng tướng địch khác gần nhất. Mỗi lần nảy, sát thương tăng thêm <#ff9028ff>{Increase}%<>. Nảy tối đa {MaxBounce} lần."
      },
      "chef": {
        "name": "Chef",
        "skill": "Chef ném ra con dao phay theo đường thẳng, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>.",
        "skill2": "Chef chia sẻ thức ăn cho các đồng minh xung quanh, liên tục <#6aff55ff>Hồi Máu<> một lượng bằng <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%SMPT<>. Nếu chỉ hồi máu cho bản thân, lượng hồi phục tăng lên thành <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% SMPT<>.",
        "ult": "Chef nấu một món ăn thượng hạng cho một tướng đồng minh, tăng <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% Máu Tối đa<> trong <#ffb900ff>{Duration} giây<>. Phân tán <#e8d44dff>{SpreadRatio}%<> sát thương gánh chịu thành sát thương theo thời gian."
      },
      "clown": {
        "name": "Clown",
        "skill": "Clown dịch chuyển đến bên cạnh mục tiêu chỉ định, nếu mục tiêu là kẻ địch sẽ gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc Độ Di Chuyển<> cho ả trong <#ffb900ff>{Duration} giây<>.",
        "skill2": "Clown ném những con dao găm ra xung quanh, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch trong phạm vi. (Có thể di chuyển trong khi thi triển)",
        "ult": "Clown tiến vào trạng thái Cuồng Loạn trong <#ffb900ff>{Time} giây<>, cường hoá toàn bộ dao găm của mình có khả năng nảy giữa các kẻ địch."
      },
      "dancer": {
        "name": "Dancer",
        "skill": "Dancer ném Chakram vào kẻ địch, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Với mỗi Chakram cộng thêm, sát thương của kỹ năng này tăng thêm {StackCoef}%.",
        "skill2": "Mỗi khi tiêu diệt kẻ địch, đòn đánh thường của cô ấy sẽ được cộng thêm 1 Chakram. (Tối đa {MaxCount} chiếc, sát thương giảm {Reduce}% mỗi đòn khi tấn công liên tiếp bằng các Chakram cộng thêm)",
        "ult": "Dancer phóng ra {Count} (+Cộng dồn) Chakram xuyên thấu theo hình nón, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Các Chakram quay trở lại từ điểm cuối, gây thêm <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% SMCK<> <#ff9028ff>Sát thương Vật lý<>. (Tối đa {MaxCount} chiếc)"
      },
      "dark_mage": {
        "name": "Dark Mage",
        "skill": "Dark Mage bắn ra một mũi tên hắc ám theo đường thẳng, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trúng phải và <#ef5350ff>Trói Chân trong {Time} giây<>.",
        "skill2": "Sau một khoảng trễ ngắn, hắn bao phủ một khu vực bằng bóng tối, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi đó.",
        "ult": "Dark Mage nguyền rủa một tướng địch trong phạm vi {Range} và liên kết mục tiêu đó với tướng đồng minh gần nhất trong <#ffb900ff>{Duration} giây<>. Khi một trong hai chịu sát thương, <#a974ffff>{ShareRatio}%<> sát thương sẽ được truyền sang mục tiêu còn lại."
      },
      "demon": {
        "name": "Demon",
        "skill": "Demon triệu hồi bàn tay địa ngục từ dưới mặt đất tóm lấy kẻ địch. Khi trúng đích, ả gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và hoán đổi vị trí với kẻ địch.",
        "skill2": "Ả hóa thân thành Quỷ Vương trong {Time} giây. Trong thời gian biến hình, tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Sức Mạnh Công Kích<>, <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{Defense} Giáp<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<> và <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc Độ Di Chuyển<>.",
        "ult": "Demon gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên tất cả kẻ địch trong phạm vi {Range} xung quanh và làm <#ef5350ff>Hoảng Sợ trong {Time} giây<>."
      },
      "dual_blader": {
        "name": "Dual Blader",
        "skill": "Dual Blader phóng ra kiếm khí theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch trúng phải và <#ef5350ff>Trói Chân trong {Time} giây<>.",
        "skill2": "Dual Blader lao đến kẻ địch đang bị <#ef5350ff>Bất Động<> trong phạm vi {Range}, khiến mục tiêu trúng phải bị <#ef5350ff>Hất Tung trong {Time} giây<> và chịu <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "ult": "Dual Blader chém liên tiếp vào một kẻ địch trong phạm vi {Range} chỉ định, gây {Count} lần <#f5f5f5ff>Sát thương Chuẩn<> bằng <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>."
      },
      "executioner": {
        "name": "Executioner",
        "skill": "Executioner ném cây móc theo đường thẳng, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên kẻ địch trúng phải và kéo mục tiêu về phía mình.",
        "skill2": "Executioner dùng cây móc chém vào một kẻ địch, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và khiến mục tiêu bị <#ef5350ff>Chảy Máu trong {Duration} giây<>. Kẻ địch bị Chảy Máu phải chịu <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}% SMCK<> mỗi {Tick} giây, đồng thời sát thương nhận vào <#ef5350ff>tăng {Debuff}%<>.",
        "ult": "Executioner vung cây móc theo vùng hình bán nguyệt trong phạm vi {Range} phía trước, gây <#ff9028ff>Sát thương Vật lý<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch và khiến chúng <#ef5350ff>Không Thể Hồi Máu trong {Time} giây<>."
      },
      "exorcist": {
        "name": "Exorcist",
        "skill": "Exorcist thanh tẩy <#ef5350ff>hiệu ứng bất lợi<> cho một đồng minh và hồi <#6aff55ff>Máu<> theo <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>.",
        "skill2": "Exorcist ban phước cho một đồng minh trong <#ffb900ff>{Duration} giây<>, tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Sức Mạnh Công Kích<> và <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<>. Trong thời gian hiệu lực, nếu mục tiêu bị trúng kỹ năng khống chế, hiệu ứng khống chế đó sẽ bị phản đòn và áp dụng ngược lại lên kẻ địch.",
        "ult": "Exorcist tạo ra một vụ nổ tại vị trí chỉ định, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi. Với mỗi bùa lợi trên người mục tiêu, gây thêm sát thương bằng <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% SMPT<>."
      },
      "fighter": {
        "name": "Fighter",
        "skill": "Fighter lao đến mục tiêu trong phạm vi {Range} với tốc độ {Speed}, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> rồi <#ef5350ff>Làm Choáng trong {Stun} giây<>.",
        "skill2": "Fighter giẫm mạnh xuống mặt đất, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên tất cả kẻ địch trong phạm vi {Range} xung quanh và <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>.",
        "ult": "Fighter dập mạnh xuống đất, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên tất cả kẻ địch trong phạm vi {Range} xung quanh và khiến chúng bị <#ef5350ff>Hất Tung trong {Time} giây<>."
      },
      "gambler": {
        "name": "Gambler",
        "skill": "Gambler tung xúc xắc và tấn công kẻ địch trong phạm vi {Range} với số lần bằng với số điểm gieo được. Mỗi đòn tấn công gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "skill2": "Gambler ném ra một con chip trong phạm vi {Range}, tạo một vùng có kích thước {AttackRange} gây <#ef5350ff>Làm Chậm {Slow}%<> trong {Time} giây. Khi biến mất, vùng này sẽ phát nổ, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch trong phạm vi.",
        "ult": "Gambler ném ra một xấp tiền theo đường thẳng. Kẻ địch trúng chiêu phải chịu <#ff9028ff>Sát thương Vật lý<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và bị <#ef5350ff>Mê Hoặc trong {Time} giây<>."
      },
      "ghost": {
        "name": "Ghost",
        "skill": "Ghost lao tới theo đường thẳng, trở nên Không Thể Bị Chỉ Định. Mỗi khi tham gia hạ gục kẻ địch, tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Sức Mạnh Công Kích<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<> và <#6aff55ff>Hồi {Heal} Máu<>.",
        "skill2": "Ghost lướt một đoạn ngắn, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên mục tiêu đầu tiên đụng phải. Có thể sử dụng liên tiếp tối đa {Time} lần.",
        "ult": "Ghost nhận Miễn Nhiễm Khống Chế trong <#ffb900ff>{Time} giây<>. Mỗi khi tham gia hạ gục kẻ địch, thời gian hồi chiêu của các kỹ năng cơ bản của nó sẽ được làm mới."
      },
      "gunner": {
        "name": "Gunner",
        "skill": "Gunner có thể tấn công kẻ địch trong khi di chuyển. Từ cấp 3, mỗi khi tấn công kẻ địch anh sẽ được <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>tăng {Value}% Tốc Độ Di Chuyển<> trong {Time} giây.",
        "skill2": "Gunner cường hóa đòn đánh trong {Time} giây, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>tăng {Attack} Sức Mạnh Công Kích<>, đồng thời với mỗi 3 đòn đánh, viên đạn sẽ làm kẻ địch bị <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>.",
        "ult": "Gunner cường hóa đòn đánh trong {Time} giây, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>tăng {Attack} Sức Mạnh Công Kích<>, đồng thời anh bắn thêm đạn vào 2 kẻ địch xung quanh mục tiêu. Các viên đạn thêm này gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>."
      },
      "ice_mage": {
        "name": "Ice Mage",
        "skill": "Ice Mage đóng băng kẻ địch, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và <#ef5350ff>Làm Choáng trong {Time} giây<>.",
        "skill2": "Ice Mage tạo một vùng băng giá, tồn tại trong {Duration} giây tại khu vực chỉ định, <#ef5350ff>Làm Chậm {MoveSpeed}% Tốc Độ Di Chuyển<> của kẻ địch trong phạm vi {Range} và gây<#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> mỗi {Tick} giây. Khi biến mất, vùng băng sẽ đóng băng kẻ địch trong phạm vi, <#ef5350ff>Làm Choáng trong {Stun} giây<>.",
        "ult": "Ice Mage gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong vùng hình nón phía trước và đẩy lùi chúng. <#ef5350ff>Làm Chậm {Slow}% trong {SlowDuration} giây<> và khiến mục tiêu bị <#ef5350ff>Sa Lầy trong {BlockDuration} giây<>. <#ef5350ff>Sa Lầy<> khiến kẻ địch không thể dùng kỹ năng di chuyển."
      },
      "illusionist": {
        "name": "Illusionist",
        "skill": "Illusionist bắn ra luồng đạn gây nhiễu loạn kẻ địch, gây<#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>, đồng thời triệu hồi một phân thân trước mặt mục tiêu để <#ef5350ff>Khiêu Khích trong {Time} giây<>.",
        "skill2": "Illusionst gây <#a974ffff>Sát thương Phép<> <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi {Range} và làm <#ef5350ff>Hoảng Sợ trong {Time} giây<>.",
        "ult": "Illusionist tạo một phân thân của một đồng minh bên cạnh, tồn tại trong <#ffb900ff>{Duration} giây<>. Phân thân này chỉ có thể đánh thường và sở hữu các chỉ số tương đương với Tướng được sao chép."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Jiangshi triệu hồi một cương thi con lao vào kẻ địch để gây sát thương. Cương thi con sẽ biến mất sau 3 đòn đánh, mỗi đòn đánh gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "skill2": "Jiangshi giáng một đòn mạnh mẽ xuống kẻ địch, <#ef5350ff>Làm Choáng trong {Time} giây<>, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và <#6aff55ff>hồi {Heal} Máu<>.",
        "ult": "Trong <#ffb900ff>{Duration} giây<>, Jiangshi hút <#6aff55ff>Máu<> theo <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% SMPT<> từ các kẻ địch trong phạm vi {Range} xung quanh, đồng thời gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% SMPT<>."
      },
      "knight": {
        "name": "Knight",
        "skill": "Knight chọn một mục tiêu để <#ef5350ff>Khiêu Khích trong {Time} giây<>.",
        "skill2": "Knight tạo một <#e8d44dff>Lá chắn<> cho bản thân, tồn tại trong {Time} giây (Giá trị <#e8d44dff>Lá chắn<>: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% Máu Tối đa<> + <#e8d44dff>{Amount}<>). Trong thời gian lá chắn duy trì, <#ff9028ff>phản lại {Reflect}%<> sát thương gánh chịu.",
        "ult": "Knight tạo một vùng bảo vệ có phạm vi {Range} tại vị trí chỉ định, tồn tại trong <#ffb900ff>{Time} giây<>. Đồng minh trong vùng được giảm sát thương gánh chịu bằng <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% Máu Tối đa<>."
      },
      "lancer": {
        "name": "Lancer",
        "skill": "Lancer đẩy lùi kẻ địch trong phạm vi {Range} xung quanh, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "skill2": "Lancer lướt một đoạn ngắn và xuyên qua mục tiêu, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Value}% SMCK<> lên kẻ địch.",
        "ult": "Lướt đi với khoảng cách {Range}, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên tất cả kẻ địch trên đường lướt, đồng thời <#ef5350ff>Hất Tung trong {Time} giây<>."
      },
      "lightning_mage": {
        "name": "Lightning Mage",
        "skill": "Phóng tia sét vào kẻ địch, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<>. Tia sét sẽ liên tục lan ra nếu có các mục tiêu khác trong phạm vi, và không lan trúng cùng một mục tiêu nhiều lần.",
        "skill2": "Giáng sét xuống khu vực chỉ định, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch trúng phải và <#ef5350ff>Làm Choáng trong {Time} giây<>.",
        "ult": "Vận sức trong <#ffb900ff>{Duration} giây<> để phóng một tia sét cao thế vào Tướng địch. Trong thời gian vận sức, làm <#ef5350ff>Choáng<> mục tiêu và liên tục gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên các kẻ địch xung quanh."
      },
      "magic_knight": {
        "name": "Magic Knight",
        "skill": "Kích nổ ma thuật theo đường thẳng, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<>.",
        "skill2": "Tạo một lõi ma thuật tồn tại trong {Duration} giây ở một vùng hẹp, hút kẻ địch trong phạm vi {Range} về trung tâm mỗi {Tick} giây và gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<>.",
        "ult": "Trong <#ffb900ff>{Time} giây<>, tăng <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{Range} Tầm Đánh<> và <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% SMPT<> <#ceff99ff>Tốc độ Đánh<>, đồng thời mỗi đòn đánh thường sẽ kích hoạt kỹ năng thứ nhất."
      },
      "monk": {
        "name": "Monk",
        "skill": "Hồi <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#6aff55ff>Máu<> cho đồng minh trong phạm vi {Range} xung quanh. Nếu chỉ hồi phục cho bản thân, lượng hồi phục sẽ tăng lên thành <#6aff55ff>{SingleValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>.",
        "skill2": "Đánh lòng bàn tay xuống, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch trong phạm vi {Range} và <#ef5350ff>Làm Choáng trong {Time} giây<>.",
        "ult": "Tạo một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> cho đồng minh trong phạm vi {Range} xung quanh. Đồng minh nhận được lá chắn sẽ được tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc độ Di chuyển<>."
      },
      "necromancer": {
        "name": "Necromancer",
        "skill": "Triệu hồi một Ghoul để chiến đấu cho bạn trong <#ffb900ff>{Duration} (+{DurationCoef}% SMPT) giây<>. Thời gian hồi chiêu của kỹ năng sẽ giảm dần theo cấp độ, đồng thời thời gian tồn tại của Ghoul tăng thêm <#ffb900ff>{DurationPerLevel} giây<>.",
        "skill2": "Chỉ định một kẻ địch làm mục tiêu tấn công trong <#ffb900ff>{Time} giây<> để khiến Ghoul vào trạng thái Cuồng Bạo. Ghoul được tăng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc độ Đánh<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% SMPT<> và <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc độ Di chuyển<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MoveSpeedCoef}% SMPT<>.",
        "ult": "Hồi sinh một Tướng đồng minh đã tử trận và triệu hồi dưới dạng Wraith. Trong thời gian duy trì triệu hồi, tiêu hao <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpDrain} Máu<> mỗi giây."
      },
      "ninja": {
        "name": "Ninja",
        "skill": "Bắn ra một quả cầu bóng tối, lướt tới kẻ địch trúng chiêu và gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<>.",
        "skill2": "Lướt một đoạn ngắn về phía kẻ địch chỉ định, tiến vào trạng thái Không thể Bị Chỉ định và tấn công liên tiếp 3 lần. Mỗi đòn đánh gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<>.",
        "ult": "Lướt tới một kẻ địch trong phạm vi {Range}, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<>."
      },
      "ogre": {
        "name": "Ogre",
        "skill": "Mỗi khi chịu sát thương từ Tướng địch, tăng <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Value} Máu Tối đa<>.",
        "skill2": "Đập cây chày vào mục tiêu, <#ef5350ff>Làm Choáng trong {Time} giây<> và gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% Máu Tối đa<> <#ff9028ff>Sát thương Vật lý<>.",
        "ult": "Hóa khổng lồ trong {Time} giây, tăng <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Buff}% Máu Tối đa<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% Máu Tối đa<>."
      },
      "plague_doctor": {
        "name": "Plague Doctor",
        "skill": "Tiêm thuốc cho bản thân và một đồng minh, trong <#ffb900ff>{Duration} giây<> được tăng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc độ Đánh<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% Sức Mạnh Phép Thuật<> và <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc độ Di chuyển<>.",
        "skill2": "Thực hiện nghi thức lên một đồng minh, trong <#ffb900ff>{Duration} giây<> tăng <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{Range} Tầm Đánh<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{RangeCoef}% Sức Mạnh Phép Thuật<>, đồng thời đòn đánh được nhận hiệu ứng lướt.",
        "ult": "Tiêm bí dược cho một đồng minh, khiến Máu của mục tiêu giảm xuống 1. Đổi lại, trong {Duration} giây, Máu sẽ không giảm xuống dưới 1, đồng thời được tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Sức Mạnh Công Kích<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc độ Đánh<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% Sức Mạnh Phép Thuật<> và <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc độ Di chuyển<>."
      },
      "poison_dart_hunter": {
        "name": "Poison Dart Hunter",
        "skill": "Rải bãi chất độc, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên kẻ địch trong phạm vi, khiến chúng bị nhiễm độc trong <#ffb900ff>{Duration} giây<> và <#ef5350ff>Làm Chậm {Slow}%<>.",
        "skill2": "Khi tấn công kẻ địch bị nhiễm độc, tăng <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{Range} Tầm Đánh<>, và khi di chuyển ra xa khỏi chúng, tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Speed}% Tốc độ Di chuyển<>.",
        "ult": "Trong <#ffb900ff>{Duration} giây<>, tẩm độc cho đòn đánh của các đồng minh xung quanh. Hiệu ứng độc này liên tục gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> trong <#ffb900ff>{PoisonDuration} giây<>."
      },
      "priest": {
        "name": "Priest",
        "skill": "Tạo vùng hồi phục có phạm vi {Range} duy trì trong {Duration} giây, mỗi {Tick} giây hồi <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#6aff55ff>Máu<> cho các đồng minh đứng bên trong.",
        "skill2": "Tạo một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> cho một đồng minh trong {Time} giây. Trong thời gian lá chắn tồn tại, đồng minh đó được tăng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc độ Đánh<>.",
        "ult": "Bay lên không trung và bất động trong {Time} giây, mỗi {Tick} giây bắn một viên đạn vào đồng minh có lượng máu thấp nhất trong tầm chiêu cuối, giúp hồi <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#6aff55ff>Máu<>."
      },
      "pyromancer": {
        "name": "Pyromancer",
        "skill": "Ném một quả cầu lửa xuống đất, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch trong phạm vi {Range}.",
        "skill2": "Triệu hồi vùng lửa cháy tại khu vực chỉ định, tồn tại trong {Duration} giây, mỗi {Tick} giây gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch trong phạm vi {Range}.",
        "ult": "Tạo một vụ nổ lớn trong phạm vi {Range}, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên toàn bộ kẻ địch trong phạm vi vụ nổ."
      },
      "pythoness": {
        "name": "Pythoness",
        "skill": "Hồi <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#6aff55ff>Máu<> cho một đồng minh.",
        "skill2": "Hồi <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#6aff55ff>Máu<> cho một đồng minh, đồng thời gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch trong phạm vi {Range} xung quanh đồng minh đó.",
        "ult": "Triệu hồi Cổng Tinh Linh. Cổng Tinh Linh bắn ra các viên đạn vào các mục tiêu trong phạm vi {Range} xung quanh nó, giúp hồi <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPTt<> <#6aff55ff>Máu<> cho đồng minh, hoặc gây <#a974ffff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch."
      },
      "shadowmancer": {
        "name": "Shadowmancer",
        "skill": "Triệu hồi bóng tối từ mặt đất, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch trong phạm vi và <#ef5350ff>Trói Chân trong {Time} giây<>.",
        "skill2": "Kích nổ cái bóng của kẻ địch đang bị bất động, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<>.",
        "ult": "Bắn đạn bóng tối xuyên thấu theo đường thẳng, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên các tướng địch trúng chiêu và <#ef5350ff>Trục Xuất chúng trong {BanishTime} giây<>."
      },
      "shield_bearer": {
        "name": "Shield Bearer",
        "skill": "Tạo một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% Máu Tối đa<> cho bản thân và một đồng minh chỉ định trong phạm vi. (Duy trì trong {Duration} giây)",
        "skill2": "Chuyển {Damage}% sát thương các đồng minh xung quanh phải nhận vào bản thân, đồng thời Làm Chậm những kẻ địch tấn công đồng minh đi <#ef5350ff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefCoef}% Giáp<>. (Duy trì trong {Duration} giây)",
        "ult": "Khi kích hoạt, trong {Duration} giây nhận được hiệu ứng <#e8d44dff>Giảm {DamageReduce}% Sát Thương<> + <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MrCoef}% Kháng Phép<> và Miễn nhiễm Khống Chế, đồng thời khiến toàn bộ kẻ địch trong một phạm vi rộng xung quanh bị <#ef5350ff>Khiêu Khích trong {TauntDuration} giây<>. Không thể di chuyển trong thời gian hiệu lực."
      },
      "soldier": {
        "name": "Soldier",
        "skill": "Tầm Đánh tăng <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{GrowthRange}<> mỗi cấp.",
        "skill2": "Bắn liên tiếp 3 phát súng vào một kẻ địch, gây lượng lớn <#ff9028ff>Sát thương Vật lýv<> (mỗi phát gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> sát thương). Tầm thi triển kỹ năng tăng tỉ lệ thuận với tầm đánh cơ bản.",
        "ult": "Bắn một viên đạn khổng lồ bay theo đường thẳng nhắm vào kẻ địch trong phạm vi {Range}. Viên đạn gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên toàn bộ kẻ địch trên quỹ đạo bay, và lượng sát thương sẽ giảm đi {Decay}% mỗi khi trúng một kẻ địch."
      },
      "swordman": {
        "name": "Swordman",
        "skill": "Phóng ra luồng kiếm khí, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên các kẻ địch trúng chiêu (Tầm kiếm khí: {Range})",
        "skill2": "Chém liên tiếp 3 nhát vào một mục tiêu, gây lượng lớn <#ff9028ff>Sát thương Vật lý<>. Mỗi nhát chém gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> sát thương.",
        "ult": "Lướt một khoảng cách {Range} theo đường thẳng, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên mọi kẻ địch trên đường lướt. Lượng sát thương sẽ được chia đều cho số lượng kẻ địch trúng chiêu. Nếu hạ gục kẻ địch bằng Chiêu cuối, thời gian hồi Chiêu cuối sẽ được làm mới."
      },
      "taoist": {
        "name": "Taoist",
        "skill": "Phong ấn kẻ địch bằng bùa chú, khiến mục tiêu bị Giải Giới trong <#ef5350ff>{Time} (+{TimeCoef}% SMPT) giây<>. Giải Giới khiến kẻ địch không thể đánh thường.",
        "skill2": "Gắn bùa chú lên kẻ địch, khiến mục tiêu bị Câm Lặng trong <#ef5350ff>{Time} (+{TimeCoef}% SMPT) giây<>. Câm Lặng khiến kẻ địch không thể dùng kỹ năng.",
        "ult": "Bắn bùa chú theo đường thẳng, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<> lên kẻ địch trúng chiêu, đồng thời làm <#ef5350ff>Mất Khả năng Hành động trong {Time} giây<> và khiến mục tiêu Không thể Bị Chỉ định. Khi hiệu ứng kết thúc, hiệu ứng tương tự sẽ lan sang các kẻ địch xung quanh."
      },
      "vampire": {
        "name": "Vampire",
        "skill": "Hút máu kẻ địch, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<>, đồng thời <#6aff55ff>hồi {Heal} Máu<> và tích lũy điểm cộng dồn. Mỗi điểm cộng dồn <#6aff55ff>tăng lượng Máu hồi phục thêm {Stack}<>.",
        "skill2": "Tiêu hao {Value}% Máu của bản thân để phun máu ra theo hình nón phía trước, gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#a974ffff>Sát thương Phép<>. Mỗi điểm cộng dồn tăng lượng sát thương thêm {Stack}.",
        "ult": "Trở nên Không thể Bị Chỉ định và lướt một khoảng cách {Range}, hút <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> <#6aff55ff>Máu<> từ mỗi kẻ địch trên đường lướt, đồng thời gây <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% SMPT<> <#a974ffff>Sát thương Phép<>."
      },
      "werewolf": {
        "name": "Werewolf",
        "skill": "Cào về phía trước theo hình bán nguyệt, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương VậtlLý<> lên kẻ địch và <#6aff55ff>hồi lượng Máu tương đương {HealRatio}% sát thương gây ra<>.",
        "skill2": "Lướt về phía trước, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên kẻ địch trúng chiêu và <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>.",
        "ult": "Trong <#ffb900ff>{Duration} giây<>, liên tục gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên các kẻ địch trong phạm vi hình nón và gây <#ef5350ff>Chảy Máu trong {BleedTime} giây<>. (Chảy Máu: <#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% SMCK<>)"
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Trong <#ffb900ff>{Duration} giây<>, cường hóa cây gậy của bản thân, khiến các đòn tấn công lên kẻ địch tạo ra làn sóng xung kích lan tỏa theo hình nón. Sóng xung kích này gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<>.",
        "skill2": "Trong <#ffb900ff>{Duration} giây<>, cường hóa lớp da của bản thân, nhận một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và hiệu ứng <#e8d44dff>Giảm {DamageReduction}% Sát thương<>.",
        "ult": "Bắn đạn theo đường thẳng, <#ef5350ff>Làm Chậm trong {SlowTime} giây<>, sau đó <#ef5350ff>Trói Chân trong {BindTime} giây<>. Khi hiệu ứng Trói Chân kích hoạt, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> ra xung quanh, đồng thời hiệu ứng tương tự sẽ lan sang những kẻ địch chịu sát thương."
      },
      "hammerer": {
        "name": "Hammerer",
        "skill": "Vung búa vào một kẻ địch ở gần, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> và khiến mục tiêu bị <#ef5350ff>Hất Tung trong {Time} giây<>.",
        "skill2": "Vận búa lên trong một khoảng thời gian rồi nện xuống đất, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên các kẻ địch xung quanh trong phạm vi {Range} và <#ef5350ff>Làm Chậm {Move}% trong {Time} giây<>.",
        "ult": "Vung mạnh cây búa, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên toàn bộ kẻ địch trong vùng hình bán nguyệt phạm vi {Range} phía trước. Kẻ địch trúng búa sẽ bị Đẩy Lùi trong {Time} giây, và các tướng địch va chạm với mục tiêu bị đẩy lùi sẽ bị <#ef5350ff>Hất Tung trong {Airborne} giây<>."
      },
      "inquisitor": {
        "name": "Inquisitor",
        "skill": "Lướt một khoảng ngắn, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên kẻ địch đầu tiên trúng chiêu và gây <#ef5350ff>Chảy Máu<>.",
        "skill2": "Chém vào mục tiêu, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<>. Nếu mục tiêu đang bị <#ef5350ff>Chảy Máu<>, thời gian hồi của Kỹ năng 1 sẽ được làm mới.",
        "ult": "Lướt tới một kẻ địch phía trước, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên toàn bộ kẻ địch xung quanh điểm đến. Sau khi chịu sát thương, kẻ địch có lượng Máu dưới {Threshold}% Máu Tối đa sẽ bị kết liễu. Nếu kết liễu thành công, các kẻ địch xung quanh mục tiêu đó sẽ bị <#ef5350ff>Hoảng Sợ trong {FearTime} giây<>."
      },
      "pole_warrior": {
        "name": "Pole Warrior",
        "skill": "Nhảy tới kẻ địch và đập gậy xuống, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<>.",
        "skill2": "Lướt một khoảng ngắn, đứng lên cây gậy và trở nên Không thể Bị Chỉ định trong {Time} giây, sau đó vung gậy gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<> lên toàn bộ kẻ địch xung quanh trong phạm vi {Range}.",
        "ult": "Lướt tới kẻ địch được chỉ định trong phạm vi {Range}, gây <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> <#ff9028ff>Sát thương Vật lý<>, đồng thời khiến mục tiêu bị <#ef5350ff>Hất Tung trong {Time} giây<>."
