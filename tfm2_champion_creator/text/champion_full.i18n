        "skill": "Beschwört für <#ffb900ff>{Duration}s<> einen Wirbelsturm, der alle {Tick}s in {Range} <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> verursacht. Verbündete darin erhalten <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Lauftempo<>.",
        "skill2": "Feuert fünf Wirbelstürme nach vorn und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu.",
        "ult": "Lässt einen massiven Tornado los. Getroffene Feinde erleiden <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> und werden <#ef5350ff>für {AirborneTime}s in die Luft geschleudert<>. Größe, Schaden und Luftzeit sinken pro Treffer. Lenkt zu anderen Champions um."
      },
      "bomber": {
        "name": "Bomber",
        "skill": "Wirft eine Bombe und fügt allen Feinden im Gebiet <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu.",
        "skill2": "Platziert eine unsichtbare Mine, die bei Berührung <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> verursacht und <#ef5350ff>für {Time}s fesselt<>. Wird nicht durch Diener ausgelöst.",
        "ult": "Wirft eine große Bombe ins Zielgebiet, fügt allen Feinden <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>verlangsamt um {Slow}% für {SlowTime}s<>."
      },
      "cavalry_knight": {
        "name": "Kavallerieritter",
        "skill": "Stürme in gerader Linie, um den ersten getroffenen Feind <#ef5350ff>für {Time}s zu fesseln<> und <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen. Sturmgeschwindigkeit skaliert mit Lauftempo.",
        "skill2": "Erhöht die <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Bewegungsgeschwindigkeit {Time}s lang um {Speed}%<> und verstärkt die Waffe zu einer Flammenlanze, sodass Angriffe {BurnTime}s lang zusätzlich <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% Angriffsschaden<> als Brandschaden verursachen.",
        "ult": "Erhöht die <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Bewegungsgeschwindigkeit {Time}s lang um {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% Angriffsschaden<> und erzeugt eine Zone, die zu deiner Position führt. Verbündete auf der Zone erhalten beim Bewegen in Richtung der Kavallerie <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% Angriffsschaden<> Bewegungsgeschwindigkeit."
      },
      "druid": {
        "name": "Druide",
        "skill": "Beschwört einen Bären. Stirbt er, erleidet der Druide <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% Zauberkraft<> Schaden. Erneutes Wirken <#6aff55ff>heilt den Bären<> um <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Zauberkraft<>.",
        "skill2": "Beschwört einen Adler. Stirbt der Adler, erleidet der Druide Schaden. Wird die Fähigkeit während der Beschwörung erneut eingesetzt, stürzt der Adler auf einen Gegner zu, verursacht <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> und <#6aff55ff>heilt um {Lifesteal}% des verursachten Schadens<>.",
        "ult": "Feuert {Count} Bären- und Adlerseelen nacheinander in die gewählte Richtung. Jedes Projektil verursacht <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> und stößt Gegner zurück."
      },
      "voodoo_shaman": {
        "name": "Voodoo-Schamane",
        "skill": "Feuert ein Fluch-Projektil ab, fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu, <#ef5350ff>verlangsamt um {Slow}% für {Time}s<> und reduziert <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo um {AtkSpd}%<> für <#ffb900ff>{AtkSpdTime}s<>.",
        "skill2": "Verflucht einen Feind für <#ffb900ff>{Time}s<>, fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu. Verursacht <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% Zauberkraft<> Bonusschaden pro erlittenem Treffer (max {Max}).",
        "ult": "Erschafft für <#ffb900ff>{Duration}s<> eine Voodoo-Zone. Feinde darin erleiden periodisch <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% maximale HP<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> und werden <#ef5350ff>stumm geschaltet<>."
      },
      "hitman": {
        "name": "Hitman",
        "skill": "Feuert einen Drei-Schuss-Burst. Der erste Schuss verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> und <#ef5350ff>betäubt für {StunTime}s<>.",
        "skill2": "Teleportiert sich hinter den zuletzt angegriffenen feindlichen Champion in {Range} Reichweite.",
        "ult": "Markiert einen gegnerischen Champion. Nach <#ffb900ff>{Duration}s<> verursacht die Markierung <#ff9028ff>{Damage} + {Coef}% des während der Markierung erlittenen Schadens<> als <#ff9028ff>physischen Schaden<>. Bei Tötung erhältst du <#ffb900ff>{InvisibleDuration}s<> Tarnung."
      },
      "guardian_spirit": {
        "name": "Schutzgeist",
        "skill": "<#6aff55ff>Heilt HP<> nahe Verbündeter um <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<>.",
        "skill2": "Gewährt einem Verbündeten <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% Zauberkraft<> als <#e8d44dff>Schild<> und <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Lauftempo<>.",
        "ult": "Erschafft für <#ffb900ff>{Duration}s<> ein Heiligtum, das Verbündete periodisch um <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Zauberkraft<> <#6aff55ff>heilt<> und einen Wiederbelebungsschild gewährt."
      },
      "hunter": {
        "name": "Jäger",
        "skill": "Teleportiert sich zu einem Feind und wechselt in den Fernkampfmodus. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Reichweite steigt um {RangeIncrease}<>.",
        "skill2": "Stürmt auf einen 3-Stack-markierten Feind, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>schaltet stumm für {SilenceTime}s<>.",
        "ult": "Stürmt nach vorn und fügt Feinden auf der Bahn <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu. Kann bei Kill oder Assist erneut gewirkt werden."
      },
      "circus_blade": {
        "name": "Zirkusklinge",
        "skill": "Feuert eine Klinge in die Zielrichtung, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>verlangsamt um {Slow}% für {SlowTime}s<>. Speichert bis zu <#ffb900ff>{ChargeCount}<> Ladungen. Erhält <#ffb900ff>1<> Ladung bei Standardangriffen auf feindliche Champions.",
        "skill2": "Erhält für <#ffb900ff>{Duration}s<> <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Lauftempo<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tempo<> und Wandphasing.",
        "ult": "Stürmt auf einen Feind zu, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu. Verursacht <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% Angriff<> Splash-Schaden und <#ef5350ff>stößt nahe Feinde zurück<>, dann verschwindet."
      },
      "tfm2_cc_emberling": {
        "name": "Emberling",
        "skill": "Fires a piercing ember bolt dealing 80% AP.",
        "skill2": "Focuses flame: gains magic power and faster cooldowns.",
        "ult": "Erupts, dealing 100% AP and stunning nearby enemies."
      }
    }
  },
